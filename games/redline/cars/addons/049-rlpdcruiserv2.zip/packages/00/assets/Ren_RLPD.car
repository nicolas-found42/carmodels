;RLPD Cruiser
;Made by: Renesis
;with many thanks to the creators, and previous modders of redline
;special thanks to david drew for going above and beyond the line of helping
;modeled off of a 1976 plymouth volare with a plymouth road runner 426 hemi engine.

;a string with the name of the car
builtIn 1
carName "­RenRotor.png.txr­ RLPD Cruiser"

;used only for career mode
year 1976
displacement 6.98
price 35000


;---aerodynamics

;the car's frontal air resitance.
;this equals cw*S, where cw is the coefficient of friction 
;and S is the frontal area of the car in square meters.
frontAirResistance 1.01

;air resistance of the side and top areas of the car.
;these values are not that important to be very exact.
sideAirResistance 2.0
topAirResistance 3.0

;used to simulate spoilers
frontLift -0.1
rearLift -0.1


;---chassis

;Car's mass in kg
mass 1450.0

;Car's momentum of inertia around the x,y and z axis.
;Meassured in kg*m^2
;For those not into physics that much, inertia specifies the car's
;initial resistance to get accelerated around it's axis. Smaller, lighter
;cars have much lower values here. A formula-1 car might have an inertia
;around the y-axis af about 750 kg*m^2, whereas a big station wagon may have
;4000 kg*m^2.
inertia {3500,3000,1000}

;The car's center of gravity.
;This vector (as all the others that may follow) uses the following
;coordinate system: X points to the right, Y points up and Z points to the front.
;Coordinates are in meters.
massCenter {0.0,0.4,0.25}


;An approximation of the car's borders, used for collision detection.
;More than two boxes can be used, but if too many are used, performance 
;may degrade. Each box is defined by 8 edges (top/front/right to bottom/rear/left).
numCollBoxes 2
# 0
coll.tfr {0.87,0.56,2.367}
coll.tfl {-0.87,0.56,2.367}
coll.trr {0.835,0.58,-2.368}
coll.trl {-0.835,0.58,-2.368}
coll.bfr {0.93,0.0,2.512}
coll.bfl {-0.93,0.0,2.512}
coll.brr {0.93,0.0,-2.555}
coll.brl {-0.93,0.0,-2.555}
# 1
coll.tfr {0.503,1.053,0.308}
coll.tfl {-0.503,1.053,0.308}
coll.trr {0.503,1.053,-0.95}
coll.trl {-0.503,1.053,-0.95}
coll.bfr {0.83,0.61,0.896}
coll.bfl {-0.83,0.61,0.896}
coll.brr {0.83,0.61,-1.43}
coll.brl {-0.83,0.61,-1.43}


;---graphics

;Model used to represent the car.
model "Ren_RLPD_Cruiser_Body.mdl"

;Model used to represent the car's interior.
interiorModel "Ren_RLPD_Cruiser_Int.mdl"

;Position of driver model
driverPos {0.4,0.35,0.07}

;Position of the steering wheel
steeringWheelPos {0.4,0.55,0.6}

;Angle of the steering wheel
steeringWheelAngle 20

;Number of turns, lock-to-lock.
steeringWheelTurns 1.5

steeringWheelRadius 0.18

;Model used to represent the steering wheel
steeringWheelTexture "Ren_RLPD_C_SW.png"

;Position of left and right exhaust ends. For a car with only
;one exhaust pipe, use the same coordinates for both.
exhaust1Pos {-0.5,0.0,-2.6}
exhaust2Pos {0.5,0.0,-2.6}

;Position of license plates
;for network player names
frontLicensePlatePos {0,0.22,2.6}
rearLicensePlatePos {0,0.22,-2.6}

numColors 6
# 0
colors {0.8,0.8,0.8}
# 1
colors {0,0,0.8}
# 2
colors {0.8,0,0}
# 3
colors {0.1,0.1,0.1}
# 4
colors {0.8,0.8,0}
# 5
colors {0,0.8,0}

;--engine

power 316922.444
torque 664.577
powerRPM 5700.0
torqueRPM 3400.0
jerkRPM 400.0
idleRPM 700.0
maxRPM 6500.0
engineInertia 0.45
engineFriction 100

;engine sound sample
engineSample "enginenormal2.wav"
hallSample "hallnormal2.wav"
zeroRPMSoundGain 0.6
fullRPMSoundGain 1.5
zeroThrottleSoundGain 0.6
fullThrottleSoundGain 1.1
zeroRPMSoundPitch 0.15
fullRPMSoundPitch 1.0
zeroThrottleSoundPitch 0.9
fullThrottleSoundPitch 1.1

hornSample "Ren_RLPD_Siren.wav"

;---suspension

;These determines the strength of the car's shock absorbers.
supsensionFriction 300
damperStrength 40000
frontSwayBar 30000
rearSwayBar 30000

suspensionType 6

;---drivetrain

;The ratio of the final drive gear in the car's differential.
finalDriveRatio 3.0

;The maximum amount of torque the car's clutch can transfer (in Nm).
maxClutchTorqueTransfer 2000

;this factor is used to simulate limited slip differentials.
;0 means free differential. the higher the value, the more differential locking.
;values around 100 seem to get realistic limited slip differentials.
differentialLockCoefficient 150

;For automatic transmission: When to shift up and down
shiftUpRPM 6000.0
shiftDownRPM 4000.0

;Time it takes to shift gears in seconds
gearSwitchTime 0.3

;Number of gears, including reverse and neutral.
numGears 6

;The gear ratios
# 0
gearRatios -3
# 1
gearRatios 0
# 2
gearRatios 2.7
# 3
gearRatios 1.9
# 4
gearRatios 1.4
# 5
gearRatios 1.0


;---wheels

;number of wheels (theoretically you could make vehicles with numWheels!=4. This has not been tested and might cause troubles, though).
numWheels 4


# 0
;Wheel's position
wheels.pos {-0.77,0.06,1.6}

;Wheel's inertia in kg*m^2.
wheels.inertia 1.5

;Fraction of engine power lead to this wheel.
wheels.powered 0.0

;Friction caused by rotating the wheel in Nm.
wheels.friction 5

;Maximal steering angle of this wheel in radians.
wheels.maxAngle 0.65

;Suspension travel of this wheel in meters.
wheels.maxSuspension 0.2

;Wheel's radius in meters.
wheels.radius 0.33

;Torque of the brakes on this wheel (in Nm).
wheels.braked 15000.0

;How much of the braking torque is generated by pulling the handbrake (between 0 and 1).
wheels.handbraked 0.0

;model used to represent the wheel
wheels.model "Ren_RLPD_Cruiser_Wheel.mdl"

wheels.width 0.25
wheels.texture 4

# 1
wheels.pos {0.77,0.06,1.6}
wheels.inertia 1.5
wheels.powered 0.0
wheels.friction 5
wheels.maxAngle 0.65
wheels.maxSuspension 0.2
wheels.radius 0.33
wheels.braked 15000.0
wheels.handbraked 0.0
wheels.model "Ren_RLPD_Cruiser_Wheel.mdl"
wheels.width 0.25
wheels.texture 4
# 2
wheels.pos {-0.77,0.06,-1.15}
wheels.inertia 1.5
wheels.powered 0.5
wheels.friction 5
wheels.maxAngle 0.0
wheels.maxSuspension 0.2
wheels.radius 0.33
wheels.braked 1600.0
wheels.handbraked 2.0
wheels.model "Ren_RLPD_Cruiser_Wheel.mdl"
wheels.width 0.25
wheels.texture 4
# 3
wheels.pos {0.77,0.06,-1.15}
wheels.inertia 1.5
wheels.powered 0.5
wheels.friction 5
wheels.maxAngle 0.0
wheels.maxSuspension 0.2
wheels.radius 0.33
wheels.braked 1600.0
wheels.handbraked 2.0
wheels.model "Ren_RLPD_Cruiser_Wheel.mdl"
wheels.width 0.25
wheels.texture 4





;---lights

;number of lights on the car
numLights 47


# 0
;the light's position
lights.pos {-0.79,0.4,2.4}

;direction the light is pointing to
lights.dir {0,-0.1,1}

;RGB color of the light
lights.rgb {1,1,1}

;light type: either 0 for a glowing dot, 1 for a light cone
;(visible at night only) or 2 for a dot which reflects on wet streets.
lights.type 1

;lights size, - length of light cone, or diameter of dot
lights.size 30

;what is the light used for:
;0x01: normal driving light. 
;0x08: reverse gear light.
;0x10: brake light
;0x20: left indicator
;0x40: right indicator
lights.onFlags 0x01

;tell the light to turn OFF, when one of the above mentioned lights turns on.
lights.offFlags 0x00

