;a string with the name of the carcarName "­gcw-smrtv12.png­ Smart V6 Roadster Coupe";used only for career modeyear 2003displacement 1.3966price 48000;---aerodynamics;the car's frontal air resitance.;this equals cw*S, where cw is the coefficient of friction ;and S is the frontal area of the car in square meters.
;
; assume cw is about 0.245
; front area of the Smart is 1.656 x 1.200 x 90% ~= 1.8frontAirResistance 0.44;air resistance of the side and top areas of the car.;these values are not that important to be very exact.sideAirResistance 1.5topAirResistance 2.0
; used to simulate spoilers
; Smart has tiny smaller at front, larger one at rearfrontLift -0.05rearLift -0.10;---chassis;Car's momentum of inertia around the x,y and z axis.;Meassured in kg*m^2;For those not into physics that much, inertia specifies the car's;initial resistance to get accelerated around it's axis. Smaller, lighter;cars have much lower values here. A formula-1 car might have an inertia;around the y-axis af about 750 kg*m^2, whereas a big station wagon may have;4000 kg*m^2.
;
; note that if you consider the car as a block of dimensions W H L
; Ix = mass x ( H^2 + L^2) / 12
; Iy = mass x ( W^2 + L^2) / 12
; Iz = mass x ( W^2 + H^2) / 12
;
mass 900.0inertia { 770.0, 875.0, 205.0}massCenter {0.0, 0.0, 0.0}numCollBoxes 1# 0coll.tfr {0.77, 0.66, 1.67}coll.tfl {-0.77, 0.66, 1.67}coll.trr {0.77, 0.76, -1.57}coll.trl {-0.77, 0.76, -1.57}coll.bfr {0.77, -0.26, 1.67}coll.bfl {-0.77, -0.26, 1.67}coll.brr {0.77, -0.16, -1.57}coll.brl {-0.77, -0.16, -1.57};---graphics;Model used to represent the car.model "gcw-smrt1.mdl";Model used to represent the car's interior.interiorModel "gcw-smrt1-interior.mdl"
; driver model set to 0 for standard
; set to 1 for no model
; set to 2 for just arms!
noDriverModel 0;Position of driver modeldriverPos {0.26, 0.09, -0.28}
;Position of the steering wheelsteeringWheelPos {0.26, 0.36, 0.20}
;Angle of the steering wheelsteeringWheelAngle 15;Number of turns, lock-to-lock.steeringWheelTurns 3.5steeringWheelRadius 0.15;Model used to represent the steering wheelsteeringWheelTexture "Racing_steering_wheel.pct"
;Position of left and right exhaust ends. For a car with only;one exhaust pipe, use the same coordinates for both.exhaust1Pos {0.035, -0.139, -1.521}exhaust2Pos {-0.035, -0.139, -1.521};Position of license plates;for network player namesfrontLicensePlatePos {0.0, -0.12, 1.69}rearLicensePlatePos {0.0, 0.25, -1.60}hornSample "horn2.wav"numColors 16# 0colors {0.100, 0.100, 0.100}
# 1colors {0.853, 0.100, 0.120}
# 2colors {0.473, 0.473, 0.473}
# 3colors {0.261, 0.496, 0.731}
# 4colors {0.927, 0.904, 0.786}
# 5colors {1.000, 0.912, 0.351}
# 6colors {0.000, 0.000, 0.000}
# 7colors {0.653, 0.000, 0.000}
# 8colors {0.273, 0.273, 0.273}
# 9colors {0.061, 0.296, 0.531}
# 10colors {0.727, 0.704, 0.586}
# 11colors {0.900, 0.712, 0.151}
# 12colors {0.667, 0.753, 0.224}
# 13colors {1.000, 0.333, 0.000}
# 14colors {0.900, 0.900, 0.900}
# 15colors {0.000, 0.000, 1.000}
;--engine;Car's maximal power in Watts.;One hp equals 745.69987 Watts.power 126769

;Car's maximal torque in Nm.;One lb-ft equals 1.35628105 Nm.torque 220;RPM values for the power and torque ratings.powerRPM 5250.0torqueRPM 4500.0
;RPM for engine stall, currently unusedjerkRPM 250.0;Engines idle RPMidleRPM 450.0;RPM delimtermaxRPM 6600.0;Engines Inertia in kg*m^2.;The higher this value is, the longer the engine takes to spin up.engineInertia 0.18

;engineBaseFriction,engineRPMFriction: Change engine friction.
;engineBaseFriction is a constant
;(such as resistance caused by friction of moving parts in their bearings)
;engineRPMFriction is dependant on engine speed
;(such as resistance caused by compression inside the cylinders)
;Default values are 25 and 0.02. Add either field to have both customized
;(if you just add one of the two fields, the other is set to zero).

engineBaseFriction 22.0
engineRPMFriction 0.018
engineSample "enginenormal.wav"hallSample "hallnormal.wav"turboSample "turbo.wav"zeroRPMSoundGain 0.6fullRPMSoundGain 1.2zeroThrottleSoundGain 0.5fullThrottleSoundGain 1.0zeroRPMSoundPitch 0.4fullRPMSoundPitch 1.5zeroThrottleSoundPitch 0.9fullThrottleSoundPitch 1.0turboGain 0.35;---suspension

; handling notes
;
; 1. increase tyre grip (width, stickyness)
; 2. decrease unsprung weight (wheel+tyre+axle weight)
; 3. decrease dive and wallow - stiffen damper strength
; 3a. do this too much and you lose grip (understeer)
; 4. decrease roll - stiffen anti-roll bars
; 5. work to balance car understeer <> oversteer
; 6. reduce lateral weight transfer by lowering CoG
;    and/or increasing track width.
;

supsensionFriction 900damperStrength 17000frontSwayBar 20000rearSwayBar 10000;---drivetrainfinalDriveRatio 3.92maxClutchTorqueTransfer 500differentialLockCoefficient 40shiftUpRPM 5250.0shiftDownRPM 3000.0gearSwitchTime 0.12numGears 8
# 0
gearRatios -3.92
# 1
gearRatios 0.0
# 2
gearRatios 3.30
# 3
gearRatios 2.39
# 4
gearRatios 1.84
# 5
gearRatios 1.44
# 6
gearRatios 1.04# 7
gearRatios 0.80;---wheelsnumWheels 4

; wheel weight affects wheels.inertia proportionately
; to calculate
; R - radius
; W - width
; M - material: alloy (0.7) steel (1.0) carbon fibre (0.5)
;
; inertia ~= 32.0 x R x W x M
# 0wheels.pos {-0.65, -0.03, 1.115}wheels.inertia 1.35wheels.powered 0.0wheels.friction 12wheels.maxAngle 0.48wheels.maxSuspension 0.075wheels.radius 0.295wheels.braked 5000.0wheels.handbraked 0.0wheels.model "gcw-smrt1-wheel.mdl"wheels.width 0.205wheels.texture 1
# 1wheels.pos {0.65, -0.03, 1.115}wheels.inertia 1.35wheels.powered 0.0wheels.friction 12wheels.maxAngle 0.48wheels.maxSuspension 0.075wheels.radius 0.295wheels.braked 5000.0wheels.handbraked 0.0wheels.model "gcw-smrt1-wheel.mdl"wheels.width 0.205wheels.texture 1
# 2wheels.pos {0.65, -0.03, -1.115}wheels.inertia 1.49wheels.powered 0.5wheels.friction 12wheels.maxAngle 0.0wheels.maxSuspension 0.08wheels.radius 0.295wheels.braked 1250.0wheels.handbraked 1.0wheels.model "gcw-smrt1-wheel.mdl"wheels.width 0.225wheels.texture 1
# 3wheels.pos {-0.65, -0.03, -1.115}wheels.inertia 1.49wheels.powered 0.5wheels.friction 12wheels.maxAngle 0.0wheels.maxSuspension 0.08wheels.radius 0.295wheels.braked 1250.0wheels.handbraked 1.0wheels.model "gcw-smrt1-wheel.mdl"wheels.width 0.225wheels.texture 1
;---lights

;number of lights on the car
numLights 42

;the light's position
;>> lights.pos {-0.52, 0.25, 0.86}
;direction the light is pointing to
;>> lights.dir {0.0, -0.1, 1.0}
;RGB color of the light
;>> lights.rgb {1, 1, 1}
;lights.type
; 0 = glowing RED dot
; 1 = light cone
; 2 = reflected red dot (apparently)
; 3 = white sphere (visible 360 degrees)
; 4 = white sphere (visible 360 degrees)
; 5 = nothing
; 6 = white sphere (for headlights)
;lights size, - length of light cone, or diameter of dot
;what is the light used for:
;0x01: normal driving light. 
;0x02: not used
;0x04: not used 
;0x08: reverse gear light.
;0x10: brake light
;0x20: left indicator
;0x40: right indicator
;0x80: horn
;>> lights.onFlags 0x01
;tell the light to turn OFF, when one of the above mentioned lights turns on.
;>> lights.offFlags 0x00

