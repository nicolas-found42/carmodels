;a string with the name of the carbuiltIn 1carName "­sD-VauxBadge-1-1.png­ Vauxhall Vectra BTCC";used only for career modeyear 2007displacement 2.0;---aerodynamics;the car's frontal air resitance.;this equals cw*S, where cw is the coefficient of friction ;and S is the frontal area of the car in square meters.; I'm not sure on this figure couldn't find any useful info so I made an educated guess; and tweaked until it roughly hits 140mph which is meant to be top speed at thruxtonfrontAirResistance 1.0;air resistance of the side and top areas of the car.;these values are not that important to be very exact.sideAirResistance 3topAirResistance 6;used to simulate spoilers;using the downforce stuff noted on the wikifrontLift -0.08539rearLift -0.10881;---chassis;Car's mass in kg according to S2000 rulesmass 1140;Car's momentum of inertia around the x,y and z axis.;Meassured in kg*m^2;For those not into physics that much, inertia specifies the car's;initial resistance to get accelerated around it's axis. Smaller, lighter;cars have much lower values here. A formula-1 car might have an inertia;around the y-axis af about 750 kg*m^2, whereas a big station wagon may have;4000 kg*m^2.inertia {2233.5,2387.949,533.491};The car's center of gravity.;This vector (as all the others that may follow) uses the following;coordinate system: X points to the right, Y points up and Z points to the front.;Coordinates are in meters.massCenter { 0.0, 0.45, 0.2126};An approximation of the car's borders, used for collision detection.;More than two boxes can be used, but if too many are used, performance ;may degrade. Each box is defined by 8 edges (top/front/right to bottom/rear/left).numCollBoxes 2# 0coll.tfr {0.845, 0.675, 2.305}coll.tfl {-0.845, 0.675, 2.305}coll.trr {0.707, 0.881, -2.199}coll.trl {-0.707, 0.881, -2.199}coll.bfr {0.865, 0.0, 2.305}coll.bfl {-0.865, 0.0, 2.305}coll.brr {0.917, 0.05, -2.183}coll.brl {-0.917, 0.05, -2.183}# 1coll.tfr {0.662, 1.204, 0.327}coll.tfl {-0.662, 1.204, 0.327}coll.trr {0.58, 1.235, -1.094}coll.trl {-0.58, 1.235, -1.094}coll.bfr {0.766, 0.818, 1.022}coll.bfl {-0.766, 0.818, 1.022}coll.brr {0.628, 0.939, -1.869}coll.brl {-0.628, 0.939, -1.869};---graphics;Model used to represent the car.model "slowDan-btccVectra.mdl";Model used to represent the car's interior.interiorModel "slowDan-BtccVecInt.mdl";Position of driver modeldriverPos {0.4,0.43,-0.2};Position of the steering wheelsteeringWheelPos {0.4,0.72,0.21};Angle of the steering wheelsteeringWheelAngle 5;Number of turns, lock-to-lock.steeringWheelTurns 1.0steeringWheelRadius 0.15;Model used to represent the steering wheelsteeringWheelTexture "Racing_steering_wheel.pct";Position of left and right exhaust ends. For a car with only;one exhaust pipe, use the same coordinates for both.exhaust1Pos {0.3967,0.14807,-2.4}exhaust2Pos {0.3967,0.14807,-2.375};Position of license plates;for network player namesfrontLicensePlatePos {0,0.295,2.32}rearLicensePlatePos {0,0.43,-2.325}numColors 6# 0colors {0.65, 0.122, 0.0}# 1colors {0.01, 0.01, 0.01}# 2colors {0.88, 0.01, 0.01}# 3colors {0.01, 0.25, 0.11}# 4colors {0.7, 0.733, 0.733}# 5colors {0.37, 0.266, 0.45};--enginepower 223710torque 260powerRPM 8500.0torqueRPM 6600.0jerkRPM 500.0idleRPM 1100.0maxRPM 8600.0engineInertia 0.2engineFriction 95;engine sound sampleengineSample "engineperformance.wav"hallSample "hallperformance.wav"zeroRPMSoundGain 0.9fullRPMSoundGain 1.6zeroThrottleSoundGain 0.5fullThrottleSoundGain 1.2zeroRPMSoundPitch 0.4fullRPMSoundPitch 2.0zeroThrottleSoundPitch 0.9fullThrottleSoundPitch 1.1;---suspension;These determines the strength of the car's shock absorbers.supsensionFriction 800damperStrength 37000frontSwayBar 17000rearSwayBar 19000;---drivetrain;from X-tracfinalDriveRatio 3.76923;The maximum amount of torque the car's clutch can transfer (in Nm).maxClutchTorqueTransfer 350;this factor is used to simulate limited slip differentials.;0 means free differential. the higher the value, the more differential locking.;values around 100 seem to get realistic limited slip differentials.;differentialLockCoefficient 125;For automatic transmission: When to shift up and downshiftUpRPM 8500.0shiftDownRPM 4750.0;Time it takes to shift gears in secondsgearSwitchTime 0.3;Number of gears, including reverse and neutral.numGears 8;The gear ratios# 0gearRatios -3.75# 1gearRatios 0# 2gearRatios 2.923# 3gearRatios 2.071# 4gearRatios 1.611# 5gearRatios 1.350# 6gearRatios 1.211# 7gearRatios 1.095;---wheels;number of wheels (theoretically you could make vehicles with numWheels!=4.;This has not been tested and might cause troubles, though).numWheels 4# 0;Wheel's positionwheels.pos {-0.821, 0.225, 1.4094};Wheel's inertia in kg*m^2.;slightly lower for smaller front wheelswheels.inertia 2.4;Fraction of engine power lead to this wheel.wheels.powered 0.5;Friction caused by rotating the wheel in Nm.wheels.friction 20;Maximal steering angle of this wheel in radians.;wheels.maxAngle 0.48wheels.maxAngle 0.4;Suspension travel of this wheel in meters.wheels.maxSuspension 0.1;Wheel's radius in meters.wheels.radius 0.305;Torque of the brakes on this wheel (in Nm).wheels.braked 6300.0;How much of the braking torque is generated by pulling the handbrake (between 0 and 1).wheels.handbraked 0.0;model used to represent the wheelwheels.model "slowDan-BtccVecWheel.mdl"wheels.width 0.245wheels.texture 4wheels.grip 1.0;We have got spec racing slicks for S2000.wheels.stickyness .13# 1wheels.pos {0.821, 0.225, 1.4094}wheels.inertia 2.4wheels.powered 0.5wheels.friction 20;wheels.maxAngle 0.4wheels.maxAngle 0.48wheels.maxSuspension 0.1wheels.radius 0.305wheels.braked 6300.0wheels.handbraked 0.0wheels.model "slowDan-BtccVecWheel.mdl"wheels.width 0.245wheels.texture 4wheels.grip 1.0wheels.stickyness .13# 2wheels.pos {-0.821, 0.225, -1.3106}wheels.inertia 2.4wheels.powered 0.0wheels.friction 20wheels.maxAngle 0.0wheels.maxSuspension 0.1wheels.radius 0.305wheels.braked 2100.0wheels.handbraked 1.0wheels.model "slowDan-BtccVecWheel.mdl"wheels.width 0.245wheels.texture 4wheels.grip 1.0wheels.stickyness .13wheels.loadSensitivity -0.04# 3wheels.pos {0.821, 0.225, -1.3106}wheels.inertia 2.4wheels.powered 0.0wheels.friction 20wheels.maxAngle 0.0wheels.maxSuspension 0.1wheels.radius 0.305wheels.braked 2100.0wheels.handbraked 1.0wheels.model "slowDan-BtccVecWheel.mdl"wheels.width 0.245wheels.texture 4wheels.grip 1.0wheels.stickyness .13wheels.loadSensitivity -0.04; used a little loadsensitivity to keep braking stable;---lights;number of lights on the carnumLights 30;the light's position;>> lights.pos {-0.52, 0.25, 0.86};direction the light is pointing to;>> lights.dir {0.0, -0.1, 1.0};RGB color of the light;>> lights.rgb {1, 1, 1};lights.type; 0 = glowing RED dot; 1 = light cone; 2 = reflected red dot (apparently); 3 = white sphere (visible 360 degrees); 4 = white sphere (visible 360 degrees); 5 = nothing; 6 = white sphere (for headlights);lights size, - length of light cone, or diameter of dot;what is the light used for:;0x01: normal driving light. ;0x02: not used;0x04: not used ;0x08: reverse gear light.;0x10: brake light;0x20: left indicator;0x40: right indicator;0x80: horn;>> lights.onFlags 0x01;tell the light to turn OFF, when one of the above mentioned lights turns on.;>> lights.offFlags 0x00;all shamelessly borrowed from Giles, thanks!; headlight cones# 0lights.pos {0.56, 0.522, 2.108}lights.dir {0.0, -0.10, 1.0}lights.rgb {1.0, 1.0, 0.9}lights.type 1lights.size 25lights.onFlags 0x81lights.offFlags 0x00# 1lights.pos {-0.56, 0.522, 2.108}lights.dir {0.0, -0.10, 1.0}lights.rgb {1.0, 1.0, 0.9}lights.type 1lights.size 25lights.onFlags 0x81lights.offFlags 0x00; headlight flares# 2lights.pos {0.55, 0.5, 2.05}lights.dir {0, 0, 1}lights.rgb {1.0, 1.0, 0.9}lights.type 6lights.size 0.12lights.onFlags 0x01lights.offFlags 0x00# 3lights.pos {-0.55, 0.5, 2.05}lights.dir {0, 0, 1}lights.rgb {1.0, 1.0, 0.9}lights.type 6lights.size 0.12lights.onFlags 0x01lights.offFlags 0x00# 4lights.pos {0.67, 0.52, 2.05}lights.dir {0, 0, 1}lights.rgb {1.0, 1.0, 0.9}lights.type 6lights.size 0.12lights.onFlags 0x01lights.offFlags 0x00# 5lights.pos {-0.67, 0.52, 2.05}lights.dir {0, 0, 1}lights.rgb {1.0, 1.0, 0.9}lights.type 6lights.size 0.12lights.onFlags 0x01lights.offFlags 0x00; rear lights# 6lights.pos {0.65, 0.75, -2.1222}lights.dir {0.0, 0.0, -1.0}lights.rgb {1.0 ,0.05 ,0.0 }lights.type 0lights.size 0.08lights.onFlags 0x01lights.offFlags 0x00# 7lights.pos {-0.65, 0.75, -2.1222}lights.dir {0.0, 0.0, -1.0}lights.rgb {1.0 ,0.05 ,0.0 }lights.type 0lights.size 0.08lights.onFlags 0x01lights.offFlags 0x00; rain-reflected rear lights...# 8lights.pos {0.65, 0.75, -2.1222}lights.dir {0.0, 0.0, -1.0}lights.rgb {1.0 ,0.05 ,0.0 }lights.type 2lights.size 0.16lights.onFlags 0x01lights.offFlags 0x00# 9lights.pos {-0.65, 0.75, -2.1222}lights.dir {0.0, 0.0, -1.0}lights.rgb {1.0 ,0.05 ,0.0 }lights.type 2lights.size 0.16lights.onFlags 0x01lights.offFlags 0x00; brake lights# 10lights.pos {0.62,0.66,-2.1222}lights.dir {0.0, 0.0, -1.0}lights.rgb {1.0 ,0.05 ,0.0 }lights.type 0lights.size 0.09lights.onFlags 0x10lights.offFlags 0x00# 11lights.pos {-0.62,0.66,-2.1222}lights.dir {0.0, 0.0, -1.0}lights.rgb {1.0 ,0.05 ,0.0 }lights.type 0lights.size 0.09lights.onFlags 0x10lights.offFlags 0x00# 12lights.pos {0.67,0.66,-2.1222}lights.dir {0.0, 0.0, -1.0}lights.rgb {1.0 ,0.05 ,0.0 }lights.type 0lights.size 0.09lights.onFlags 0x10lights.offFlags 0x00# 13lights.pos {-0.67,0.66,-2.1222}lights.dir {0.0, 0.0, -1.0}lights.rgb {1.0 ,0.05 ,0.0 }lights.type 0lights.size 0.09lights.onFlags 0x10lights.offFlags 0x00; brake lights reflections# 14lights.pos {-0.64, 0.66,-2.1322}lights.dir {0.0, 0.0, -1.0}lights.rgb {1.0 ,0.05 ,0.0 }lights.type 2lights.size 0.13lights.onFlags 0x10lights.offFlags 0x00# 15lights.pos {0.64, 0.66,-2.1322}lights.dir {0.0, 0.0, -1.0}lights.rgb {1.0 ,0.05 ,0.0 }lights.type 2lights.size 0.13lights.onFlags 0x10lights.offFlags 0x00; headlight horn flares# 16lights.pos {0.67, 0.52, 2.05}lights.dir {0, 0, 1}lights.rgb {1.0, 1.0, 0.9}lights.type 6lights.size 0.15lights.onFlags 0x80lights.offFlags 0x00# 17lights.pos {-0.67, 0.52, 2.05}lights.dir {0, 0, 1}lights.rgb {1.0, 1.0, 0.9}lights.type 6lights.size 0.15lights.onFlags 0x80lights.offFlags 0x00; reversing lights# 18lights.pos {0.66, 0.59, -2.139}lights.dir {0.0, 0.0, -1.0}lights.rgb {1.0, 1.0, 1.0}lights.type 0lights.size 0.08lights.onFlags 0x08lights.offFlags 0x00# 19lights.pos {-0.66, 0.59, -2.139}lights.dir {0.0, 0.0, -1.0}lights.rgb {1.0, 1.0, 1.0}lights.type 0lights.size 0.08lights.onFlags 0x08lights.offFlags 0x00; reverse reflections# 20lights.pos {0.66, 0.59, -2.139}lights.dir {0.0, 0.0, -1.0}lights.rgb {1.0, 1.0, 1.0}lights.type 2lights.size 0.1lights.onFlags 0x08lights.offFlags 0x00# 21lights.pos {-0.66, 0.59, -2.139}lights.dir {0.0, 0.0, -1.0}lights.rgb {1.0, 1.0, 1.0}lights.type 2lights.size 0.1lights.onFlags 0x08lights.offFlags 0x00; indicator lights / flash with horn# 22lights.pos {0.646, 0.843, -2.112}lights.dir {0.0, 0.0, -1.0}lights.rgb {1.0, 0.75, 0.0 }lights.type 0lights.size 0.08lights.onFlags 0xc0lights.offFlags 0x00# 23lights.pos {-0.646, 0.843, -2.112}lights.dir {0.0, 0.0, -1.0}lights.rgb {1.0, 0.75, 0.0 }lights.type 0lights.size 0.08lights.onFlags 0xa0lights.offFlags 0x00; indicator reflections# 24lights.pos {0.616, 0.843, -2.112}lights.dir {0.0, 0.0, -1.0}lights.rgb {1.0, 0.75, 0.0 }lights.type 2lights.size 0.08lights.onFlags 0xc0lights.