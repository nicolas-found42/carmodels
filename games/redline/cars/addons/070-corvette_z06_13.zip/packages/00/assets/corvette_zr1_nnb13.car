carName "­corvette_nnb_ver.png­Corvette C6 ZR1"year 2009displacement 6.2price 100000
builtIn 1;---aerodynamics;the car's frontal air resitance.;this equals cw*S, where cw is the coefficient of friction ;and S is the frontal area of the car in square meters.
;Z06
;frontAirResistance 0.7
;ZR1 is 6% draggier than Z06:
;frontAirResistance 0.742
frontAirResistance 0.77
;air resistance of the side and top areas of the car.;these values are not that important to be very exact.sideAirResistance 2.13topAirResistance 3.74;used to simulate spoilers;frontLift -0.1984;rearLift -0.4576frontLift -0.2059rearLift -0.4749
;---chassis;Car's mass in kgmass 1519;Car's momentum of inertia around the x,y and z axis.;Meassured in kg*m^2
inertia {2913, 3037, 819};The car's center of gravity.;This vector (as all the others that may follow) uses the following;coordinate system: X points to the right, Y points up and Z points to the front.;Coordinates are in meters.
;52/48 f/rmassCenter {0.0, 0.35, 0.0422};An approximation of the car's borders, used for collision detection.;More than two boxes can be used, but if too many are used, performance ;may degrade. Each box is defined by 8 edges (top/front/right to bottom/rear/left).numCollBoxes 2# 0coll.tfr {0.965, 0.77, 2.23}coll.tfl {-0.965, 0.77, 2.23}coll.trr {0.965, 0.77, -2.23}coll.trl {-0.965, 0.77, -2.23}coll.bfr {0.965, 0.18, 2.23}coll.bfl {-0.965, 0.18, 2.23}coll.brr {0.965, 0.18, -2.23}coll.brl {-0.965, 0.18, -2.23}# 1coll.tfr {0.85,1.31,0}coll.tfl {-0.85,1.31,0}coll.trr {0.85,1.31,-0.675}coll.trl {-0.85,1.31,-0.675}coll.bfr {0.955,0.853,-0.3}coll.bfl {-0.955,0.853,-0.3}coll.brr {0.955,0.853,-2.27}coll.brl {-0.955,0.853,-2.27};---graphics;Model used to represent the car.model "corvette_zr1_nnb2.mdl"shadowModel "corvette_z06_nnb_shd3.mdl";Model used to represent the car's interior.interiorModel "corvette_zr1_inside_nnb.mdl";Position of driver modeldriverPos {0.35,0.50,-0.53};Position of the steering wheelsteeringWheelPos {0.368,0.74,0.10};Angle of the steering wheelsteeringWheelAngle 24;Number of turns, lock-to-lock.steeringWheelTurns 2.9steeringWheelRadius 0.17;Model used to represent the steering wheelsteeringWheelTexture "Racing_steering_wheel.pct";Position of left and right exhaust ends. For a car with only;one exhaust pipe, use the same coordinates for both.exhaust1Pos {-0.16,0.23,-2.1}exhaust2Pos {0.16,0.23,-2.1};Position of license plates;for network player namesfrontLicensePlatePos {0,0.54,2.0}rearLicensePlatePos {0,0.69,-2.266}hornSample "horn2.wav"numColors 7# 0colors {0.1,0.1,0.85}# 1colors {0.45,0.1,0.1}
# 2colors {0.27,0.3,0.27}
# 3
colors {0.75,0.75,0.1}
# 4
colors {0.75,0.1,0.1}
# 5
colors {0.15, 0.15, 0.55}
# 6colors {0.1,0.1,0.1};--engine;Car's maximal power in Watts.;One hp equals 745.69987 Watts.power 475757;Car's maximal torque in Nm.;One lb-ft equals 1.35628105 Nm.torque 819;RPM values for the power and torque ratings.powerRPM 6500torqueRPM 3800;RPM for engine stall, currently unusedjerkRPM 500.0;Engines idle RPMidleRPM 1000;RPM delimtermaxRPM 6600;Engines Inertia in kg*m^2.;The higher this value is, the longer the engine takes to spin up.engineInertia 0.25engineBaseFriction 42engineRPMFriction 0.042;engine sound sampleengineSample "corvette_C6R_nnb.wav"hallSample "corvette_C6R_nnb_hall.wav"
turboSample "turbo.wav"zeroRPMSoundGain 0.8fullRPMSoundGain 1.15zeroThrottleSoundGain 0.5fullThrottleSoundGain 1.0zeroRPMSoundPitch 0.1fullRPMSoundPitch 0.942zeroThrottleSoundPitch 1.1fullThrottleSoundPitch 1.0
turboGain 0.15;---suspension;These determines the strength of the car's shock absorbers.supsensionFriction 1200damperStrength 41000frontSwayBar 23500rearSwayBar 33000;---drivetrain;The ratio of the final drive gear in the car's differential.finalDriveRatio 3.42;The maximum amount of torque the car's clutch can transfer (in Nm).maxClutchTorqueTransfer 1400;this factor is used to simulate limited slip differentials.;0 means free differential. the higher the value, the more differential locking.;values around 100 seem to get realistic limited slip differentials.differentialLockCoefficient 120

;For automatic transmission: When to shift up and downshiftUpRPM 6600shiftDownRPM 3000
shiftUpRPMFix 6600
;Time it takes to shift gears in secondsgearSwitchTime 0.3;Number of gears, including reverse and neutral.numGears 8;The gear ratios
; from http://www.corvettemuseum.com/specs/2009zr1/index.shtml# 0gearRatios -3.11# 1gearRatios 0# 2gearRatios 2.29# 3gearRatios 1.61# 4gearRatios 1.23# 5gearRatios 1.00# 6gearRatios 0.81# 7gearRatios 0.67;---wheelsnumWheels 4# 0
;285/30ZR19wheels.pos {-0.80,0.36485,1.343}wheels.inertia 2.53wheels.powered 0.0wheels.friction 10wheels.maxAngle 0.56wheels.maxSuspension 0.08wheels.radius 0.326898wheels.braked 11000wheels.handbraked 0.0wheels.model "corvette_zr1_nnb_ftire.mdl"
wheels.customBrakeModel "corvette_zr1_nnb_cala.mdl"wheels.width 0.285wheels.stickyness 0.13wheels.loadSensitivity -0.2# 1
;285/30ZR19wheels.pos {0.80,0.36485,1.343}wheels.inertia 2.53wheels.powered 0.0wheels.friction 10wheels.maxAngle 0.56wheels.maxSuspension 0.08wheels.radius 0.326898wheels.braked 11000wheels.handbraked 0.0wheels.model "corvette_zr1_nnb_ftire.mdl"
wheels.customBrakeModel "corvette_zr1_nnb_cala.mdl"wheels.width 0.285wheels.stickyness 0.13wheels.loadSensitivity -0.2# 2
