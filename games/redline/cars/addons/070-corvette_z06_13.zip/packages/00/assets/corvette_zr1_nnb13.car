wheels.customBrakeModel "corvette_zr1_nnb_calb.mdl"wheels.width 0.335wheels.stickyness 0.13wheels.loadSensitivity -0.24;---lights;number of lights on the carnumLights 36;the light's position;>> lights.pos {-0.52, 0.25, 0.86};direction the light is pointing to;>> lights.dir {0.0, -0.1, 1.0};RGB color of the light;>> lights.rgb {1, 1, 1};lights.type; 0 = glowing RED dot; 1 = light cone; 2 = reflected red dot (apparently); 3 = white sphere (visible 360 degrees); 4 = white sphere (visible 360 degrees); 5 = nothing; 6 = white sphere (for headlights);lights size, - length of light cone, or diameter of dot;what is the light used for:;0x01: normal driving light. ;0x02: not used;0x04: not used ;0x08: reverse gear light.;0x10: brake light;0x40: right indicator;0x20: leftt indicator;0x80: horn;>> lights.onFlags 0x01;tell the light to turn OFF, when one of the above mentioned lights turns on.;>> lights.offFlags 0x00;headlights# 0lights.pos {0.707,0.655,1.75}lights.dir {0,-0.1,1}lights.rgb {0.85,0.85,1}lights.type 1lights.size 25lights.onFlags 0x01lights.offFlags 0x80# 1lights.pos {-0.707,0.655,1.75}lights.dir {0,-0.1,1}lights.rgb {0.85,0.85,1}lights.type 1lights.size 25lights.onFlags 0x01lights.offFlags 0x80# 2lights.pos {0.791,0.655,1.75}lights.dir {0,-0.1,1}lights.rgb {0.95,0.95,0}lights.type 6lights.size 0.2lights.onFlags 0xc0lights.offFlags 0x00# 3lights.pos {-0.791,0.655,1.75}lights.dir {0,-0.1,1}lights.rgb {0.95,0.95,0}lights.type 6lights.size 0.2lights.onFlags 0xa0lights.offFlags 0x00;night lights to turn off with horn# 4lights.pos {0.707,0.656,1.787}lights.dir {0,-0.1,1}lights.rgb {0.90,0.90,1}lights.type 6lights.size 0.3lights.onFlags 0x01lights.offFlags 0x80# 5lights.pos {-0.707,0.656,1.787}lights.dir {0,-0.1,1}lights.rgb {0.90,0.90,1}lights.type 6lights.size 0.3lights.onFlags 0x01lights.offFlags 0x80# 6lights.pos {0.637,0.635,1.857}lights.dir {0,-0.1,1}lights.rgb {0.90,0.90,1}