;bru based on a model included with the Redline Tool Chest.carName "Ford Truck Tall XC";bru small block ford used from 55 truck.
year 1968displacement 4.79

;---aerodynamics;the car's frontal air resitance.;this equals cw*S, where cw is the coefficient of friction ;and S is the frontal area of the car in square meters.frontAirResistance 2.0;air resistance of the side and top areas of the car.;these values are not that important to be very exact.sideAirResistance 2.0topAirResistance 3.0;used to simulate spoilersfrontLift -0.0rearLift -0.0;---chassismass 1330.0inertia {2038,2817,617}massCenter {0.0,0.6,0.21}numCollBoxes 2# 0coll.tfr {0.955,0.953,2.2.02}coll.tfl {-0.955,0.953,2.02}coll.trr {0.955,0.953,-2.03}coll.trl {-0.955,0.953,-2.03}coll.bfr {0.955,0.375,2.02}coll.bfl {-0.955,0.375,2.02}coll.brr {0.955,0.375,-2.03}coll.brl {-0.955,0.375,-2.03}# 1coll.tfr {0.85,1.41,0.31}coll.tfl {-0.85,1.41,0.31}coll.trr {0.85,1.41,-0.545}coll.trl {-0.85,1.41,-0.545}coll.bfr {0.955,0.953,0.66}coll.bfl {-0.955,0.953,0.66}coll.brr {0.955,0.953,-1.82}coll.brl {-0.955,0.953,-1.82};---graphicsmodel "bru-68fx.mdl"interiorModel "null.mdl"driverPos {0.4,0.8,0.20}steeringWheelPos {0.4,1,0.65}steeringWheelAngle 35steeringWheelTurns 3.5steeringWheelRadius 0.325steeringWheelTexture "old_steering_wheel01.pct"exhaust1Pos {-0.45,0.28,-2.08}exhaust2Pos {0.45,0.28,-2.08}frontLicensePlatePos {0,0.45,2.03}rearLicensePlatePos {0,0.46,-2.1}numColors 5# 0colors {0.7,0.5,0.0}# 1colors {0.5,0.0,0.7}# 2colors {0.9,0.3,0.2}# 3colors {0.3,0.4,0.8}# 4colors {0.6,0.6,0.6};--engine; from Pickup Truckpower 150631torque 391powerRPM 4600.0torqueRPM 2600.0jerkRPM 450.0idleRPM 800.0maxRPM 5000.0engineInertia 0.5engineFriction 200engineSample "enginenormal.wav"hallSample "hallnormal.wav"zeroRPMSoundGain 0.8fullRPMSoundGain 1.0zeroThrottleSoundGain 0.5fullThrottleSoundGain 1.1zeroRPMSoundPitch 0.4fullRPMSoundPitch 1.2zeroThrottleSoundPitch 0.9fullThrottleSoundPitch 1.0;---suspension;supsensionFriction 4000;damperStrength 60000supsensionFriction 1000damperStrength 30000frontSwayBar 20000rearSwayBar 17000;---drivetrainfinalDriveRatio 3.89maxClutchTorqueTransfer 900differentialLockCoefficient 100shiftUpRPM 5000.0shiftDownRPM 3000.0gearSwitchTime 0.12numGears 5# 0gearRatios -2.32# 1gearRatios 0# 2gearRatios 2.32# 3gearRatios 1.4# 4gearRatios 1.0;---wheels; bru mustang wheel sizes usednumWheels 4# 0wheels.pos {-0.81,0.33,1.47}wheels.inertia 2.2wheels.powered 0.25wheels.friction 10wheels.maxAngle 0.48wheels.maxSuspension 0.3wheels.radius 0.34wheels.braked 3000.0wheels.handbraked 0.0wheels.model "wheel-classic-disc.mdl"wheels.width 0.225wheels.texture 5# 1wheels.pos {0.81,0.33,1.47}wheels.inertia 2.2wheels.powered 0.25wheels.friction 10wheels.maxAngle 0.48wheels.maxSuspension 0.3wheels.radius 0.34wheels.braked 3000.0wheels.handbraked 0.0wheels.model "wheel-classic-disc.mdl"wheels.width 0.225wheels.texture 5# 2wheels.pos {-0.8,0.33,-1.10}wheels.inertia 2.2wheels.powered 0.25wheels.friction 10wheels.maxAngle 0.0wheels.maxSuspension 0.3wheels.radius 0.34wheels.braked 1000.0wheels.handbraked 1.0wheels.model "wheel-classic-disc.mdl"wheels.width 0.255wheels.texture 5# 3wheels.pos {0.8,0.33,-1.10}wheels.inertia 2.2wheels.powered 0.25wheels.friction 10wheels.maxAngle 0.0wheels.maxSuspension 0.3wheels.radius 0.34wheels.braked 1000.0wheels.handbraked 1.0wheels.model "wheel-classic-disc.mdl"wheels.width 0.255wheels.texture 5;--LightsnumLights 12

