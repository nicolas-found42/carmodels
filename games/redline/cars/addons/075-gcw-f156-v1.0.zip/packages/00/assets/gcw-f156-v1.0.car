wheels.handbraked 1.0
wheels.model "gcw-f156-wheel.mdl"
wheels.width 0.1525
wheels.texture 4
; racing slicks... extra grippy!
wheels.stickyness 0.125


;---lights

;number of lights on the car (just one)
numLights 1
# 0
lights.pos {0.000, -0.245, -1.939}
lights.dir {0.0, 0.0, -1.0}
lights.rgb {1.0 ,0.05 ,0.0 }
lights.type 0
lights.size 0.12
lights.onFlags 0x10
lights.offFlags 0x00

;-- Add-On optionsnumAddOns 1initialAddOns 0x01

; driver model# 0addOns.hasGraphic 1addOns.model "gcw-f156-driver.mdl"
