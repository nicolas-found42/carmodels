wheels.stickyness 0.8# 2wheels.pos {-0.62,0.32,-1.32}wheels.inertia 2.2wheels.friction 10wheels.powered 0.4wheels.maxAngle 0.0wheels.maxSuspension 0.1wheels.radius 0.33wheels.braked 9100.0wheels.handbraked 1.0wheels.model "buz_dpwheel.mdl"wheels.width 0.635wheels.texture 1
wheels.stickyness 0.9# 3wheels.pos {0.62,0.32,-1.32}wheels.inertia 2.2wheels.friction 10wheels.powered 0.4wheels.maxAngle 0.0wheels.maxSuspension 0.1wheels.radius 0.33wheels.braked 9100.0wheels.handbraked 1.0wheels.model "buz_dpwheel.mdl"wheels.width 0.635wheels.texture 1
wheels.stickyness 0.9

