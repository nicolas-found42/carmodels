;buz_diablopimped.car;Pimped 2008 Lamborghini Diablo VT w/Custom Turbocharged 7.0 Litre V-12
;Car edited by Buzzzzy, originally by the Redline team (Ambrosia and Jonas's
;team).  Skins edited by me as well.

;Hurrah for the Diablo, messed up and now pwns the GT!!!
;And hurrah for ugly spoilers, ugly they may be, they help pwn the Testarossa, too!!
;And forget lousy GTs and Tests, now pwns the VTT and the Pimped Gallardo at
;slow tracks!!!  Take *that*!

;Changes in final release in comments.

;Built in changed to 0 now I now what it means (show in world records).
;This car is too good to be built in.builtIn 0;carName "Pimped 2000 Lamborghini Diablo VT"carName "≠omen.png≠ Pimped Diablo"
;Got rid of challenge requirements.  Ah well...;carName "Hellraiser Revamped";engineName "7.0 Litre Turbocharged V-12"year 2008displacement 9.2

;_Very_ Expensive!!price 800000;---aerodynamics

;Air resistance lowered and side upped for performance.  Lift changed to fix
;frontup issues.frontAirResistance 0.075sideAirResistance 3.15topAirResistance 0.3frontLift -0.105rearLift -0.195;---chassis
;Slightly lighter than v0.9mass 1070.0
;Inertia lowered due to weight and for performance.inertia {1950,1950,325}

;Center of gravity now on the ground and up frontmassCenter {0.0,0.0,0.15}numCollBoxes 2# 0coll.tfr {0.955,0.853,2.29}coll.tfl {-0.955,0.853,2.29}coll.trr {0.955,0.853,-2.2}coll.trl {-0.955,0.853,-2.2}coll.bfr {0.955,0.275,2.29}coll.bfl {-0.955,0.275,2.29}coll.brr {0.955,0.275,-2.2}coll.brl {-0.955,0.275,-2.2}# 1coll.tfr {0.85,1.31,0.385}coll.tfl {-0.85,1.31,0.385}coll.trr {0.85,1.31,-0.675}coll.trl {-0.85,1.31,-0.675}coll.bfr {0.955,0.853,0.828}coll.bfl {-0.955,0.853,0.828}coll.brr {0.955,0.853,-2.27}coll.brl {-0.955,0.853,-2.27};---graphics

;Skins made, new model required.model "buz_pdiablo.mdl"
;New interior to make seats look better (see addons)interiorModel "buzpd-interior.mdl"driverPos {0.41,0.4,-0.05}steeringWheelPos {0.41,0.54,0.82}steeringWheelAngle 15

;Turns lowered againsteeringWheelTurns 0.7
;New steering wheelsteeringWheelTexture "pdiabloswheel.txr"

;Radius raised due to tinyness of betas, however lowered compared to DiablosteeringWheelRadius 0.225

;Skins again, now respondingnumColors 10# 0colors {1,0.72,0}# 1colors {1,0,0}# 2colors {1,0.48,0}# 3colors {0.11,0.05,0.05}
# 4
colors {0,0.16,0.5}
# 5
colors {1,0.26,0}
# 6
colors {1,0.98,0}
# 7
colors {0.75,0.59,0.13}0
# 8
colors {0.55,0.55,0.55}
# 9
colors {0.9,0.9,0.9}
tachoTexture "tacho8k.pct"tachoPointer "pointer.pct"tachoPointerWidth 0.65tachoZero -119tacho1000 29speedoTexture "speedo140.pct"speedoPointer "pointer.pct"speedoPointerWidth 0.65speedoZero -121speedo10 16.75
;width changed for no reason aboveexhaust1Pos {0.05,0.45,-2.2}exhaust2Pos {-0.05,0.45,-2.2}frontLicensePlatePos {0,0.25,2.29}rearLicensePlatePos {0,0.61,-2.19};--enginepower 436234.42395torque 610powerRPM 7100torqueRPM 5500maxRPM 8500.0idleRPM 1100.0jerkRPM 500.0

;Inertia loweredengineInertia 0.115engineFriction 100

;New engine soundsengineSample "buz_pdiabloengine.wav"hallSample "buz_pdiablohall.wav"
turboSample "turbo.wav"zeroRPMSoundGain 1.1fullRPMSoundGain 1.6zeroThrottleSoundGain 0.8fullThrottleSoundGain 1.5zeroRPMSoundPitch 0.3fullRPMSoundPitch 1.7zeroThrottleSoundPitch 0.4fullThrottleSoundPitch 0.8

;Turbo now louder still, gosh, those engine sounds are loud, aren’t they?  Can’t
;here turbo without a ridiculous soundgain value.
turboGain 1.75

;New horn, it’s an electric guitar!!!hornSample "buz_guitarhonk.wav";---suspension

;suspension and swaybar fixed to fix flipping issues in turbo arcade.supsensionFriction 1500damperStrength 60000frontSwayBar 15000rearSwayBar 20000;---drivetrain

;FDR loweredfinalDriveRatio 4.11maxClutchTorqueTransfer 1200

;Raised
differentialLockCoefficient 75shiftUpRPM 7950.0shiftDownRPM 3500.0gearSwitchTime 0.1

;Gear ratios tweaked for smoother changes.numGears 8# 0gearRatios -0.7# 1gearRatios 0# 2gearRatios 2.31# 3gearRatios 1.68# 4gearRatios 1.1# 5gearRatios 0.99# 6gearRatios 0.692
# 7
gearRatios 0.64

;Fiddled with wheels a bit, removed load sensitivity.  Changed to custom model.;---wheelsnumWheels 4# 0wheels.pos {-0.79,0.32,1.38}wheels.inertia 2.2wheels.friction 10wheels.powered 0.1wheels.maxAngle 0.85wheels.maxSuspension 0.1wheels.radius 0.32wheels.braked 16500.0wheels.handbraked 0.0wheels.model "buz_dpwheel.mdl"wheels.width 0.245wheels.texture 0
wheels.stickyness 0.8
