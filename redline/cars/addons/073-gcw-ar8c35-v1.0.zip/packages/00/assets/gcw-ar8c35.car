;Model used to represent the car.model "gcw-ar8c35.mdl";Model used to represent the car's interior.interiorModel "gcw-ar8c35-dash.mdl";Position of driver modeldriverPos {0.0, 0.125, -0.50};Position of the steering wheelsteeringWheelPos {0.0, 0.41, -0.15};Angle of the steering wheelsteeringWheelAngle 15;Number of turns, lock-to-lock.steeringWheelTurns 2

;Model used to represent the steering wheelsteeringWheelTexture "gcw-ar8c35-steeringwheel.png"
steeringWheelRadius 0.19
;Position of left and right exhaust ends. For a car with only;one exhaust pipe, use the same coordinates for both.exhaust1Pos {-0.125, 0.075, -1.962}exhaust2Pos {-0.125, 0.075, -1.962};The lower this value, the more the car's exhaust will spit out banging noises and flames.exhaustFire 210000;Position of license plates;for network player namesfrontLicensePlatePos {0.01,0.38,1.92}rearLicensePlatePos {-0.03,0.35,-1.52};--engine;Car's maximal power in Watts.;One hp equals 745.69987 Watts.
;127bhp
power 94703
; 330 bhp @ 5400 rpm

power 246080

; estimated:
; 325 Nm torque @ 4000 rpm

torque 325

powerRPM 5400.0
torqueRPM 3500.0

idleRPM 1000.0
jerkRPM 500.0

maxRPM 6001.0

engineInertia 0.25

engineBaseFriction 28
engineRPMFriction 0.05

;engine sound sampleengineSample "gcw-ar8c35normal.wav"
hallSample "gcw-ar8c35hall.wav"turboSample "turbo.wav"zeroRPMSoundGain 0.8fullRPMSoundGain 1.2zeroThrottleSoundGain 0.8fullThrottleSoundGain 1.6zeroRPMSoundPitch 0.5fullRPMSoundPitch 3.5zeroThrottleSoundPitch 0.9fullThrottleSoundPitch 1.1
turboGain 1

hornSample "horn2.wav";---suspension;These determines the strength of the car's shock absorbers.supsensionFriction 900damperStrength 18000;sway Bars will cause the car to tilt less in corners. The higher these values,;the less the car will tilt to the side when corneringfrontSwayBar 16500rearSwayBar 19500;---drivetrain;The maximum amount of torque the car's clutch can transfer (in Nm).maxClutchTorqueTransfer 360;this factor is used to simulate limited slip differentials.;0 means free differential. the higher the value, the more differential locking.;values around 100 seem to get realistic limited slip differentials.differentialLockCoefficient 0;For automatic transmission: When to shift up and downshiftDownRPM 2000shiftUpRPM 5700;Time it takes to shift gears in secondsgearSwitchTime 0.5;Number of gears, including reverse and neutral.numGears 6;The ratio of the final drive gear in the car's differential.finalDriveRatio 3.6;The gear ratios
