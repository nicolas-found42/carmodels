;a string with the name of the car
builtIn 1
carName "­gcwcoop13.png­Cooper Climax (1960)"

;used only for career mode
year 1960
displacement 2.495

;---aerodynamics

;the car's frontal air resitance.
;this equals cw*S, where cw is the coefficient of friction 
;and S is the frontal area of the car in square meters.
frontAirResistance 0.85

;air resistance of the side and top areas of the car.
;these values are not that important to be very exact.
sideAirResistance 2.50
topAirResistance 2.30

;used to simulate spoilers
frontLift 0.20
rearLift -0.30


;---chassis

;Car's mass in kg (wet weight)
mass 750.0

;Car's momentum of inertia around the x,y and z axis.
;Meassured in kg*m^2
;For those not into physics that much, inertia specifies the car's
;initial resistance to get accelerated around it's axis. Smaller, lighter
;cars have much lower values here. A formula-1 car might have an inertia
;around the y-axis af about 750 kg*m^2, whereas a big station wagon may have
;4000 kg*m^2.
inertia {799, 812, 88}

;The car's center of gravity.
;This vector (as all the others that may follow) uses the following
;coordinate system: X points to the right, Y points up and Z points to the front.
;Coordinates are in meters.
; correcting z towards 0.0 helps balance!
massCenter {0.0, 0.10, -0.125}


;An approximation of the car's borders, used for collision detection.
;More than two boxes can be used, but if too many are used, performance 
;may degrade. Each box is defined by 8 edges (top/front/right to bottom/rear/left).
; 0 - body 1 - front wheels 2- rear wheels
numCollBoxes 3
# 0
coll.tfr {0.400, 0.427, 1.732}
coll.tfl {-0.400, 0.427, 1.732}
coll.trr {0.400, 0.427, -1.732}
coll.trl {-0.400, 0.427, -1.732}
coll.bfr {0.400, -0.110, 1.732}
coll.bfl {-0.400, -0.110, 1.732}
coll.brr {0.400, -0.110, -1.732}
coll.brl {-0.400, -0.110, -1.732}
;wheels.pos {0.54455, 0.0251, 1.3052} yz+-0.16
# 1
coll.tfr {0.54, 0.19, 1.46}
coll.tfl {-0.54, 0.19, 1.46}
coll.trr {0.54, 0.19, 1.14}
coll.trl {-0.54, 0.19, 1.14}
coll.bfr {0.54, -0.13, 1.46}
coll.bfl {-0.54, -0.13, 1.46}
coll.brr {0.54, -0.13, 1.14}
coll.brl {-0.54, -0.13, 1.14}
# 2
coll.tfr {0.54, 0.19, -1.14}
coll.tfl {-0.54, 0.19, -1.14}
coll.trr {0.54, 0.19, -1.46}
coll.trl {-0.54, 0.19, -1.46}
coll.bfr {0.54, -0.13, -1.14}
coll.bfl {-0.54, -0.13, -1.14}
coll.brr {0.54, -0.13, -1.46}
coll.brl {-0.54, -0.13, -1.46}

;---graphics

;Model used to represent the car.
model "gcw-cooper-1.3.mdl"

;Model used to represent the car's interior.
interiorModel "null.mdl"

; driver model set to 0 for standard
; set to 1 for no model
; set to 2 for just arms!
noDriverModel 2
;Position of driver model
driverPos {0.0, -0.175, -0.05}

;Position of the steering wheel
steeringWheelPos {0.00, 0.145, 0.22}

;Angle of the steering wheel
steeringWheelAngle 20

;Number of turns, lock-to-lock.
steeringWheelTurns 2.0

steeringWheelRadius 0.135

;Model used to represent the steering wheel
steeringWheelTexture "old_steering_wheel01.pct"

;Position of left and right exhaust ends. For a car with only
;one exhaust pipe, use the same coordinates for both.
exhaust1Pos {-0.23, -0.135, -1.52}
exhaust2Pos {-0.23, -0.135, -1.52}
;Position of license plates
;for network player names
frontLicensePlatePos {0.0, -0.085, 1.72}
rearLicensePlatePos {-0.15, 0.045, -1.70}

numColors 6# 0colors {0.0, 0.5, 0.0}
# 1colors {1.0, 1.0, 1.0}
# 2colors {0.43, 0.62, 0.68}
# 3colors {0.70, 0.11, 0.19}
# 4colors {0.11, 0.16, 0.36}
# 5colors {0.0, 0.0, 0.0}

hornPitch 1.2

;--engine - 2495cc Climax FPF
power 178967.97
torque 284.8
powerRPM 6750.0
torqueRPM 5000.0
jerkRPM 300.0
idleRPM 750.0
maxRPM 7800.0
engineInertia 0.22

; new engine friction params
engineBaseFriction 18
engineRPMFriction 0.0167

;engine sound sample
engineSample "gcw-cooperclimax.wav"
hallSample "gcw-cooperclimax-hall.wav"
; multipliers for engine sound volume at idle/max RPM
zeroRPMSoundGain 1.00
fullRPMSoundGain 1.50
zeroThrottleSoundGain 0.80
fullThrottleSoundGain 1.20
; multipliers for engine sound speed at idle/max RPM
zeroRPMSoundPitch 0.1875
fullRPMSoundPitch 2.05
zeroThrottleSoundPitch 1.0
fullThrottleSoundPitch 1.0

;---suspension

;These determines the strength of the car's shock absorbers.
; I tweaked these a lot to correct the initial oversteer - Giles
supsensionFriction 875
damperStrength 30000
frontSwayBar 18200
rearSwayBar 24000

;---drivetrain

;The ratio of the final drive gear in the car's differential.
finalDriveRatio 4.2364

;The maximum amount of torque the car's clutch can transfer (in Nm).
maxClutchTorqueTransfer 900

;this factor is used to simulate limited slip differentials.
;0 means free differential. the higher the value, the more differential locking.
;values around 100 seem to get realistic limited slip differentials.
differentialLockCoefficient 140

;For automatic transmission: When to shift up and down
shiftUpRPM 7050.0
shiftDownRPM 5050.0

;Time it takes to shift gears in seconds
gearSwitchTime 0.2

;Number of gears, including reverse and neutral.
numGears 7

;The gear ratios
# 0
gearRatios -2.00
# 1
gearRatios 0
# 2
gearRatios 2.00
# 3
gearRatios 1.64
# 4
gearRatios 1.34
# 5
gearRatios 1.10
# 6
gearRatios 0.90


;---wheels

;number of wheels (theoretically you could make vehicles with numWheels!=4. This has not been tested and might cause troubles, though).
numWheels 4


# 0
wheels.pos {0.54455, 0.0500, 1.3052}
wheels.inertia 1.125
wheels.powered 0.0
wheels.friction 10
wheels.maxAngle 0.48
wheels.maxSuspension 0.05
wheels.radius 0.300
wheels.braked 5700.0
wheels.handbraked 0.0
wheels.model "gcw-cooper-wheel.mdl"
wheels.width 0.13805
wheels.texture 4
wheels.tilt -0.02
