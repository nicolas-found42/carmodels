;pimley_trabant.car
;Copyright © 2007-2008 Daniel Pimley.
;a string with the name of the carcarName "­pimley_trabant_16.txr­ Trabant 1.8T"year 1964;displacement in litresdisplacement 1.781

builtIn 1
;---aerodynamics;the car's frontal air resitance.;this equals cw*S, where cw is the coefficient of friction ;and S is the frontal area of the car in square meters.;A modern sports car might have values as low as 0.6 for thisfrontAirResistance 0.8;air resistance of the side and top areas of the car.;these values are not that important to be very exact.sideAirResistance 1.0topAirResistance 2.0;used to simulate spoilers;negative values are downforce, positive values are upforcefrontLift -0.0rearLift -0.0;---chassis;Car's mass in kg
;Audi engine and gearbox adds 185kg
mass 800;Car's momentum of inertia around the x,y and z axis.;Meassured in kg*m^2;For those not into physics that much, inertia specifies the car's;initial resistance to get rotationally accelerated around it's axis. Smaller, lighter;cars have much lower values here. A formula-1 car might have an inertia;around the y-axis af about 750 kg*m^2, whereas a big station wagon may have;4000 kg*m^2. lower values result in better cornering abilitiesinertia {1200,1000,500}

;The car's center of gravity.;This vector (as all the others that may follow) uses the following;coordinate system: X points to the right, Y points up and Z points to the front.;Coordinates are in meters.;The lower the CG, the better the cars handling.;Also, the further the CG is to the rear of the car, the more the car will tend;to oversteer in corners, making it much harder to handle. If your car uncontrollably;spins out in the rear a lot, try moving the CG further to the front.massCenter {0,0.2,0.3};An approximation of the car's borders, used for collision detection.;More than two boxes can be used, but if too many are used, performance ;may degrade. Each box is defined by 8 edges (top/front/right to bottom/rear/left).;number of collision boxesnumCollBoxes 2;a list of the collision boxes used, in this case two# 0coll.tfr {0.75,1.0,1.7}coll.tfl {-0.75,1.0,1.7}coll.trr {0.75,1.0,-1.72}coll.trl {-0.75,1.0,-1.72}coll.bfr {0.75,0,1.72}coll.bfl {-0.75,0,1.72}coll.brr {0.75,0,-1.66}coll.brl {-0.75,0,-1.66}

# 1coll.tfr {0.70,1.4,0.8}coll.tfl {-0.70,1.4,0.8}coll.trr {0.70,1.4,1.0}coll.trl {-0.70,1.4,1.0}
coll.bfr {0.70,1.0,1.0}coll.bfl {-0.70,1.0,1.0}coll.brr {0.70,1.0,1.2}coll.brl {-0.70,1.0,1.2}

;---graphics

numColors 7# 0colors {0.4,0.8,0.8}
# 1colors {0.7,0.7,0.5}
# 2colors {0.7,0.7,0.7}
# 3colors {0.7,0.6,0.3}
# 4colors {0.5,0.7,0.2}
# 5colors {0.5,0.8,0.4}
# 6colors {0.8,0.6,0.2}

;Model used to represent the car.model "pimley_trabant.mdl";Model used to represent the car's interior.interiorModel "pimley_trabant_interior.mdl";Position of driver modeldriverPos {0.31,0.45,0.05};Position of the steering wheelsteeringWheelPos {0.3,0.66,0.42};Angle of the steering wheelsteeringWheelAngle 15;Number of turns, lock-to-lock.steeringWheelTurns 4

;Model used to represent the steering wheelsteeringWheelTexture "pimley_trabant_steer.txr"
steeringWheelRadius 0.17
;Position of left and right exhaust ends. For a car with only;one exhaust pipe, use the same coordinates for both.exhaust1Pos {0.34,0.08,-1.6}
exhaust2Pos {0.34,0.08,-1.6}
;The lower this value, the more the car's exhaust will spit out banging noises and flames.;exhaustFire 100000;Position of license plates;for network player namesfrontLicensePlatePos {0,0.15,1.66}rearLicensePlatePos {0.0,0.35,-1.68};--engine;Car's maximal power in Watts.;One hp equals 745.69987 Watts.
;180bhp
power 134226

;Car's maximal torque in Nm.;One lb-ft equals 1.35628105 Nm.
torque 235
;RPM values for the power and torque ratings.powerRPM 5500.0torqueRPM 4700.0;Engines idle RPMidleRPM 800.0jerkRPM 250.0

;RPM delimtermaxRPM 6000.0;Engines Inertia in kg*m^2.;The higher this value is, the longer the engine takes to spin up.engineInertia 0.25

;currently unusedengineFriction 100
;engine sound sampleengineSample "enginemuffled.wav"hallSample "hallmuffled.wav"turboSample "turbo.wav"zeroRPMSoundGain 0.8fullRPMSoundGain 1.2zeroThrottleSoundGain 0.6fullThrottleSoundGain 1.4zeroRPMSoundPitch 0.4fullRPMSoundPitch 1.5zeroThrottleSoundPitch 0.9fullThrottleSoundPitch 1.0turboGain 0.3

;hornSample "hornnormal.wav"
;---suspension;These determines the strength of the car's shock absorbers.supsensionFriction 1000damperStrength 40000;sway Bars will cause the car to tilt less in corners. The higher these values,;the less the car will tilt to the side when corneringfrontSwayBar 5000rearSwayBar 10000;---drivetrain;The ratio of the final drive gear in the car's differential.finalDriveRatio 3.94;The maximum amount of torque the car's clutch can transfer (in Nm).maxClutchTorqueTransfer 2345;this factor is used to simulate limited slip differentials.;0 means free differential. the higher the value, the more differential locking.;values around 100 seem to get realistic limited slip differentials.differentialLockCoefficient 0;For automatic transmission: When to shift up and downshiftDownRPM 3000shiftUpRPM 5700;Time it takes to shift gears in secondsgearSwitchTime 0.25;Number of gears, including reverse and neutral.numGears 7;The gear ratios
# 0gearRatios -3.6# 1gearRatios 0# 2gearRatios 3.3
# 3gearRatios 1.94# 4gearRatios 1.31
# 5
gearRatios 1.03
# 6
gearRatios 0.75

;---wheels;number of wheels.numWheels 4;front left wheel# 0;Wheel's positionwheels.pos {-0.64,0.15,1.12};Wheel's inertia in kg*m^2.wheels.inertia 2.2

;Wheel's stickyness - higher values for more grip
wheels.stickyness 0

;Fraction of engine power lead to this wheel.wheels.powered 0.5;Friction caused by rotating the wheel in Nm.wheels.friction 10;Maximal steering angle of this wheel in radians.wheels.maxAngle 0.48;Suspension travel of this wheel in meters.wheels.maxSuspension 0.12;Wheel's radius in meters.wheels.radius 0.3;Torque of the brakes on this wheel (in Nm).wheels.braked 6000.0;How much of the braking torque is generated by pulling the handbrake (between 0 and 1).wheels.handbraked 0.0;model used to represent the wheelwheels.model "pimley_trabant_wheel_18t.mdl";width of the wheelwheels.width 0.20wheels.texture 0;front right wheel# 1wheels.pos {0.64,0.15,1.12}wheels.inertia 2.2wheels.stickyness 0
wheels.powered 0.5wheels.friction 10wheels.maxAngle 0.48wheels.maxSuspension 0.12wheels.radius 0.3wheels.braked 6000.0wheels.handbraked 0.0wheels.model "pimley_trabant_wheel_18t.mdl"wheels.width 0.20wheels.texture 0;rear left wheel# 2wheels.pos {-0.64,0.15,-0.85}wheels.inertia 2.2wheels.stickyness 0
wheels.powered 0wheels.friction 10wheels.maxAngle 0.0wheels.maxSuspension 0.12wheels.radius 0.3wheels.braked 1500.0wheels.handbraked 1.0wheels.model "pimley_trabant_wheel_18t.mdl"wheels.width 0.20wheels.texture 0;rear right wheel# 3wheels.pos {0.64,0.15,-0.85}wheels.inertia 2.2wheels.stickyness 0
wheels.powered 0wheels.friction 10wheels.maxAngle 0.0wheels.maxSuspension 0.12wheels.radius 0.3wheels.braked 1500.0wheels.handbraked 1.0wheels.model "pimley_trabant_wheel_18t.mdl"wheels.width 0.20wheels.texture 0;---lights;number of lights on the carnumLights 20

