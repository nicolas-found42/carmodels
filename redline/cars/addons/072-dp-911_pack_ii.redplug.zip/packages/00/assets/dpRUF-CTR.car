;Contact by PM through Ambrosia Web Board

builtIn 1
carName "Porsche 911 RUF CTR";engineName "3.4 F-6 Twin Turbo"year 1988displacement 3.4price 223000;---aerodynamicsfrontAirResistance 0.55sideAirResistance 1.9topAirResistance 2.7frontLift -0.00rearLift -0.5;---chassismass 1245inertia {1950,2060,460}massCenter {0.0,0.4,-0.134};massCenter {0.0,0.32,-0.085}numCollBoxes 2# 0coll.tfr {0.955,0.853,2.24}coll.tfl {-0.955,0.853,2.24}coll.trr {0.955,0.853,-2.24}coll.trl {-0.955,0.853,-2.24}coll.bfr {0.955,0.275,2.24}coll.bfl {-0.955,0.275,2.24}coll.brr {0.955,0.275,-2.24}coll.brl {-0.955,0.275,-2.24}# 1coll.tfr {0.85,1.31,0.385}coll.tfl {-0.85,1.31,0.385}coll.trr {0.85,1.31,-0.675}coll.trl {-0.85,1.31,-0.675}coll.bfr {0.955,0.853,0.828}coll.bfl {-0.955,0.853,0.828}coll.brr {0.955,0.853,-2.27}coll.brl {-0.955,0.853,-2.27};---graphicsmodel "dpRUF.mdl"interiorModel "911int.mdl"driverPos {0.35,0.5,-0.17}steeringWheelPos {0.35,0.75,0.45}steeringWheelAngle 15steeringWheelTurns 3.5steeringWheelTexture "dp-911steeringwheel.png"steeringWheelRadius 0.2

;-- Add-On options
numAddOns 1

; each add on has to be enabled by setting a bit for it here
; addOn 0 : set bit 0 == 0x01
; addOn 1 : set bit 1 == 0x02
; so I need to set 0x03
initialAddOns 0x03

; wing by thomm
# 0
addOns.hasGraphic 1
addOns.model "911RUFwing.mdl"numColors 1# 0colors {0.94,0.88,0}
;-->Tomteexhaust1Pos {0.60,0.22,-1.9}
;<--Tomte
;exhaust1Pos {0.5,0.25,-1.8};exhaust2Pos {-0.5,0.25,-1.8}
frontLicensePlatePos {0,0.3,2.2}rearLicensePlatePos {0,0.4,-2.24}hornSample "horn2.wav"hornPitch 0.2;--enginepower 349733torque 553powerRPM 5950torqueRPM 5100maxRPM 6800.0idleRPM 900.0jerkRPM 500.0engineInertia 0.17engineFriction 90engineSample "acc7000.wav"hallSample "acc7000.wav"turboSample "turbo.wav"zeroRPMSoundGain 1.0fullRPMSoundGain 1.3zeroThrottleSoundGain 0.9fullThrottleSoundGain 1.4zeroRPMSoundPitch 0.4fullRPMSoundPitch .977zeroThrottleSoundPitch 0.85fullThrottleSoundPitch 1.0turboGain 1.0;---suspensionsupsensionFriction 1300damperStrength 38000frontSwayBar 24000rearSwayBar 22500;---drivetrainfinalDriveRatio 3.33maxClutchTorqueTransfer 700differentialLockCoefficient 120shiftUpRPM 6700.0shiftDownRPM 3000.0gearSwitchTime 0.4numGears 7# 0gearRatios -2.857# 1gearRatios 0# 2
gearRatios 2.59# 3gearRatios 1.408# 4gearRatios 1.067# 5gearRatios 0.856# 6gearRatios 0.715

;---wheelsnumWheels 4# 0wheels.pos {-0.695,0.32,1.21}wheels.inertia 2.0wheels.friction 10wheels.powered 0.0wheels.maxAngle 0.46wheels.maxSuspension 0.085wheels.radius 0.323wheels.braked 8750.0wheels.handbraked 0.0wheels.model "Speedlines.mdl"wheels.width 0.215wheels.texture 1
wheels.stickyness 0.1
# 1wheels.pos {0.695,0.32,1.21}wheels.inertia 2.0wheels.friction 10wheels.powered 0.0wheels.maxAngle 0.46wheels.maxSuspension 0.085wheels.radius 0.323wheels.braked 8750.0wheels.handbraked 0.0wheels.model "Speedlines.mdl"wheels.width 0.215wheels.texture 1
