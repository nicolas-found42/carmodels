; 1.4 changed wheel friction on one rear wheel to match others. Changed peak torque RPM to match Drag Car, lowered volume of engine sound.carName "Charger Neue"builtIn 1year 1966displacement 16.619price 40000;---aerodynamicsfrontAirResistance 1.0sideAirResistance 2.0topAirResistance 3.0frontLift -0.0rearLift -0.0;---chassismass 1810.0inertia {4500,4000,450}massCenter {0.0,0.4,0.32}numCollBoxes 2# 0coll.tfr {1.003,0.768,2.78}coll.tfl {-1.003,0.768,2.78}coll.trr {1.003,0.768,-2.89}coll.trl {-1.003,0.768,-2.89}coll.bfr {1.003,0.247,2.78}coll.bfl {-1.003,0.247,2.78}coll.brr {1.003,0.247,-2.89}coll.brl {-1.003,0.247,-2.89}# 1coll.tfr {0.895,1.18,0.424}coll.tfl {-0.895,1.18,0.424}coll.trr {0.895,1.18,-0.74}coll.trl {-0.895,1.18,-0.74}coll.bfr {1.003,0.768,0.91}coll.bfl {-1.003,0.768,0.91}coll.brr {1.003,0.768,-2.5}coll.brl {-1.003,0.768,-2.5}hornPitch -0.2hornSample "horn2.wav";---graphicsmodel "br_Charge.mdl"interiorModel "br_Charge-interior.mdl"driverPos {0.5,0.6,-0.05}steeringWheelPos {0.5,0.83,0.67}steeringWheelAngle 15steeringWheelTurns 3.5steeringWheelRadius 0.225steeringWheelTexture "old_steering_wheel02.pct"
exhaust1Pos {-0.5,0.36,-2.9}exhaust2Pos {0.5,0.36,-2.9}frontLicensePlatePos {0,0.35,2.79}rearLicensePlatePos {0,0.36,-2.9}numColors 5# 0colors {0.32,0,0.64}# 1colors {0.6,1.0,0.64}# 2colors {0.5,0,0}# 3colors {0.4,0.4,0.4}# 4colors {0.8,0.8,0.8}

;--enginepower 1225000torque 1966powerRPM 8000.0torqueRPM 5000.0jerkRPM 450.0idleRPM 800.0maxRPM 8000.0engineInertia 0.2engineFriction 100;engine sound sampleengineSample "br_Charge.wav"hallSample "br_Charge.wav"zeroRPMSoundGain 1.0fullRPMSoundGain 1.4zeroThrottleSoundGain 1.0fullThrottleSoundGain 1.7zeroRPMSoundPitch 0.8fullRPMSoundPitch 1.9zeroThrottleSoundPitch 0.9fullThrottleSoundPitch 1.0

;---suspensionsupsensionFriction 1000damperStrength 35500frontSwayBar 13000rearSwayBar 30000

;---drivetrainfinalDriveRatio 4.0maxClutchTorqueTransfer 1400differentialLockCoefficient 200shiftUpRPM 8000.0shiftDownRPM 4500.0gearSwitchTime 0.12numGears 7# 0gearRatios -2.4# 1gearRatios 0# 2gearRatios 2.36# 3gearRatios 1.62# 4gearRatios 1.2# 5gearRatios 0.96# 6gearRatios 0.8;---wheels;number of wheels (theoretically you could make vehicles with numWheels!=4. This has not been tested and might cause troubles, though).numWheels 4# 0wheels.pos {-0.75,0.35,1.9}wheels.inertia 2.2wheels.powered 0.0wheels.friction 10wheels.maxAngle 0.52wheels.maxSuspension 0.12wheels.radius 0.34wheels.braked 8000.0wheels.handbraked 0.0wheels.model "wheel-slim-disc-holed.mdl"wheels.width 0.335wheels.texture 3
