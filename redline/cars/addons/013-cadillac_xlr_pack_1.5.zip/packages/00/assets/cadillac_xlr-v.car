; Car made by; 3d model by DonaemouS; car.ini by DonaemouS; shadows by slowDan; thx to GeneralAntilles for his tips;a string with the name of the carbuiltIn 1carName "­g4m_xlr_15.png­ Cadillac XLR-V";used only for career modeyear 2008displacement 4.400;---aerodynamics;the car's frontal air resitance.;this equals cw*S, where cw is the coefficient of friction ;and S is the frontal area of the car in square meters.frontAirResistance 0.695;air resistance of the side and top areas of the car.;these values are not that important to be very exact.sideAirResistance 2.5topAirResistance 2.7;used to simulate spoilersfrontLift 0.03rearLift 0.099;---chassis;Car's mass in kgmass 1728.2;Car's momentum of inertia around the x,y and z axis.;Meassured in kg*m^2;For those not into physics that much, inertia specifies the car's;initial resistance to get accelerated around it's axis. Smaller, lighter;cars have much lower values here. A formula-1 car might have an inertia;around the y-axis af about 750 kg*m^2, whereas a big station wagon may have;4000 kg*m^2.inertia {3164,3411,718};The car's center of gravity.;This vector (as all the others that may follow) uses the following;coordinate system: X points to the right, Y points up and Z points to the front.;Coordinates are in meters.massCenter { 0.0,0.105,0.10};An approximation of the car's borders, used for collision detection.;More than two boxes can be used, but if too many are used, performance ;may degrade. Each box is defined by 8 edges (top/front/right to bottom/rear/left).numCollBoxes 1# 0coll.tfr {0.918,1.27,2.28}coll.tfl {-0.918,1.27,2.28}coll.trr {0.918,1.27,-2.28}coll.trl {-0.918,1.27,-2.28}coll.bfr {0.918,0.2,2.25}coll.bfl {-0.918,0.2,2.25}coll.brr {0.918,0.2,-2.25}coll.brl {-0.918,0.2,-2.25};---graphics;Model used to represent the car.model "cadillac_xlr-v.mdl"shadowModel "cadillac_shadow_model.mdl";Model used to represent the car's interior.interiorModel "cadillac_xlr_interior.mdl";Position of driver modeldriverPos {0.36,0.32,-0.40};Position of the steering wheelsteeringWheelPos {0.36,0.54,0.25};Angle of the steering wheelsteeringWheelAngle 25;Number of turns, lock-to-lock.steeringWheelTurns 2.9steeringWheelRadius 0.15;Model used to represent the steering wheelsteeringWheelTexture "null.png";Position of left and right exhaust ends. For a car with only;one exhaust pipe, use the same coordinates for both.exhaust1Pos {0.2,0.07,-2.26}exhaust2Pos {-0.2,0.07,-2.26};Position of license plates;for network player namesfrontLicensePlatePos {0,0.245,2.30}rearLicensePlatePos {0,0.6,-2.18}numColors 4# 0colors {0.713, 0.000, 0.000}# 1colors {0.125, 0.125, 0.125}# 2colors {0.675, 0.718, 0.745}# 3colors {0.000, 0.294, 0.376};--enginepower 330000torque 561powerRPM 6400.0torqueRPM 3900.0jerkRPM 500.0idleRPM 950.0maxRPM 6500.0engineInertia 0.40engineFriction 100;engine sound sampleengineSample "cadillac_acc-320.wav"hallSample "cadillac_acc-320.wav"zeroRPMSoundGain 0.6fullRPMSoundGain 1.1zeroThrottleSoundGain 0.9fullThrottleSoundGain 1.1zeroRPMSoundPitch 0.5fullRPMSoundPitch 1.1zeroThrottleSoundPitch 1.0fullThrottleSoundPitch 1.2;---suspension;These determines the strength of the car's shock absorbers.supsensionFriction 1100damperStrength 35000frontSwayBar 12500rearSwayBar 10900;---drivetrain;The ratio of the final drive gear in the car's differential.finalDriveRatio 2.56;The maximum amount of torque the car's clutch can transfer (in Nm).maxClutchTorqueTransfer 828;this factor is used to simulate limited slip differentials.;0 means free differential. the higher the value, the more differential locking.;values around 100 seem to get realistic limited slip differentials.differentialLockCoefficient 120;For automatic transmission: When to shift up and downshiftUpRPM 6450.0shiftDownRPM 3500.0;Time it takes to shift gears in secondsgearSwitchTime 0.30;Number of gears, including reverse and neutral.numGears 8;The gear ratios# 0gearRatios -3.06# 1gearRatios 0# 2gearRatios 4.02# 3gearRatios 2.36# 4gearRatios 1.53# 5gearRatios 1.15# 6gearRatios 0.85# 7gearRatios 0.67;---wheels;number of wheels (theoretically you could make vehicles with numWheels!=4. This has not been tested and might cause troubles, though).numWheels 4# 0wheels.pos {-0.775,0.110,1.385}wheels.inertia 2.609wheels.powered 0.0wheels.friction 10wheels.maxAngle 0.48wheels.maxSuspension 0.12wheels.radius 0.347wheels.braked 6100.0wheels.handbraked 0.0wheels.model "cadillac_xlr-v_wheel.mdl"wheels.width 0.235wheels.texture 6wheels.grip 1.0wheels.stickyness 0.13wheels.loadSensitivity -0.1# 1wheels.pos {0.775,0.110,1.385}wheels.inertia 2.609wheels.powered 0.0wheels.friction 10wheels.maxAngle 0.48wheels.maxSuspension 0.12wheels.radius 0.347wheels.braked 6090.0wheels.handbraked 0.0wheels.model "cadillac_xlr-v_wheel.mdl"wheels.width 0.235wheels.texture 6wheels.grip 1.0wheels.stickyness 0.13wheels.loadSensitivity -0.1# 2wheels.pos {-0.77,0.110,-1.315}wheels.inertia 2.798wheels.powered 0.5wheels.friction 10wheels.maxAngle 0.0wheels.maxSuspension 0.12wheels.radius 0.343wheels.braked 1900.0wheels.handbraked 1.5wheels.model "cadillac_xlr-v_wheel.mdl"wheels.width 0.255wheels.texture 6wheels.grip 1.0wheels.stickyness 0.135wheels.loadSensitivity -0.2# 3wheels.pos {0.77,0.110,-1.315}wheels.inertia 2.798wheels.powered 0.5wheels.friction 10wheels.maxAngle 0.0wheels.maxSuspension 0.12wheels.radius 0.343wheels.braked 1900.0wheels.handbraked 1.5wheels.model "cadillac_xlr-v_wheel.mdl"wheels.width 0.255wheels.texture 6wheels.grip 1.0wheels.stickyness 0.135wheels.loadSensitivity -0.2;---lights-------------------------------------------------numLights 45;luci posizione posteriori# 0lights.pos {0.748,0.621,-2.029}lights.dir {0,0,-1}lights.rgb {1.0,0.05,0,0}lights.type 2lig