;Made by: RLaddict;With many thanks to the creators, and previous modders of Redline. Special thanks to beta tester TheRunneR.;Modeled off of a public domain file available in the SketchUp forums.

;modifications by bru
;specs for car found here: http://www.supercarsite.net/toyota/mr2-roadster/2003
;and here: http://www.spyderchat.com/specifications.htm
;calculation help here: http://redline.wikispaces.com/Car+Editing
;specs for 2ZZ-GE engine here: http://en.wikipedia.org/wiki/Toyota_ZZ_engine

builtIn 0carName "Toyota MR2 2ZZ-GE"year 2005displacement 1.796price 30000;---aerodynamics;the car's frontal air resitance.;this equals cw*S, where cw is the coefficient of friction ;and S is the frontal area of the car in square meters.;A modern sports car might have values as low as 0.6 for thisfrontAirResistance .6;air resistance of the side and top areas of the car.;these values are not that important to be very exact.sideAirResistance 1.0topAirResistance 1.6;used to simulate spoilers;negative values are downforce, positive values are upforcefrontLift -0.02rearLift -0.02;---chassis;Car's mass in kgmass 1010;Car's momentum of inertia around the x,y and z axis.;Meassured in kg*m^2;For those not into physics that much, inertia specifies the car's;initial resistance to get rotationally accelerated around it's axis. Smaller, lighter;cars have much lower values here. A formula-1 car might have an inertia;around the y-axis af about 750 kg*m^2, whereas a big station wagon may have;4000 kg*m^2. lower values result in better cornering abilities

;bru higher y values seem to prevent spinning, which should not be true.
inertia {1422,1552,416}
;MC lowered and moved backwards to .12
;bru moved up. currently lower than mini.massCenter {0.0,0.32,0.12};An approximation of the car's borders, used for collision detection.;More than two boxes can be used, but if too many are used, performance ;may degrade. Each box is defined by 8 edges (top/front/right to bottom/rear/left).numCollBoxes 2# 0coll.tfr {0.9,0.853,2}coll.tfl {-0.9,0.853,2}coll.trr {0.9,0.853,-1.9}coll.trl {-0.9,0.853,-1.9}coll.bfr {0.9,0.275,2}coll.bfl {-0.9,0.275,2}coll.brr {0.9,0.275,-1.9}coll.brl {-0.9,0.275,-1.9}# 1coll.tfr {0.75,1.31,0.385}coll.tfl {-0.75,1.31,0.385}coll.trr {0.75,1.31,-0.3}coll.trl {-0.75,1.31,-0.3}coll.bfr {0.755,0.853,0.828}coll.bfl {-0.755,0.853,0.828}coll.brr {0.755,0.853,-.3}coll.brl {-0.755,0.853,-.3};---graphics;Model used to represent the car.
;bru many changes - color of windshield and headlight glass, shininess and environment mapping of many surfaces, more colors.model "bru_2ZZ.mdl";Model used to represent the car's interior.;The VW bus has no interior graphics, so we just pass "null.mdl"interiorModel "null.mdl";Position of driver modeldriverPos {0.45,0.5,-0.25};colors in the selection boxes(the small ones on the right when you choose ;a car) do not correspond to the actual skinnumColors 4# 0colors {0,0,0}# 1colors {0.7,0.0,0.7}
# 2colors {0.9,0.6,0}
# 3colors {1,1,1}steeringWheelTexture "bru_mr2_wheel.pct"steeringWheelRadius 0.13;Position of the steering wheelsteeringWheelPos {0.33,0.64,0.3};Angle of the steering wheelsteeringWheelAngle 15;Number of turns, lock-to-lock.steeringWheelTurns 2.6;Model used to represent the steering wheelsteeringWheelModel "null.mdl";Position of left and right exhaust ends. For a car with only;one exhaust pipe, use the same coordinates for both.exhaust1Pos {0.45,0.4,-2.3}exhaust2Pos {-0.45,0.4,-2.3};Position of license plates;for network player namesfrontLicensePlatePos {0,0.36,1.95}rearLicensePlatePos {0,0.61,-2.1}

;--engine;Car's maximal power in Watts.;One hp equals 745.69987 Watts.power 134000;Car's maximal torque in Nm.;One lb-ft equals 1.35628105 Nm.
torque 176;RPM values for the power and torque ratings.powerRPM 7600torqueRPM 6800;Engines idle RPMidleRPM 800jerkRPM 450;RPM delimtermaxRPM 8000;Engines Inertia in kg*m^2.;The higher this value is, the longer the engine takes to spin up.engineInertia 0.10;currently unusedengineFriction 100;engine sound sampleengineSample "enginemuffled.wav"hallSample "hallmuffled.wav"zeroRPMSoundGain 0.8fullRPMSoundGain 1.0zeroThrottleSoundGain 0.3fullThrottleSoundGain 1zeroRPMSoundPitch 0.4fullRPMSoundPitch 1.5zeroThrottleSoundPitch 0.8fullThrottleSoundPitch 1.2

;---suspension

;These determines the strength of the car's shock absorbers.supsensionFriction 300;damperStrength 24000
damperStrength 30000;sway Bars will cause the car to tilt less in corners. The higher these values,;the less the car will tilt to the side when cornering
frontSwayBar 15000rearSwayBar 20000

;---drivetrain

;bru many changes - most gear ratios, downshift RPM;The ratio of the final drive gear in the car's differential.finalDriveRatio 4.53;The maximum amount of torque the car's clutch can transfer (in Nm).maxClutchTorqueTransfer 900;this factor is used to simulate limited slip differentials.;0 means free differential. the higher the value, the more differential locking.;values around 100 seem to get realistic limited slip differentials.
;added an LSD 100differentialLockCoefficient 90;For automatic transmission: When to shift up and downshiftUpRPM 7800.0shiftDownRPM 6000.0;Time it takes to shift gears in secondsgearSwitchTime 0.14;Number of gears, including reverse and neutral.numGears 8;The gear ratios# 0gearRatios -3.66# 1gearRatios 0# 2gearRatios 3.3# 3gearRatios 2.47# 4gearRatios 1.92# 5gearRatios 1.5# 6gearRatios 1.2# 7gearRatios 0.98

;---wheels;number of wheels (theoretically you could make vehicles with numWheels!=4. This has not been tested and might cause troubles, though).numWheels 4
;bru - Minor changes: inertia, radius, width. Note that track is wider in front than in back, on purpose.
;bru fatter, stickier rear tires for 2ZZ model.
;front left wheel# 0;Wheel's positionwheels.pos {-0.82,0.31,1.22}wheels.inertia 1.8wheels.powered 0.0wheels.friction 15wheels.maxAngle 0.4wheels.maxSuspension 0.18wheels.radius 0.292
;wheels.width 0.235
wheels.width 0.185
wheels.stickyness 0.0wheels.braked 4000.0wheels.handbraked 0.0wheels.model "wheel-slim-disc.mdl"wheels.texture 6;front right wheel# 1wheels.pos {0.82,0.31,1.22}wheels.inertia 1.8wheels.powered 0.0wheels.friction 15wheels.maxAngle 0.4wheels.maxSuspension 0.18wheels.radius 0.292wheels.width 0.185
wheels.stickyness 0.0wheels.braked 4000.0wheels.handbraked 0.0wheels.model "wheel-slim-disc.mdl"wheels.texture 6

;rear left wheel# 2wheels.pos {-0.805,0.31,-1.46}wheels.inertia 1.8wheels.powered 0.5wheels.friction 15wheels.maxAngle 0.0wheels.maxSuspension 0.18wheels.radius 0.318wheels.width 0.275
wheels.stickyness 0.2wheels.braked 1000.0wheels.handbraked 1.0wheels.model "wheel-slim-disc.mdl"wheels.texture 6;rear right wheel# 3wheels.pos {0.805,0.31,-1.46}wheels.inertia 1.8wheels.powered 0.5wheels.friction 15wheels.maxAngle 0.0wheels.maxSuspension 0.18wheels.radius 0.318wheels.width 0.275
wheels.stickyness 0.2wheels.braked 1000.0wheels.handbraked 1.0wheels.model "wheel-slim-disc.mdl"wheels.texture 6

;---lights

;bru many changes
numLights 27

; headlights
# 0lights.pos {0.72,0.64,1.9}lights.dir {0,0,1}lights.rgb {1,1,1}lights.type 0lights.size 0.55lights.onFlags 0x01lights.offFlags 0x00# 1lights.pos {-0.72,0.64,1.9}lights.dir {0,0,1}lights.rgb {1,1,1}lights.type 0lights.size 0.55lights.onFlags 0x01lights.offFlags 0x00

; headlight cones# 2lights.pos {0.72,0.64,1.9}lights.dir {0,-0.1,1}lights.rgb {1,0.5,0}lights.type 1lights.size 30lights.onFlags 0x01lights.offFlags 0x00# 3lights.pos {-0.72,0.64,1.9}lights.dir {0,-0.1,1}lights.rgb {1,0.5,0}lights.type 1lights.size 30lights.onFlags 0x01lights.offFlags 0x00

; rear running lights
# 4lights.pos {-0.76,0.76,-1.9}lights.dir {0,0,-1}lights.rgb {0.6,0,0}lights.type 0lights.size 0.4lights.onFlags 0x01lights.offFlags 0x00# 5lights.pos {0.76,0.76,-1.9}lights.dir {0,0,-1}lights.rgb {0.6,0,0}lights.type 0lights.size 0.4lights.onFlags 0x01lights.offFlags 0x00

