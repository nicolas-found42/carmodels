;a string with the name of the carbuiltIn 0carName "­RenRotor.png­ Hummer H1";used only for career modeyear 2006displacement 6.599
price 100000
;---aerodynamics;the car's frontal air resitance.;this equals cw*S, where cw is the coefficient of friction ;and S is the frontal area of the car in square meters.frontAirResistance 3;air resistance of the side and top areas of the car.;these values are not that important to be very exact.sideAirResistance 4.5topAirResistance 6;used to simulate spoilersfrontLift 0rearLift 0;---chassis;Car's mass in kgmass 3559.339;Car's momentum of inertia around the x,y and z axis.;Meassured in kg*m^2;For those not into physics that much, inertia specifies the car's;initial resistance to get accelerated around it's axis. Smaller, lighter;cars have much lower values here. A formula-1 car might have an inertia;around the y-axis af about 750 kg*m^2, whereas a big station wagon may have;4000 kg*m^2.inertia {7000,7000,4000};The car's center of gravity.;This vector (as all the others that may follow) uses the following;coordinate system: X points to the right, Y points up and Z points to the front.;Coordinates are in meters.massCenter {0.0,0.4,0.2};---graphics;Model used to represent the car.model "Ren_H1_Body.mdl";Model used to represent the car's interior.interiorModel "null.mdl";Position of driver modeldriverPos {0.4,0.4,0.20};Position of the steering wheelsteeringWheelPos {0.4,0.4,0.65};Angle of the steering wheelsteeringWheelAngle 35;Number of turns, lock-to-lock.steeringWheelTurns 2.0steeringWheelRadius 0.325;Model used to represent the steering wheelsteeringWheelTexture "old_steering_wheel01.pct";Position of left and right exhaust ends. For a car with only;one exhaust pipe, use the same coordinates for both.exhaust1Pos {1.16,1.7,-1.05}exhaust2Pos {1.16,1.7,-1.05}
;Position of license plates;for network player namesfrontLicensePlatePos {0,0.57,2.52}rearLicensePlatePos {0,0.39,-2.5}numColors 6# 0colors {1,1,0.7}# 1colors {0.9,0,0}# 2colors {0,0,0.6}# 3colors {0.1,0.1,0.1}# 4colors {0,0.5,0}# 5colors {0.3,0.6,0.3};--engine;note, due to the engine flaw at 3000 RPM, all rpm values have been doubled
;Car's maximal power in Watts.;One hp equals 745.69987 Watts.
power 224000.0

;Car's maximal torque in Nm.;One lb-ft equals 1.35628105 Nm.torque 705.0
powerRPM 6800.0torqueRPM 3200.0jerkRPM 800.0idleRPM 600.0maxRPM 6500.0engineInertia 0.7engineFriction 200;engine sound sampleengineSample "Ren_H1_Engine.wav"hallSample "Ren_H1_Hall.wav"zeroRPMSoundGain 0.8fullRPMSoundGain 2zeroThrottleSoundGain 1.2fullThrottleSoundGain 2.5zeroRPMSoundPitch 0.8fullRPMSoundPitch 3zeroThrottleSoundPitch 0.8fullThrottleSoundPitch 0.9

hornSample "Ren_H1_Horn.wav"
;---suspension;These determines the strength of the car's shock absorbers.supsensionFriction 300damperStrength 80000frontSwayBar 30000rearSwayBar 30000;---drivetrain;The ratio of the final drive gear in the car's differential.
;final drive ratio has been doubled because RPM values have been doubled.finalDriveRatio 6.12
;The maximum amount of torque the car's clutch can transfer (in Nm).maxClutchTorqueTransfer 3000;this factor is used to simulate limited slip differentials.;0 means free differential. the higher the value, the more differential locking.;values around 100 seem to get realistic limited slip differentials.differentialLockCoefficient 0;For automatic transmission: When to shift up and downshiftUpRPM 6400.0shiftDownRPM 3800.0;Time it takes to shift gears in secondsgearSwitchTime 0.3;Number of gears, including reverse and neutral.numGears 7;The gear ratios# 0gearRatios -4.49# 1gearRatios 0# 2gearRatios 4# 3gearRatios 2.6# 4gearRatios 1.7
# 5
gearRatios 1.3
# 6
gearRatios 1.05
;---wheels;number of wheels (theoretically you could make vehicles with numWheels!=4. This has not been tested and might cause troubles, though).numWheels 4
;wheel-slim-disc.mdl
;

# 0;Wheel's positionwheels.pos {-0.909,0.13,2}

;wheels.loadSensitivity: Tire load sensitivity modifier. 0 for default, -1 for zero load sensitivity, 1 for double load sensitivity. Load sensitivity determinies how much friction changes depending on the force pressing a wheel onto a road. It is the main reason that cars will tend to oversteer when the center of gravity is in the rear, but understeer when the cog is in the front. Set wheels.loadSensitivity to zero to disable this effect. Note that tire width also has an effect on load sensitivity (wider tires are less sensitive).
wheels.loadSensitivity -0.2

;Wheel's inertia in kg*m^2.wheels.inertia 4.2;Fraction of engine power lead to this wheel.wheels.powered 0.15;Friction caused by rotating the wheel in Nm.wheels.friction 10;Maximal steering angle of this wheel in radians.wheels.maxAngle 0.58;Suspension travel of this wheel in meters.wheels.maxSuspension 0.25;Wheel's radius in meters.wheels.radius 0.5;Torque of the brakes on this wheel (in Nm).wheels.braked 18000.0;How much of the braking torque is generated by pulling the handbrake (between 0 and 1).wheels.handbraked 0.0;model used to represent the wheelwheels.model "Ren_H1_Wheel.mdl"wheels.width 0.318wheels.texture 4# 1wheels.pos {0.909,0.13,2}
wheels.loadSensitivity -0.2wheels.inertia 4.2wheels.powered 0.15wheels.friction 10wheels.maxAngle 0.58wheels.maxSuspension 0.25wheels.radius 0.5wheels.braked 18000.0wheels.handbraked 0.0wheels.model "Ren_H1_Wheel.mdl"wheels.width 0.318wheels.texture 4# 2wheels.pos {-0.909,0.1,-1.651}
wheels.loadSensitivity -0.2wheels.inertia 4.2wheels.powered 0.35wheels.friction 10wheels.maxAngle 0.0wheels.maxSuspension 0.35wheels.radius 0.5wheels.braked 4000.0wheels.handbraked 2.0wheels.model "Ren_H1_Wheel.mdl"wheels.width 0.318wheels.texture 4# 3wheels.pos {0.909,0.1,-1.651}
wheels.loadSensitivity -0.2wheels.inertia 4.2wheels.powered 0.35wheels.friction 10wheels.maxAngle 0.0wheels.maxSuspension 0.35wheels.radius 0.5wheels.braked 4000.0wheels.handbraked 2.0wheels.model "Ren_H1_Wheel.mdl"wheels.width 0.318wheels.texture 4





;An approximation of the car's borders, used for collision detection.;More than two boxes can be used, but if too many are used, performance ;may degrade. Each box is defined by 8 edges (top/front/right to bottom/rear/left).numCollBoxes 2# 0coll.tfr {1.05,0.8,2.6}coll.tfl {-1.05,0.8,2.6}coll.trr {1.05,0.92,-2.42}coll.trl {-1.05,0.92,-2.42}coll.bfr {0.45,0.2,2.4}coll.bfl {-0.45,0.2,2.4}coll.brr {1.05,0.38,-2.42}coll.brl {-1.05,0.38,-2.42}# 1coll.tfr {1.05,1.55,1.15}coll.tfl {-1.05,1.55,1.15}coll.trr {1.05,1.55,-0.8}coll.trl {-1.05,1.55,-0.8}coll.bfr {1.05,0.05,1.4}coll.bfl {-1.05,0.05,1.4}coll.brr {1.05,0.05,-0.9}coll.brl {-1.05,0.05,-0.9}


;---lights;number of lights on the carnumLights 38# 0;the light's positionlights.pos {-0.52,0.68,2.48};direction the light is pointing tolights.dir {0,0,1};RGB color of the light;lights.rgb {0.7,0.7,1}
lights.rgb {1,1,1}
;light type: either 0 for a glowing dot, 1 for a light cone;(visible at night only) or 2 for a dot which reflects on wet streets.lights.type 2;lights size, - length of light cone, or diameter of dotlights.size 0.5;what is the light used for:;0x01: normal driving light. ;0x08: reverse gear light.;0x10: brake light;0x20: left indicator;0x40: right indicatorlights.onFlags 0x01;tell the light to turn OFF, when one of the above mentioned lights turns on.lights.offFlags 0x00# 1lights.pos {0.52,0.68,2.48}lights.dir {0,0,1};lights.rgb {0.7,0.7,1}
lights.rgb {1,1,1}lights.type 2lights.size 0.5lights.onFlags 0x01lights.offFlags 0x00
