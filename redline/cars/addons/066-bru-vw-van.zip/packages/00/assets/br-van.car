;Position of left and right exhaust ends. For a car with only;one exhaust pipe, use the same coordinates for both.exhaust1Pos {-0.45,0.4,-2.3}exhaust2Pos {0.45,0.4,-2.3}frontLicensePlatePos {0,0.42,2.3}rearLicensePlatePos {0,0.65,-2.3}

;--engine-- from Subaru Imprezza WRX STI
power 223710torque 407powerRPM 6000torqueRPM 4000maxRPM 7000.0idleRPM 900.0jerkRPM 500.0engineInertia 0.15engineFriction 100engineSample "barge.wav"hallSample "barge.wav"turboSample "turbo.wav"zeroRPMSoundGain 0.8fullRPMSoundGain 1.5zeroThrottleSoundGain 0.6fullThrottleSoundGain 1.5zeroRPMSoundPitch 0.5fullRPMSoundPitch 1.1zeroThrottleSoundPitch 0.7fullThrottleSoundPitch 0.9turboGain 0.2

;---suspension;These determines the strength of the car's shock absorbers.
supsensionFriction 300damperStrength 80000
frontSwayBar 28000rearSwayBar 18000

;---drivetrainfinalDriveRatio 4.65maxClutchTorqueTransfer 1200
differentialLockCoefficient 100shiftUpRPM 6400.0shiftDownRPM 3500.0gearSwitchTime 0.1numGears 8# 0gearRatios -3.545# 1gearRatios 0# 2gearRatios 3.63# 3gearRatios 2.37# 4gearRatios 1.8# 5gearRatios 1.32# 6gearRatios 1.16# 7gearRatios 0.98;---wheelsnumWheels 4# 0wheels.pos {-0.91,0.375,1.17}wheels.inertia 2.0wheels.powered 0.2wheels.friction 10wheels.maxAngle 0.48wheels.maxSuspension 0.2wheels.radius 0.34wheels.braked 4000.0wheels.handbraked 0.0
