;VW Vanagon with Subaru engine, also with four wheel drive.;carName "Large Barge Ultra"carName "VW/Subaru Van 4WD"year 1983displacement 2.5;---aerodynamicsfrontAirResistance 1.6sideAirResistance 2.0topAirResistance 3.0frontLift -0.1rearLift 0.0;---chassis;Car's mass in kgmass 1800inertia {4530,4536,1149}massCenter {0.0,0.7,0.2}numCollBoxes 1# 0coll.tfr {0.955,1.9,2.25}coll.tfl {-0.955,1.9,2.25}coll.trr {0.955,1.9,-2.25}coll.trl {-0.955,1.9,-2.25}coll.bfr {0.955,0.3,2.25}coll.bfl {-0.955,0.3,2.25}coll.brr {0.955,0.3,-2.25}coll.brl {-0.955,0.3,-2.25};---graphics;Model used to represent the car.model "br-van.mdl";Model used to represent the car's interior.;The VW bus has no interior graphics, so we just pass "null.mdl"interiorModel "null.mdl"driverPos {0.5,0.6,-0.05}steeringWheelPos {0.5,0.74,0.414}steeringWheelAngle 15steeringWheelTurns 3.5steeringWheelModel "null.mdl"

