;SOURCES;http://de.wikipedia.org/wiki/Opel_Manta;http://www.mantaclub.org/archive/manta_b_early_coupe.htm;http://www.opelfreunde-obertuerken.com/manta-b.html;http://www.bilforumet.no/manta-a-b/123022-forskjell-p-manta-b-gsi-gt-e-gt-j.htmlbuiltIn 0carName "Opel Manta GT/E (1979)"year 1979displacement 2.0;---aerodynamics;Top speed 187km/h (but I wouldn't drive that fast with so much rear lift ;-)frontAirResistance 0.5;I choose the side and top Cd to be 0.6, similar to the body of a truck;Cd * bottom half of body side + Cd * cockpit side area == 0.6*0.7*4.4 + 0.6*0.5*1.7sideAirResistance 2.4;0.6 * 1.65 * 4.4topAirResistance 4.4;The same lift to a Porsche 911 (chosen because it has a similar hatchback shape);AudiTT has less lift, VW Beetle has more lift. All data from mulsannescorner.com;frontLift 0.355;rearLift 0.577;Audi TTfrontLift 0.274rearLift 0.324;---chassis;Curb weight 1065kgmass 1140;calculations based on a cuboid 1.65m * 1.1m * 4.3m with center of mass offset 0.01/0.32/0.21;real world values would typically be slightly smaller because of the car's slanted angles;inertia {2083,2111,501}inertia {2038,2066,490};x value offset due to the driver (1/12 of the vehicle wet weight);y value has been guessed from studying the see-through blueprints, and watching the car tumbling;z value based on 55% front weight distribution (a guessed value)massCenter {0.007,0.45,0.21}numCollBoxes 1# 0coll.tfr {0.55,1.33,0.15}coll.tfl {-0.55,1.33,0.15}coll.trr {0.55,1.2,-0.8}coll.trl {-0.55,1.8,-0.8}coll.bfr {0.83,0.23,2.2}coll.bfl {-0.83,0.23,2.2}coll.brr {0.83,0.23,-2.2}coll.brl {-0.83,0.23,-2.2};---graphicsmodel "C14ru5-OpelMantaB.mdl"shadowModel "C14ru5-OpelMantaBShadow.mdl"interiorModel "C14ru5-OpelMantaBInterior.mdl"driverPos {0.325,0.54,-0.16}steeringWheelPos {0.325,0.8,0.42}steeringWheelAngle 25steeringWheelTurns 3steeringWheelTexture "C14ru5-OpelMantaBSteer.png"steeringWheelRadius 0.19exhaust1Pos {0.29,0.275,-2.16}exhaust2Pos {0.29,0.275,-2.13}frontLicensePlatePos {0.0,0.47,2.11}rearLicensePlatePos {0.0,0.7,-2.19}numColors 6# 0;GT/E Mandarin Redcolors {0.75,0.12,0.12}# 1;GT/E Pine Greencolors {0.2,0.3,0.15}# 2;GT/E Brilliant Ochrecolors {0.75,0.56,0.06}# 3;SR Metallic Bluecolors {0.18,0.38,0.75}# 4;SR Berlinetta Orangecolors {0.87,0.34,0.15}# 5;CC Mandarin Redcolors {1,1,1};--engine;engine type 2.0Epower 81000torque 159powerRPM 5400torqueRPM 3400jerkRPM 700idleRPM 1000maxRPM 6500engineInertia 0.2engineFriction 100engineBaseFriction 1engineRPMFriction 0.02;6500RPM 4-stroke = fundamental frequency 108Hz, dominant frequency 433HzengineSample "OpelMantaB7500RPM.wav"hallSample "OpelMantaB7500RPMHall.wav"zeroRPMSoundGain 1.0fullRPMSoundGain 2.0zeroThrottleSoundGain 0.5fullThrottleSoundGain 1.0zeroRPMSoundPitch 0.132fullRPMSoundPitch 0.86zeroThrottleSoundPitch 0.9fullThrottleSoundPitch 1.0;---suspensionsupsensionFriction 1500damperStrength 9000frontSwayBar 22000rearSwayBar 18000;---drivetrainfinalDriveRatio 3.88maxClutchTorqueTransfer 200;The GT/E supposedly had 45% locking, full locking seems to be a coefficient of 90differentialLockCoefficient 35shiftUpRPM 6500shiftDownRPM 3500gearSwitchTime 0.4numGears 6;These seem a bit too long, but they are copied from a semi-credible source# 0gearRatios -3.522# 1gearRatios 0# 2gearRatios 3.64# 3gearRatios 2.12# 4gearRatios 1.336# 5gearRatios 1.0;---wheels;185/70/13numWheels 4# 0wheels.pos {-0.69,0.375,1.3425}wheels.inertia 1.75;wheels.inertia 1.88wheels.powered 0wheels.friction 15wheels.maxAngle 0.48wheels.maxSuspension 0.16wheels.radius 0.295wheels.grip 1.0wheels.braked 1500wheels.handbraked 0.0wheels.model "C14ru5-OpelMantaBWheel.mdl"wheels.width 0.185wheels.texture 1# 1wheels.pos {0.69,0.375,1.3425}wheels.inertia 1.75;wheels.inertia 1.88wheels.powered 0wheels.friction 15wheels.maxAngle 0.48wheels.maxSuspension 0.16wheels.radius 0.295wheels.grip 1.0wheels.braked 1500wheels.handbraked 0.0wheels.model "C14ru5-OpelMantaBWheel.mdl"wheels.width 0.185wheels.texture 1# 2wheels.pos {-0.688,0.375,-1.1725}wheels.inertia 1.75;wheels.inertia 1.88wheels.powered 0.5wheels.friction 15wheels.maxAngle 0.0wheels.maxSuspension 0.16wheels.radius 0.295wheels.grip 1.0wheels.braked 600wheels.handbraked 1.0wheels.model "C14ru5-OpelMantaBWheel.mdl"wheels.width 0.185wheels.texture 1# 3wheels.pos {0.688,0.375,-1.1725}wheels.inertia 1.75wheels.powered 0.5wheels.friction 15wheels.maxAngle 0.0wheels.maxSuspension 0.16wheels.radius 0.295wheels.grip 1.0wheels.braked 600wheels.handbraked 1.0wheels.model "C14ru5-OpelMantaBWheel.mdl"wheels.width 0.185wheels.texture 1;---lightsnumLights 16;headlight cones# 0lights.pos {0.55,0.66,2.11}lights.dir {0.07,-0.19,1}lights.rgb {1,1,1}lights.type 1lights.size 30lights.onFlags 0x01lights.offFlags 0x00# 1lights.pos {-0.56,0.66,2.11}lights.dir {-0.07,-0.12,1}lights.rgb {1,1,1}lights.type 1lights.size 30lights.onFlags 0x01lights.offFlags 0x00;headlights# 2lights.pos {0.55,0.66,2.11}lights.dir {0,0,1}lights.rgb {1,1,1}lights.type 6lights.size 0.4lights.onFlags 0x01lights.offFlags 0x00# 3lights.pos {-0.56,0.66,2.11}lights.dir {0,0,1}lights.rgb {1,1,1}lights.type 6lights.size 0.4lights.onFlags 0x01lights.offFlags 0x00;brake lights# 4lights.pos {0.57,0.635,-2.14}lights.dir {0,0,-1}lights.rgb {0.7,0.05,0}lights.type 0lights.size 0.2lights.onFlags 0x10lights.offFlags 0x00# 5lights.pos {-0.56,0.635,-2.14}lights.dir {0.0,0.0,-1}lights.rgb {0.7,0.05,0}lights.type 0lights.size 0.2lights.onFlags 0x10lights.offFlags 0x00;rear lights# 6lights.pos {0.57,0.635,-2.14}lights.dir {0,0,-1.0}lights.rgb {0.7,0.05,0}lights.type 0lights.size 0.2lights.onFlags 0x01lights.offFlags 0x00# 7lights.pos {-0.56,0.635,-2.14}lights.dir {0.0,0,-1}lights.rgb {0.7,0.05,0}lights.type 0lights.size 0.2l