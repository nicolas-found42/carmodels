carName "Schtorftris"year 2006;displacement in litresdisplacement 1.9;---aerodynamics;the car's frontal air resitance.;this equals cw*S, where cw is the coefficient of friction ;and S is the frontal area of the car in square meters.;A modern sports car might have values as low as 0.6 for thisfrontAirResistance 1.9;air resistance of the side and top areas of the car.;these values are not that important to be very exact.sideAirResistance 2.0topAirResistance 3.0;used to simulate spoilers;negative values are downforce, positive values are upforcefrontLift 0.1rearLift 0.1;---chassis;Car's mass in kgmass 1950;Car's momentum of inertia around the x,y and z axis.;Meassured in kg*m^2;For those not into physics that much, inertia specifies the car's;initial resistance to get rotationally accelerated around it's axis. Smaller, lighter;cars have much lower values here. A formula-1 car might have an inertia;around the y-axis af about 750 kg*m^2, whereas a big station wagon may have;4000 kg*m^2. lower values result in better cornering abilitiesinertia {4000,3600,600};The car's center of gravity.;This vector (as all the others that may follow) uses the following;coordinate system: X points to the right, Y points up and Z points to the front.;Coordinates are in meters.;The lower the CG, the better the cars handling.;Also, the further the CG is to the rear of the car, the more the car will tend;to oversteer in corners, making it much harder to handle. If your car uncontrollably;spins out in the rear a lot, try moving the CG further to the front.massCenter {0.0,0.75,-0.4};An approximation of the car's borders, used for collision detection.;More than two boxes can be used, but if too many are used, performance ;may degrade. Each box is defined by 8 edges (top/front/right to bottom/rear/left).;number of collision boxesnumCollBoxes 1;a list of the collision boxes used, in this case only one;(the vw bus can be aproximated quite well with a single box)# 0coll.tfr {0.955,1.9,2.25}coll.tfl {-0.955,1.9,2.25}coll.trr {0.955,1.9,-2.25}coll.trl {-0.955,1.9,-2.25}coll.bfr {0.955,0.275,2.25}coll.bfl {-0.955,0.275,2.25}coll.brr {0.955,0.275,-2.25}coll.brl {-0.955,0.275,-2.25};---graphics;Model used to represent the car.model "Schtorftris.mdl";Model used to represent the car's interior.;The VW bus has no interior graphics, so we just pass "null.mdl"interiorModel "null.mdl";Position of driver modeldriverPos {0.5,0.6,-0.05};Position of the steering wheelsteeringWheelPos {0.5,0.74,0.414};Angle of the steering wheelsteeringWheelAngle 15;Number of turns, lock-to-lock.steeringWheelTurns 0.5;Model used to represent the steering wheelsteeringWheelModel "null.mdl";Position of left and right exhaust ends. For a car with only;one exhaust pipe, use the same coordinates for both.exhaust1Pos {-0.45,0.4,-2.3}exhaust2Pos {-0.45,0.4,-2.3};The lower this value, the more the car's exhaust will spit out banging noises and flames;Normally this should be off for street legal cars, but my vw bus has a broken exhaust ;-);just remove this line to turn this off.exhaustFire 120000;Position of license plates;for network player namesfrontLicensePlatePos {0,0.42,2.3}rearLicensePlatePos {0,0.65,-2.3};--engine;Car's maximal power in Watts.;One hp equals 745.69987 Watts.power 48000;Car's maximal torque in Nm.;One lb-ft equals 1.35628105 Nm.torque 140;RPM values for the power and torque ratings.powerRPM 3700.0torqueRPM 2200.0;Engines idle RPMidleRPM 800.0jerkRPM 450;RPM delimtermaxRPM 5500.0;Engines Inertia in kg*m^2.;The higher this value is, the longer the engine takes to spin up.engineInertia 0.15;currently unusedengineFriction 100;engine sound sampleengineSample "enginenormal2.wav"hallSample "hallnormal2.wav"hornSample "SchtorftrisTechno.wav"zeroRPMSoundGain 0.8fullRPMSoundGain 1.0zeroThrottleSoundGain 0.5fullThrottleSoundGain 1.1zeroRPMSoundPitch 0.4fullRPMSoundPitch 1.5zeroThrottleSoundPitch 0.9fullThrottleSoundPitch 1.0numColors 5# 0colors {1.0,0.0,1.0}SchtorftrisWin#0.pngSchtorftrisBody#0.png# 1colors {0.5,0.5,0.5}SchtorftrisWin#1.pngSchtorftrisBody#1.png# 2colors {1.0,0.0,0.0}SchtorftrisWin#2.pngSchtorftrisBody#2.png# 3colors {1.0,1.0,0.0}SchtorftrisWin#3.pngSchtorftrisBody#3.png# 4colors {0.0,0.0,1.0}SchtorftrisWin#4.pngSchtorftrisBody#4.png;---suspension;These determines the strength of the car's shock absorbers.supsensionFriction 300damperStrength 22000;sway Bars will cause the car to tilt less in corners. The higher these values,;the less the car will tilt to the side when corneringfrontSwayBar 12000rearSwayBar 0;---drivetrain;The ratio of the final drive gear in the car's differential.finalDriveRatio 4.65;The maximum amount of torque the car's clutch can transfer (in Nm).maxClutchTorqueTransfer 900;this factor is used to simulate limited slip differentials.;0 means free differential. the higher the value, the more differential locking.;values around 100 seem to get realistic limited slip differentials.differentialLockCoefficient 0;For automatic transmission: When to shift up and downshiftUpRPM 5000.0shiftDownRPM 2000.0;Time it takes to shift gears in secondsgearSwitchTime 0.4;Number of gears, including reverse and neutral.numGears 6;The gear ratios# 0gearRatios -2.66# 1gearRatios 0# 2gearRatios 2.66# 3gearRatios 1.91# 4gearRatios 1.39# 5gearRatios 1.0;---wheels;number of wheels (theoretically you could make vehicles with numWheels!=4. This has not been tested and might cause troubles, though).numWheels 4;front left wheel# 0;Wheel's positionwheels.pos {-0.61,0.375,1.45};Wheel's inertia in kg*m^2.wheels.inertia 2.2;Fraction of engine power lead to this wheel.;0, as the bus is rear-wheel drivenwheels.powered 0.5;Friction caused by rotating the wheel in Nm.wheels.friction 10;Maximal steering angle of this wheel in radians.wheels.maxAngle 0.48;Suspension travel of this wheel in meters.wheels.maxSuspension 0.25;Wheel's radius in meters.wheels.radius 0.30;Torque of the brakes on this wheel (in Nm).wheels.braked 4000.0;How much of the braking torque is generated by pulling the handbrake (between 0 and 1).wheels.handbraked 0.0;model used to represent the wheel;we didn't supply a custom model for the wheel, so i'll use one built into the game,wheels.model "wheel-classic-disc.mdl";width of the wheel;wider wheels have better grip characteristics.;you might want to use wider wheels at the rear axle if the car tends to oversteer too much.wheels.width 0.185wheels.texture 4;front right wheel# 1wheels.pos {0.61,0.375,1.45}wheels.inertia 2.2wheels.powered 0.5wheels.friction 10wheels.maxAngle 0.48wheels.maxSuspension 0.25wheels.radius 0.30wheels.braked 4000.0wheels.handbraked 0.0wheels.model "wheel-classic-disc.mdl"wheels.width 0.185wheels.texture 4;rear left wheel# 2wheels.pos {-0.61,0.375,-1.45}wheels.inertia 2.2wheels.powered 0.0wheels.friction 10wheels.maxAngle 0.0wheels.maxSuspension 0.25wheels.radius 0.30wheels.braked 1500.0wheels.handbraked 1.0wheels.model "wheel-classic.mdl"wheels.width 0.185wheels.texture 4;rear right wheel# 3wheels.pos {0.61,0.375,-1.45}wheels.inertia 2.2wheels.powered 0.0wheels.friction 10wheels.maxAngle 0.0wheels.maxSuspension 0.25wheels.radius 0.30wheels.braked 1500.0wheels.handbraked 1.0wheels.model "wheel-classic.mdl"wheels.width 0.185wheels.texture 4;---lights;number of lights on the carnumLights 12# 0;the light's positionlights.pos {-0.82,0.62,2.55};direction the light is pointing tolights.dir {0,-0.1,1};RGB color of the lightlights.rgb {1,1,1};light type: either 0 for a glowing dot, 1 for a light cone;(visible at night only) or 2 for a dot which reflects on wet streets.lights.type 1;lights size, - length of light cone, or diameter of dotlights.size 30;what is the light used for:;0x01: normal driving light. ;0x08: reverse gear light.;0x10: brake light;0x20: left indicator;0x40: right indicatorlights.onFlags 0x01;tell the light to turn OFF, when one of the above mentioned lights turns on.lights.offFlags 0x00# 1lights.pos {0.82,0.62,2.55}lights.dir {0,-0.1,1}lights.rgb {1,1,1}lights.type 1lights.size 30lights.onFlags 0x01lights.offFlags 0x00# 2lights.pos {-0.7,0.55,-2.25}lights.dir {0,0,-1}lights.rgb {0.6,0,0}lights.type 2lights.size 0.2lights.onFlags 0x01lights.offFlags 0x00# 3lights.pos {0.7,0.55,-2.25}lights.dir {0,0,-1}lights.rgb {0.6,0,0}lights.type 2lights.size 0.2lights.onFlags 0x01lights.offFlags 0x00# 4lights.pos {-0.7,0.68,2.3}lights.dir {0,0,1}lights.rgb {1,1,1}lights.type 0lights.size 0.6lights.onFlags 0x01lights.offFlags 0x00# 5lights.pos {0.7,0.68,2.3}lights.dir {0,0,1}lights.rgb {1,1,1}lights.type 0lights.size 0.6lights.onFlags 0x01lights.offFlags 0x00# 6lights.pos {-0.3,0.5,2.3}lights.dir {0,0,1}lights.rgb {1,1,1}lights.type 0lights.size 0.5lights.onFlags 0x01lights.offFlags 0x00# 7lights.pos {0.3,0.5,2.3}lights.dir {0,0,1}lights.rgb {1,1,1}lights.type 0lights.size 0.5lights.onFlags 0x01lights.offFlags 0x00# 8lights.pos {-0.6,0.55,-2.25}lights.dir {0,0,-1}lights.rgb {1,0,0}lights.type 2lights.size 0.18lights.onFlags 0x10lights.offFlags 0x00# 9lights.pos {0.6,0.55,-2.25}lights.dir {0,0,-1}lights.rgb {1,0,0}lights.type 2lights.size 0.18lights.onFlags 0x10lights.offFlags 0x00# 10lights.pos {-0.53,0.55,-2.25}lights.dir {0,0,-1}lights.rgb {0.8,0.8,0.8}lights.type 0lights.size 0.2lights.onFlags 0x08lights.offFlags 0x00# 11lights.pos {0.53,0.55,-2.25}lights.dir {0,0,-1}lights.rgb {0.8,0.8,0.8}lights.type 0lights.size 0.2lights.onFlags 0x08lights.offFlags 0x00