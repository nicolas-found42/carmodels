builtIn 1carName "Mercedes SL300 v1.0"year 1968displacement 3frontAirResistance 0.5sideAirResistance 2.topAirResistance 3.0frontLift -0.3rearLift -0.3mass 1093.0;4000 kg*m^2.inertia {900,1900,500}massCenter {0.0,0.05,0.5};An approximation of the car's borders, used for collision detection.;More than two boxes can be used, but if too many are used, performance ;may degrade. Each box is defined by 8 edges (top/front/right to bottom/rear/left).numCollBoxes 1# 0coll.tfr {0.5,0.65,-0.2}
coll.tfl {-0.5,0.65,-0.2}coll.trr {0.5,0.65,-1.1}coll.trl {-0.5,0.65,-1.1}coll.bfr {0.83,-0.12,2.1}coll.bfl {-0.83,-0.12,2.1}coll.brr {0.83,-0.12,-2.1}coll.brl {-0.83,-0.12,-2.1};---graphics;Model used to represent the car.model "Fuglz_SL300body.mdl";Model used to represent the car's interior.interiorModel "Fuglz_SL300interior.mdl";Position of driver modeldriverPos {0.30,0.0,-0.5};Position of the steering wheelsteeringWheelPos {0.26,0.2,-0.08};Angle of the steering wheelsteeringWheelAngle 35;Number of turns, lock-to-lock.steeringWheelTurns 5.2steeringWheelRadius 0.2;Model used to represent the steering wheelsteeringWheelTexture "old_steering_wheel01.pct";Position of left and right exhaust ends. For a car with only;one exhaust pipe, use the same coordinates for both.exhaust1Pos {0.45,-0.2,-2.4}exhaust2Pos {0.45,-0.2,-2.4};Position of license plates;for network player namesfrontLicensePlatePos {0,0,0}rearLicensePlatePos {0,0.05,-2.4}numColors 4# 0colors {0.7,0.7,0.7}
# 1colors {0.0,0.0,0.0}
# 2colors {0.0,0.0,0.3}
# 3colors {0.4,0.0,0.0};--enginepower 160000torque 250powerRPM 6200torqueRPM 3800maxRPM 6800.0idleRPM 800.0jerkRPM 800.0engineInertia 0.2engineFriction 100;engine sound sampleengineSample "enginenormal.wav"hallSample "hallnormal.wav"zeroRPMSoundGain 0.8fullRPMSoundGain 1.0zeroThrottleSoundGain 0.5fullThrottleSoundGain 1.1zeroRPMSoundPitch 0.4fullRPMSoundPitch 1.5zeroThrottleSoundPitch 0.9fullThrottleSoundPitch 1.0;---suspension;These determines the strength of the car's shock absorbers.supsensionFriction 1500damperStrength 70000frontSwayBar 15000rearSwayBar 20000;---drivetrain;The ratio of the final drive gear in the car's differential.finalDriveRatio 3.21;The maximum amount of torque the car's clutch can transfer (in Nm).maxClutchTorqueTransfer 800;this factor is used to simulate limited slip differentials.;0 means free differential. the higher the value, the more differential locking.;values around 100 seem to get realistic limited slip differentials.differentialLockCoefficient 0;For automatic transmission: When to shift up and downshiftUpRPM 5500.0shiftDownRPM 3500.0;Time it takes to shift gears in secondsgearSwitchTime 0.2;Number of gears, including reverse and neutral.numGears 6;The gear ratios# 0gearRatios -2.66# 1gearRatios 0# 2gearRatios 3.4# 3gearRatios 2.2# 4gearRatios 1.5
# 5gearRatios 1.1;---wheels;number of wheels (theoretically you could make vehicles with numWheels!=4. This has not been tested and might cause troubles, though).numWheels 4# 0wheels.pos {-0.735,0,1.2}wheels.inertia 2.2wheels.powered 0.0wheels.friction 10
wheels.maxAngle 0.36wheels.maxSuspension 0.1wheels.radius 0.3wheels.braked 5000.0wheels.handbraked 0.0wheels.model "wheel-classic-disc.mdl"wheels.width 0.2wheels.texture 2# 1wheels.pos {0.735,0,1.2}wheels.inertia 2.2wheels.powered 0.0wheels.friction 10wheels.maxAngle 0.36wheels.maxSuspension 0.1wheels.radius 0.3
wheels.braked 5000.0wheels.handbraked 0.0wheels.model "wheel-classic-disc.mdl"wheels.width 0.2wheels.texture 2# 2wheels.pos {-0.735,0,-1.45}wheels.inertia 2.2wheels.powered 0.46wheels.friction 10wheels.maxAngle 0
wheels.maxSuspension 0.1wheels.radius 0.3
wheels.braked 1000.0
wheels.handbraked 1.0wheels.model "wheel-classic.mdl"wheels.width 0.2wheels.texture 2# 3wheels.pos {0.735,0,-1.45}wheels.inertia 2.2wheels.powered 0.46wheels.friction 10wheels.maxAngle 0wheels.maxSuspension 0.1wheels.radius 0.3
wheels.braked 1000.0wheels.handbraked 1.0wheels.model "wheel-classic.mdl"wheels.width 0.2wheels.texture 2

;---lights;number of lights on the carnumLights 8# 0;the light's positionlights.pos {-0.82,0.62,2.55};direction the light is pointing tolights.dir {0,-0.1,1};RGB color of the lightlights.rgb {1,1,1};light type: either 0 for a glowing dot, 1 for a light cone;(visible at night only) or 2 for a dot which reflects on wet streets.lights.type 1;lights size, - length of light cone, or diameter of dotlights.size 30;what is the light used for:;0x01: normal driving light. ;0x08: reverse gear light.;0x10: brake light;0x20: left indicator;0x40: right indicatorlights.onFlags 0x01;tell the light to turn OFF, when one of the above mentioned lights turns on.lights.offFlags 0x00# 1lights.pos {0.82,0.62,2.55}lights.dir {0,-0.1,1}lights.rgb {1,1,1}lights.type 1lights.size 30lights.onFlags 0x01lights.offFlags 0x00

