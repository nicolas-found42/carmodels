; Car made by; DonaemouS 3d model conversionbuiltIn 1carName "ALFA 147 1.9 JTD Q2"year 2004displacement 1910;---aerodynamics;the car's frontal air resitance.;this equals cw*S, where cw is the coefficient of friction ;and S is the frontal area of the car in square meters.frontAirResistance 0.45;air resistance of the side and top areas of the car.;these values are not that important to be very exact.sideAirResistance 1.2topAirResistance 1.8;used to simulate spoilersfrontLift 0rearLift 0;---chassis;Car's mass in kgmass 1290.0;Car's momentum of inertia around the x,y and z axis.;Meassured in kg*m^2;For those not into physics that much, inertia specifies the car's;initial resistance to get accelerated around it's axis. Smaller, lighter;cars have much lower values here. A formula-1 car might have an inertia;around the y-axis af about 750 kg*m^2, whereas a big station wagon may have;4000 kg*m^2.inertia {1760,1520,335};The car's center of gravity.;This vector (as all the others that may follow) uses the following;coordinate system: X points to the right, Y points up and Z points to the front.;Coordinates are in meters.massCenter { 0.0,0.20,0.15};An approximation of the car's borders, used for collision detection.;More than two boxes can be used, but if too many are used, performance ;may degrade. Each box is defined by 8 edges (top/front/right to bottom/rear/left).numCollBoxes 1# 0coll.tfr {0.73,0.95,1.95}coll.tfl {-0.73,0.95,1.95}coll.trr {0.73,0.95,-1.95}coll.trl {-0.73,0.95,-1.95}coll.bfr {0.73,0.2,1.95}coll.bfl {-0.73,0.2,1.95}coll.brr {0.73,0.2,-1.95}coll.brl {-0.73,0.2,-1.95};---graphics;Model used to represent the car.model "alfa147ts.mdl";Model used to represent the car's interior.;interiorModel "alfa147tsint.mdl"interiorModel "null.mdl";Position of driver modeldriverPos {0.31,0.35,-0.17};Position of the steering wheelsteeringWheelPos {0.31,0.55,0.20};Angle of the steering wheelsteeringWheelAngle 35;Number of turns, lock-to-lock.steeringWheelTurns 2.5steeringWheelRadius 0.15;Model used to represent the steering wheelsteeringWheelTexture "null.png";Position of left and right exhaust ends. For a car with only;one exhaust pipe, use the same coordinates for both.exhaust1Pos {0.5,0.1,-2.0};Position of license plates;for network player namesfrontLicensePlatePos {0.25, 0.23, 1.98}rearLicensePlatePos {0, 0.25, -1.96}numColors 7# 0colors {0.662, 0.000, 0.121}# 1colors {0.007, 0.007, 0.007}# 2colors {0.164, 0.160, 0.152}# 3colors {0.000, 0.247, 0.498}# 4colors {0.498, 0.509, 0.529}# 5colors {0.811, 0.811, 0.811}# 6colors {0.054, 0.039, 0.047};--enginepower 110000torque 305powerRPM 4000.0torqueRPM 2000.0jerkRPM 450.0idleRPM 600.0maxRPM 4500.0engineInertia 0.2engineFriction 100;engine sound sampleengineSample "147engine.wav"hallSample "147engine.wav"zeroRPMSoundGain 1.5fullRPMSoundGain 1.9zeroThrottleSoundGain 1.5fullThrottleSoundGain 2.0zeroRPMSoundPitch 0.8fullRPMSoundPitch 1.3zeroThrottleSoundPitch 0.9fullThrottleSoundPitch 1.3;---suspension;These determines the strength of the car's shock absorbers.supsensionFriction 1800damperStrength 30000frontSwayBar 12000;---drivetrain;The ratio of the final drive gear in the car's differential.finalDriveRatio 3.209;The maximum amount of torque the car's clutch can transfer (in Nm).maxClutchTorqueTransfer 305;this factor is used to simulate limited slip differentials.;0 means free differential. the higher the value, the more differential locking.;values around 100 seem to get realistic limited slip differentials.differentialLockCoefficient 160;For automatic transmission: When to shift up and downshiftUpRPM 4000.0shiftDownRPM 1100.0;Time it takes to shift gears in secondsgearSwitchTime 0.15;Number of gears, including reverse and neutral.numGears 7;The gear ratios# 0gearRatios -3.209# 1gearRatios 0# 2gearRatios 2.97# 3gearRatios 1.89# 4gearRatios 1.40# 5gearRatios 1.04# 6gearRatios 0.82;---wheels;number of wheels (theoretically you could make vehicles with numWheels!=4. This has not been tested and might cause troubles, though).numWheels 4# 0;Wheel's positionwheels.pos {-0.70, 0.110, 1.11};Wheel's inertia in kg*m^2.wheels.inertia 2.2;Fraction of engine power lead to this wheel.wheels.powered 0.5;Friction caused by rotating the wheel in Nm.wheels.friction 15;Maximal steering angle of this wheel in radians.wheels.maxAngle 0.48;Suspension travel of this wheel in meters.wheels.maxSuspension 0.15;Wheel's radius in meters.wheels.radius 0.31;Torque of the brakes on this wheel (in Nm).wheels.braked 4000.0;How much of the braking torque is generated by pulling the handbrake (between 0 and 1).wheels.handbraked 0.0;model used to represent the wheelwheels.model "wheel-classic.mdl"wheels.width 0.21wheels.texture 6wheels.grip 1.0wheels.stickyness 0# 1wheels.pos {0.70,0.110,1.11}wheels.inertia 2.2wheels.powered 0.5wheels.friction 15wheels.maxAngle 0.48wheels.maxSuspension 0.15wheels.radius 0.31wheels.braked 4000.0wheels.handbraked 0.0wheels.model "wheel-classic.mdl"wheels.width 0.21wheels.texture 6wheels.grip 1.0wheels.stickyness 0# 2wheels.pos {-0.70,0.110,-1.28}wheels.inertia 2.2wheels.powered 0.0wheels.friction 15wheels.maxAngle 0.0wheels.maxSuspension 0.15wheels.radius 0.31wheels.braked 1500.0wheels.handbraked 1wheels.model "wheel-classic.mdl"wheels.width 0.21wheels.texture 6wheels.grip 1.0wheels.stickyness 0# 3wheels.pos {0.70,0.110,-1.28}wheels.inertia 2.2wheels.powered 0.0wheels.friction 15wheels.maxAngle 0.0wheels.maxSuspension 0.15wheels.radius 0.31wheels.braked 1500.0wheels.handbraked 1wheels.model "wheel-classic.mdl"wheels.width 0.21wheels.texture 6wheels.grip 1.0wheels.stickyness 0;---lights-------------------------------------------------numLights 16;Brake Lights# 0lights.pos {0.60,0.58,-1.81}lights.dir {0,0,-1}lights.rgb {1.0,0.05,0,0}lights.type 2lights.size 0.2lights.onFlags 0x10lights.offFlags 0x00# 1lights.pos {-0.60,0.58,-1.81}lights.dir {0,0,-1}lights.rgb {1.0,0.05,0,0}lights.type 2lights.size 0.2lights.onFlags 0x10lights.offFlags 0x00;Reverse Lights# 2lights.pos {-0.40,0.54,-1.84}lights.dir {0,0,-1}lights.rgb {1,1,1}lights.type 2lights.size 0.16lights.onFlags 0x08lights.offFlags 0x00;Tail Lights# 3lights.pos {0.65,0.58,-1.80}lights.dir {0,0,-1}lights.rgb {0.3,0,0}lights.type 2lights.size 0.2lights.onFlags 0x01# 4lights.pos {-0.65,0.58,-1.80}lights.dir {0,0,-1}lights.rgb {0.3,0,0}lights.type 2lights.size 0.2lights.onFlags 0x01;front lights# 5lights.pos {0.7,0.0,1.95}lights.dir {0.1,-0.1,1}lights.rgb {0.49,0.49,0.78}lights.type 1 ;headlight conelights.size 30lights.onFlags 0x01lights.offFlags 0x00# 6lights.pos {-0.7,0.0,1.95}lights.dir {-0.1,-0.1,1}lights.rgb {0.49,0.49,0.78}lights.type 1 ;headlight conelights.size 30lights.onFlags 0x01lights.offFlags 0x00# 7lights.pos {0.62,0.33,1.70}lights.dir {0,0,1}lights.rgb {0.79,0.79,0.98}lights.type 2 ;headlight dotlights.size 0.25lights.onFlags 0x01lights.offFlags 0x00# 8lights.pos {-0.62,0.33,1.70}lights.dir {0,0,1}lights.rgb {0.79,0.79,0.98}lights.type 2 ;headlight dotlights.size 0.25lights.onFlags 0x01lights.offFlags 0x00# 9lights.pos {0.40,0.30,1.75}lights.dir {0,0,1}lights.rgb {1,0.66,0}lights.type 2 ;freccialights.size 0.15lights.onFlags 0x01lights.offFlags 0x00# 10lights.pos {-0.40,0.30,1.75}lights.dir {0,0,1}lights.rgb {1,0.66,0}lights.type 2 ;freccialights.size 0.15lights.onFlags 0x01lights.offFlags 0x00# 11lights.pos {0.60,0.06,1.70}lights.dir {0,0,1}lights.rgb {0.79,0.79,0.98}lights.type 2 ;foglightlights.size 0.20lights.onFlags 0x01lights.offFlags 0x00# 12lights.pos {-0.60,0.06,1.70}lights.dir {0,0,1}lights.rgb {0.79,0.79,0.98}lights.type 2 ;foglightlights.size 0.20ligh