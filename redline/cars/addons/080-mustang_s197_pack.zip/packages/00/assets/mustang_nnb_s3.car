carName "­mustang_nnb_ver.png­Mustang GT - Roush Stage 3"year 2008displacement 4.6price 52000builtIn 1;---aerodynamics;the car's frontal air resitance.;this equals cw*S, where cw is the coefficient of friction ;and S is the frontal area of the car in square meters.frontAirResistance 0.8;air resistance of the side and top areas of the car.;these values are not that important to be very exact.sideAirResistance 2.13topAirResistance 3.74;used to simulate spoilersfrontLift -0.12rearLift -0.2;---chassis;Car's mass in kg;mass 1627mass 1727;Car's momentum of inertia around the x,y and z axis.;Meassured in kg*m^2;For those not into physics that much, inertia specifies the car's;initial resistance to get accelerated around it's axis. Smaller, lighter;cars have much lower values here. A formula-1 car might have an inertia;around the y-axis af about 750 kg*m^2, whereas a big station wagon may have;4000 kg*m^2.inertia {3813, 3684, 1430};The car's center of gravity.;This vector (as all the others that may follow) uses the following;coordinate system: X points to the right, Y points up and Z points to the front.;Coordinates are in meters.massCenter {0.0, 0.50, 0.152};An approximation of the car's borders, used for collision detection.;More than two boxes can be used, but if too many are used, performance ;may degrade. Each box is defined by 8 edges (top/front/right to bottom/rear/left).numCollBoxes 2# 0coll.tfr { 0.931, 0.89,  2.30}coll.tfl {-0.931, 0.89,  2.30}coll.trr { 0.931, 0.89, -2.37}coll.trl {-0.931, 0.89, -2.37}coll.bfr { 0.931, 0.15,  2.38}coll.bfl {-0.931, 0.15,  2.38}coll.brr { 0.931, 0.15, -2.37}coll.brl {-0.931, 0.15, -2.37}# 1coll.tfr { 0.64, 1.29, 0.16}coll.tfl {-0.64, 1.29, 0.16}coll.trr { 0.64, 1.29, -0.929}coll.trl {-0.64, 1.29, -0.929}coll.bfr { 0.79,0.89, -0.94}coll.bfl {-0.79,0.89, -0.94}coll.brr { 0.79,0.89, -1.81}coll.brl {-0.79,0.89, -1.81};---graphics;Model used to represent the car.model "mustang_nnb_s3_body.mdl"shadowModel "mustang_nnb_s3_shd.mdl";Model used to represent the car's interior.interiorModel "mustang_nnb_s3_inside.mdl";Position of driver modeldriverPos {0.4,0.60,-0.26};Position of the steering wheelsteeringWheelPos {0.388,0.78,0.3};Angle of the steering wheelsteeringWheelAngle 24;Number of turns, lock-to-lock.steeringWheelTurns 3.5steeringWheelRadius 0.2;Model used to represent the steering wheelsteeringWheelTexture "Racing_steering_wheel.pct";Position of left and right exhaust ends. For a car with only;one exhaust pipe, use the same coordinates for both.exhaust1Pos {-0.58,0.28,-2.22}exhaust2Pos {0.58,0.28,-2.22};Position of license plates;for network player namesfrontLicensePlatePos {0,0.45,2.39}rearLicensePlatePos {0,0.49,-2.34}hornSample "horn2.wav"numColors 6# 0colors {0.4,0.4,0.4}# 1colors {0.1,0.1,0.1}# 2colors {0.8,0.0,0.0}
# 3
colors {0.6,0.7,0.6}
# 4
colors {1.0,1.0,1.0}
# 5
colors {0.9,0.9,0.0};--engine;Car's maximal power in Watts.;One hp equals 745.69987 Watts.power 320651;Car's maximal torque in Nm.;One lb-ft equals 1.35628105 Nm.torque 542;RPM values for the power and torque ratings.powerRPM 5900torqueRPM 4500;RPM for engine stall, currently unusedjerkRPM 500.0;Engines idle RPMidleRPM 1100;RPM delimtermaxRPM 6250;Engines Inertia in kg*m^2.;The higher this value is, the longer the engine takes to spin up.engineInertia 0.25engineBaseFriction 43engineRPMFriction 0.044;engine sound sampleengineSample "mustang_nnb_ford.wav"hallSample "mustang_nnb_ford_hall.wav"turboSample "turbo.wav"zeroRPMSoundGain 1.1fullRPMSoundGain 1.26zeroThrottleSoundGain 0.3fullThrottleSoundGain 1.0zeroRPMSoundPitch 0.1fullRPMSoundPitch 0.8928zeroThrottleSoundPitch 1.1fullThrottleSoundPitch 1.0turboGain 0.2;---suspension;These determines the strength of the car's shock absorbers.supsensionFriction 1100damperStrength 40000frontSwayBar 12000rearSwayBar 28000;---drivetrain;The ratio of the final drive gear in the car's differential.finalDriveRatio 3.55;The maximum amount of torque the car's clutch can transfer (in Nm).maxClutchTorqueTransfer 1200;this factor is used to simulate limited slip differentials.;0 means free differential. the higher the value, the more differential locking.;values around 100 seem to get realistic limited slip differentials.;differentialLockCoefficient 115differentialLockCoefficient 100;For automatic transmission: When to shift up and downshiftUpRPM 6000shiftDownRPM 3000.0;Time it takes to shift gears in secondsgearSwitchTime 0.30;Number of gears, including reverse and neutral.numGears 7;The gear ratios# 0gearRatios -3.0# 1gearRatios 0# 2gearRatios 3.34# 3gearRatios 2.00# 4gearRatios 1.32# 5gearRatios 1.00# 6gearRatios 0.67;---wheelsnumWheels 4# 0;P275/40R18wheels.pos {-0.786,0.362,1.444}wheels.inertia 3.00wheels.powered 0.0wheels.friction 10wheels.maxAngle 0.56wheels.maxSuspension 0.08wheels.radius 0.33858wheels.braked 8800wheels.handbraked 0.0wheels.model "mustang_nnb_gt500_wheel.mdl"wheels.customBrakeModel "mustang_nnb_cala.mdl"wheels.width 0.275wheels.stickyness 0.1wheels.loadSensitivity -0.01# 1;P275/40R18wheels.pos {0.786,0.362,1.444}wheels.inertia 3.00wheels.powered 0.0wheels.friction 10wheels.maxAngle 0.56wheels.maxSuspension 0.08wheels.radius 0.33858wheels.braked 8800wheels.handbraked 0.0wheels.model "mustang_nnb_gt500_wheel.mdl"wheels.customBrakeModel "mustang_nnb_cala.mdl"wheels.width 0.275wheels.stickyness 0.1wheels.loadSensitivity -0.01# 2;P275/40R18wheels.pos {-0.794,0.362,-1.276}wheels.inertia 3.00wheels.powered 0.5wheels.friction 10wheels.maxAngle 0.0wheels.maxSuspension 0.1wheels.radius 0.33858wheels.braked 2100wheels.handbraked 1.0wheels.model "mustang_nnb_gt500_wheel.mdl"wheels.customBrakeModel "mustang_nnb_calb.mdl"wheels.width 0.275wheels.stickyness 0.1wheels.loadSensitivity -0.01# 3;P275/40R18wheels.pos {0.794,0.362,-1.276}wheels.inertia 3.00wheels.powered 0.5wheels.friction 10wheels.maxAngle 0.0wheels.maxSuspension 0.1wheels.radius 0.33858wheels.braked 2100wheels.handbraked 1.0wheels.model "mustang_nnb_gt500_wheel.mdl"wheels.customBrakeModel "mustang_nnb_calb.mdl"wheels.width 0.275wheels.stickyness 0.1wheels.loadSensitivity -0.01;---lights;number of lights on the carnumLights 34;the light's position;>> lights.pos {-0.52, 0.25, 0.86};direction the light is pointing to;>> lights.dir {0.0, -0.1, 1.0};RGB color of the light;>> lights.rgb {1, 1, 1};lights.type; 0 = glowing RED dot; 1 = light cone; 2 = reflected red dot (apparently); 3 = white sphere (visible 360 degrees); 4 = white sphere (visible 360 degrees); 5 = nothing; 6 = white sphere (for headlights);lights size, - length of light cone, or diameter of dot;what is the light used for:;0x01: normal driving light. ;0x02: not used;0x04: not used ;0x08: reverse gear light.;0x10: brake light;0x40: right indicator;0x20: leftt indicator;0x80: horn;>> lights.onFlags 0x01;tell the light to turn OFF, when one of the above mentioned lights turns on.;>> lights.offFlags 0x00;headlights# 0lights.pos {0.713,0.638,2.0}lights.dir {0,-0.1,1}lights.rgb {1,1,1}lights.type 1lights.size 25lights.onFlags 0x01lights.offFlags 0x00# 1lights.pos {-0.713,0.638,2.0}lights.dir {0,-0.1,1}lights.rgb {1,1,1}lights.type 1lights.size 25lights.onFlags 0x01lights.offFlags 0x00# 2lights.pos {0.713,0.638,2.01}lights.dir {0,-0.1,1}lights.rgb {1,1,1}lights.type 6lights.size 0.2lights.onFlags 0x01lights.offFlags 0x00# 3lights.pos {-0.713,0.638,2.01}lights.dir {0,-0.1,1}lights.rgb {1,1,1}lights.type 6lights.size 0.2lights.onFlags 0x01lights.offFlags 0x00# 4lights.pos {0.713,0.638,2.01}lights.dir {0,-0.1,1}lights.rgb {1,1,1}lights.type 6lights.size 0.3lights.onFlags 0x80lights.offFlags 0x00# 5lights.pos {-0.713,0.638,2.01}lights.dir {0,-0.1,1}lights.rgb {1,1,1}lights.type 6lights.size 0.3lights.onFlags 0x80lights.offFlags 0x00;lower fog lights# 6lights.pos {0.677,0.288,2.1}lights.dir {0,-0.1,1}lights.rgb {1,1,1}lights.type 6lights.size 0.15lights.onFlags 0x01lights.offFlags 0x00# 7lights.pos {-0.677,0.288,2.1}lights.dir {0,-0.1,1}lights.rgb {1,1,1}lights.type 6lights.size 0.15lights.onFlags 0x01lights.offFlags 0x00;side indicators# 8lights.pos {0.783,0.445,2.05}lights.dir {1,0,1}lights.rgb {1,0.5,0}lights.type 6lights.size 0.1lights.onFlags 0x40lights.offFlags 0x00# 9lights.pos {-0.783,0.445,2.05}lights.dir {-1,0,1}lights.rgb {1,0.5,0}lights.type 6lights.size 0.1lights.onFlags 0x20lights.offFlags 0x00# 10lights.pos {0.737,0.445,2.12}lights.dir {0,0,1}lights.rgb {1,0.5,0}lights.type 6lights.size 0.1lights.onFlags 0x40lights.offFlags 0x00# 11lights.pos {-0.737,0.445,2.12}lights.dir {-0,0,1}lights.rgb {1,0.5,0}lights.type 6lights.size 0