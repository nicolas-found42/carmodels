;This file includes comments for all the paramerters.;If you still don't understand a parameter, just leave it unchangend.;a string with the name of the carbuiltIn 1carName "­RenRotor.png.txr­ Golf Cart";used only for career modeyear 1995displacement 1price 2000;---aerodynamics;the car's frontal air resitance.;this equals cw*S, where cw is the coefficient of friction ;and S is the frontal area of the car in square meters.frontAirResistance 0.2;air resistance of the side and top areas of the car.;these values are not that important to be very exact.sideAirResistance 0.15topAirResistance 0.2;used to simulate spoilersfrontLift -0.0rearLift -0.00;---chassis;Car's mass in kgmass 272;Car's momentum of inertia around the x,y and z axis.;Meassured in kg*m^2;For those not into physics that much, inertia specifies the car's;initial resistance to get accelerated around it's axis. Smaller, lighter;cars have much lower values here. A formula-1 car might have an inertia;around the y-axis af about 750 kg*m^2, whereas a big station wagon may have;4000 kg*m^2.inertia {200,300,200};The car's center of gravity.;This vector (as all the others that may follow) uses the following;coordinate system: X points to the right, Y points up and Z points to the front.;Coordinates are in meters.massCenter {0.0,-0.00,-0.2};---graphics;Model used to represent the car.model "Ren_GolfCart_Body.mdl";Model used to represent the car's interior.interiorModel "null.mdl";Position of driver modeldriverPos {0.245,0.44,-0.2};Position of the steering wheelsteeringWheelPos {0.245,0.675,0.35};Angle of the steering wheelsteeringWheelAngle 35;Number of turns, lock-to-lock.steeringWheelTurns 2steeringWheelRadius 0.15;Model used to represent the steering wheelsteeringWheelTexture "Racing_steering_wheel.pct";Position of left and right exhaust ends. For a car with only;one exhaust pipe, use the same coordinates for both.exhaust1Pos {-0.2,0,-0.5}exhaust2Pos {0.2,0,-0.5};Position of license plates;for network player namesfrontLicensePlatePos {0,0.25,1.1}rearLicensePlatePos {0,0.7,-0.5}numColors 4# 0colors {0.9,0.9,0.9}# 1colors {0,0,0.7}# 2colors {0.7,0,0}# 3colors {0.6,0.0,0.8};--engine;Car's maximal power in Watts.;One hp equals 745.69987 Watts.power 22000;Car's maximal torque in Nm.;One lb-ft equals 1.35628105 Nm.torque 68;RPM values for the power and torque ratings.powerRPM 9000.0torqueRPM 1500.0;RPM for engine stall, currently unusedjerkRPM 150.0;Engines idle RPMidleRPM 200.0;RPM delimtermaxRPM 9900.0;Engines Inertia in kg*m^2.;The higher this value is, the longer the engine takes to spin up.engineInertia 0.05;currently unusedengineFriction 2;engine sound sampleengineSample "Ren_GolfCart_Engine.wav"hallSample "Ren_GolfCart_Hall.wav"zeroRPMSoundGain 0.6fullRPMSoundGain 1.2zeroThrottleSoundGain 0.5fullThrottleSoundGain 1.5zeroRPMSoundPitch 0.1fullRPMSoundPitch 0.4zeroThrottleSoundPitch 0.8fullThrottleSoundPitch 1.0

hornSample "Ren_GolfCart_Horn.wav"
;---suspensionsuspensionType 6;These determines the strength of the car's shock absorbers.supsensionFriction 300damperStrength 4000frontSwayBar 20000rearSwayBar 5000;---drivetrain;The ratio of the final drive gear in the car's differential.finalDriveRatio 5;The maximum amount of torque the car's clutch can transfer (in Nm).maxClutchTorqueTransfer 3000;this factor is used to simulate limited slip differentials.;0 means free differential. the higher the value, the more differential locking.;values around 100 seem to get realistic limited slip differentials.differentialLockCoefficient 0;For automatic transmission: When to shift up and downshiftUpRPM 9800.0shiftDownRPM 100.0;Time it takes to shift gears in secondsgearSwitchTime 0.2;Number of gears, including reverse and neutral.numGears 3;The gear ratios# 0gearRatios -2.66# 1gearRatios 0# 2gearRatios 1;---wheels;number of wheels (theoretically you could make vehicles with numWheels!=4. This has not been tested and might cause troubles, though).numWheels 4# 0;Wheel's positionwheels.pos {-0.43,0,0.93}

;wheels.stickyness: Tire friction modifier. 0 for default, -1 for zero friction, 1 for double friction.
wheels.stickyness 0;Wheel's inertia in kg*m^2.wheels.inertia 1;Fraction of engine power lead to this wheel.wheels.powered 0.0;Friction caused by rotating the wheel in Nm.wheels.friction 3;Maximal steering angle of this wheel in radians.wheels.maxAngle 0.48;Suspension travel of this wheel in meters.wheels.maxSuspension 0.1;Wheel's radius in meters.wheels.radius 0.2;Torque of the brakes on this wheel (in Nm).wheels.braked 2000.0;How much of the braking torque is generated by pulling the handbrake (between 0 and 1).wheels.handbraked 0.0;model used to represent the wheelwheels.model "wheel-classic-disc.mdl"wheels.width 0.3wheels.texture 4# 1wheels.pos {0.43,0,0.93}
wheels.stickyness 0wheels.inertia 1wheels.powered 0.0wheels.friction 3wheels.maxAngle 0.48wheels.maxSuspension 0.1wheels.radius 0.2wheels.braked 2000.0wheels.handbraked 0.0wheels.model "wheel-classic-disc.mdl"wheels.width 0.3wheels.texture 4# 2wheels.pos {-0.43,0,-0.68}
wheels.stickyness 0.1wheels.inertia 1wheels.powered 0.5wheels.friction 3wheels.maxAngle 0.0wheels.maxSuspension 0.1wheels.radius 0.2wheels.braked 600.0wheels.handbraked 1.0wheels.model "wheel-classic-disc.mdl"wheels.width 0.3wheels.texture 4# 3wheels.pos {0.43,0,-0.68}
wheels.stickyness 0.1wheels.inertia 1wheels.powered 0.5wheels.friction 3wheels.maxAngle 0.0wheels.maxSuspension 0.1wheels.radius 0.2wheels.braked 600.0wheels.handbraked 1.0wheels.model "wheel-classic-disc.mdl"wheels.width 0.3wheels.texture 4;---lights;number of lights on the carnumLights 20

;An approximation of the car's borders, used for collision detection.;More than two boxes can be used, but if too many are used, performance ;may degrade. Each box is defined by 8 edges (top/front/right to bottom/rear/left).numCollBoxes 1# 0coll.tfr {0.537,1.3,0.5}
coll.tfl {-0.537,1.3,0.5}
coll.trr {0.537,1.3,-0.8}
coll.trl {-0.537,1.3,-0.8}
coll.bfr {0.537,0.1,1.1}
coll.bfl {-0.537,0.1,1.1}
coll.brr {0.537,0,-1.15}
coll.brl {-0.537,0,-1.15}

# 0lights.pos {-0.4,0.4,1.0}lights.dir {0,0,1}lights.rgb {1,1,1}lights.type 2lights.size 0.4lights.onFlags 0x01lights.offFlags 0x20# 1lights.pos {0.4,0.4,1.0}lights.dir {0,0,1}lights.rgb {1,1,1}lights.type 2lights.size 0.4lights.onFlags 0x01lights.offFlags 0x40# 2lights.pos {-0.4,0.4,1.0}lights.dir {0,-0.1,1}lights.rgb {1,1,1}lights.type 1lights.size 30lights.onFlags 0x01lights.offFlags 0x00# 3lights.pos {0.4,0.4,1.0}lights.dir {0,-0.1,1}lights.rgb {1,1,1}lights.type 1lights.size 30lights.onFlags 0x01lights.offFlags 0x00


