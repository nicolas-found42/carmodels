carName "­corvette_nnb_ver.png­Corvette C6 Z06.R"year 2008displacement 7.0price 75000
builtIn 1;---aerodynamics;the car's frontal air resitance.;this equals cw*S, where cw is the coefficient of friction ;and S is the frontal area of the car in square meters.frontAirResistance 0.76;air resistance of the side and top areas of the car.;these values are not that important to be very exact.sideAirResistance 2.9topAirResistance 6.74;used to simulate spoilersfrontLift -0.8rearLift -1.09;---chassis;Car's mass in kgmass 1272;Car's momentum of inertia around the x,y and z axis.;Meassured in kg*m^2;For those not into physics that much, inertia specifies the car's;initial resistance to get accelerated around it's axis. Smaller, lighter;cars have much lower values here. A formula-1 car might have an inertia;around the y-axis af about 750 kg*m^2, whereas a big station wagon may have;4000 kg*m^2.inertia {2281, 2684, 530};The car's center of gravity.;This vector (as all the others that may follow) uses the following;coordinate system: X points to the right, Y points up and Z points to the front.;Coordinates are in meters.massCenter {0.0, 0.337, 0.0};An approximation of the car's borders, used for collision detection.;More than two boxes can be used, but if too many are used, performance ;may degrade. Each box is defined by 8 edges (top/front/right to bottom/rear/left).numCollBoxes 2# 0coll.tfr {0.965, 0.77, 2.23}coll.tfl {-0.965, 0.77, 2.23}coll.trr {0.965, 0.77, -2.23}coll.trl {-0.965, 0.77, -2.23}coll.bfr {0.965, 0.18, 2.23}coll.bfl {-0.965, 0.18, 2.23}coll.brr {0.965, 0.18, -2.23}coll.brl {-0.965, 0.18, -2.23}# 1coll.tfr {0.85,1.31,0}coll.tfl {-0.85,1.31,0}coll.trr {0.85,1.31,-0.675}coll.trl {-0.85,1.31,-0.675}coll.bfr {0.955,0.853,-0.3}coll.bfl {-0.955,0.853,-0.3}coll.brr {0.955,0.853,-2.27}coll.brl {-0.955,0.853,-2.27};---graphics;Model used to represent the car.model "corvette_z06r_nnb.mdl"shadowModel "corvette_z06r_nnb_shd.mdl";Model used to represent the car's interior.interiorModel "corvette_z06r_nnb_inside.mdl";Position of driver modeldriverPos {0.38,0.50,-0.53};Position of the steering wheelsteeringWheelPos {0.368,0.74,0.10};Angle of the steering wheelsteeringWheelAngle 24;Number of turns, lock-to-lock.steeringWheelTurns 3.5steeringWheelRadius 0.17;Model used to represent the steering wheelsteeringWheelTexture "Racing_steering_wheel.pct";Position of left and right exhaust ends. For a car with only;one exhaust pipe, use the same coordinates for both.exhaust1Pos {-0.16,0.34,-2.1}exhaust2Pos {0.16,0.34,-2.1}
exhaustFire 300000;Position of license plates;for network player namesfrontLicensePlatePos {0,0.54,2.0}rearLicensePlatePos {0,0.69,-2.266}hornSample "horn2.wav"numColors 4# 0colors {0.1,0.75,0.1}
# 1colors {0.75,0.1,0.1}
# 2colors {0.75,0.75,0.1}
# 3colors {0.7,0.7,0.7}

;--engine
;Car's maximal power in Watts.;One hp equals 745.69987 Watts.power 380306.93;Car's maximal torque in Nm.;One lb-ft equals 1.35628105 Nm.torque 652;RPM values for the power and torque ratings.powerRPM 6000torqueRPM 4900;RPM for engine stall, currently unusedjerkRPM 500.0;Engines idle RPMidleRPM 1100;RPM delimtermaxRPM 7200;Engines Inertia in kg*m^2.;The higher this value is, the longer the engine takes to spin up.engineInertia 0.25engineBaseFriction 43engineRPMFriction 0.044;engine sound sampleengineSample "corvette_C6R_nnb.wav"hallSample "corvette_C6R_nnb_hall.wav"zeroRPMSoundGain 0.8fullRPMSoundGain 1.15zeroThrottleSoundGain 0.5fullThrottleSoundGain 1.1zeroRPMSoundPitch 0.1fullRPMSoundPitch 1.03zeroThrottleSoundPitch 1.1fullThrottleSoundPitch 1.0;---suspension;suspensionType 6;These determines the strength of the car's shock absorbers.supsensionFriction 1100damperStrength 41000frontSwayBar 14000rearSwayBar 23500;---drivetrain;The ratio of the final drive gear in the car's differential.finalDriveRatio 3.42;The maximum amount of torque the car's clutch can transfer (in Nm).maxClutchTorqueTransfer 1200;this factor is used to simulate limited slip differentials.;0 means free differential. the higher the value, the more differential locking.;values around 100 seem to get realistic limited slip differentials.;differentialLockCoefficient 115
differentialLockCoefficient 110
;For automatic transmission: When to shift up and downshiftUpRPM 6450.0shiftDownRPM 3500.0;Time it takes to shift gears in secondsgearSwitchTime 0.1;Number of gears, including reverse and neutral.numGears 8;The gear ratios# 0gearRatios -3.28# 1gearRatios 0# 2gearRatios 2.571# 3gearRatios 1.861# 4gearRatios 1.473# 5gearRatios 1.185# 6gearRatios 1.00# 7gearRatios 0.848;---wheelsnumWheels 4# 0;325/650-18'
wheels.pos {-0.78,0.395,1.343}wheels.inertia 2.43wheels.powered 0.0wheels.friction 10wheels.maxAngle 0.56wheels.maxSuspension 0.06wheels.radius 0.325wheels.braked 9500wheels.handbraked 0.0wheels.model "corvette_c6r_nnb_wheel2.mdl"
wheels.customBrakeModel "corvette_z06_nnb_cala.mdl"wheels.width 0.325wheels.stickyness 0.31wheels.loadSensitivity -0.08# 1;325/650-18'wheels.pos {0.78,0.395,1.343}wheels.inertia 2.43wheels.powered 0.0wheels.friction 10wheels.maxAngle 0.56wheels.maxSuspension 0.06wheels.radius 0.325wheels.braked 9500wheels.handbraked 0.0wheels.model "corvette_c6r_nnb_wheel2.mdl"
