carName "­corvette_nnb_ver.png­Corvette C6.R"
year 2007
displacement 7.0
price 1000000
builtIn 1

;---aerodynamics

;the car's frontal air resitance.
;this equals cw*S, where cw is the coefficient of friction 
;and S is the frontal area of the car in square meters.

;Cd is ~0.45 with the wings - frontal area is ~2.08m

;frontAirResistance 0.9
frontAirResistance 0.88

;air resistance of the side and top areas of the car.
;these values are not that important to be very exact.
;sideAirResistance 3.3
;topAirResistance 8.0
sideAirResistance 3.2
topAirResistance 7.8

;used to simulate spoilers
;aerobalance is 43/57 front/rear
;frontLift -0.946
;rearLift -1.253
frontLift -0.925
rearLift -1.225

;---chassis

;Car's mass in kg
mass 1100

;Car's momentum of inertia around the x,y and z axis.
;Meassured in kg*m^2
;For those not into physics that much, inertia specifies the car's
;initial resistance to get accelerated around it's axis. Smaller, lighter
;cars have much lower values here. A formula-1 car might have an inertia
;around the y-axis af about 750 kg*m^2, whereas a big station wagon may have
;4000 kg*m^2.
inertia {1947, 2313, 490}



;The car's center of gravity.
;This vector (as all the others that may follow) uses the following
;coordinate system: X points to the right, Y points up and Z points to the front.
;Coordinates are in meters.
massCenter {0.0, 0.335, 0.0}



;An approximation of the car's borders, used for collision detection.
;More than two boxes can be used, but if too many are used, performance 
;may degrade. Each box is defined by 8 edges (top/front/right to bottom/rear/left).
numCollBoxes 2
# 0
coll.tfr {0.999, 0.77, 2.23}
coll.tfl {-0.999, 0.77, 2.23}
coll.trr {0.999, 0.77, -2.23}
coll.trl {-0.999, 0.77, -2.23}
coll.bfr {0.999, 0.18, 2.23}
coll.bfl {-0.999, 0.18, 2.23}
coll.brr {0.999, 0.18, -2.23}
coll.brl {-0.999, 0.18, -2.23}
# 1
coll.tfr {0.85,1.31,0}
coll.tfl {-0.85,1.31,0}
coll.trr {0.85,1.31,-0.675}
coll.trl {-0.85,1.31,-0.675}
coll.bfr {0.955,0.853,-0.3}
coll.bfl {-0.955,0.853,-0.3}
coll.brr {0.955,0.853,-2.27}
coll.brl {-0.955,0.853,-2.27}


;---graphics

;Model used to represent the car.
model "corvette_c6r_nnb4.mdl"

shadowModel "corvette_c6r_nnb_shd3.mdl"

;Model used to represent the car's interior.
interiorModel "corvette_c6r_inside_nnb2.mdl"

;Position of driver model
driverPos {0.35,0.50,-0.53}

;Position of the steering wheel
steeringWheelPos {0.368,0.74,0.10}

;Angle of the steering wheel
steeringWheelAngle 24

;Number of turns, lock-to-lock.
steeringWheelTurns 1.0

steeringWheelRadius 0.16

;Model used to represent the steering wheel
steeringWheelTexture "Racing_steering_wheel.pct"

;Position of left and right exhaust ends. For a car with only
;one exhaust pipe, use the same coordinates for both.
exhaust1Pos {-0.95,0.2,0}
exhaust2Pos {0.95,0.2,0}
exhaustFire 300000

;Position of license plates
;for network player names
frontLicensePlatePos {0,0.54,2.0}
rearLicensePlatePos {0,1.18,-2.204}

hornSample "horn2.wav"

numColors 10
# 0
colors {0.75,0.70,0.1}
# 1
colors {0.2,0.2,0.2}
# 2
colors {1.0,1.0,1.0}
# 3
colors {0.8,0.8,0.3}
# 4
colors {0.1,0.1,0.75}
# 5
colors {0.45,0.0,0.0}
# 6
colors {0.91,0.35,0.58}
# 7
colors {0.8,0.8,0.8}
# 8
colors {0.0,0.0,0.0}
# 9
colors {0.55,0.50,0.1}
;--engine

;Car's maximal power in Watts.
;One hp equals 745.69987 Watts.
power 439962

;Car's maximal torque in Nm.
;One lb-ft equals 1.35628105 Nm.
torque 868

;RPM values for the power and torque ratings.
powerRPM 5400
torqueRPM 4400

;RPM for engine stall, currently unused
jerkRPM 500.0

;Engines idle RPM
idleRPM 500

;RPM delimter
maxRPM 7000

;Engines Inertia in kg*m^2.
;The higher this value is, the longer the engine takes to spin up.
engineInertia 0.25

; 25 & 0.02 are default
engineBaseFriction 43
engineRPMFriction 0.04


;engine sound sample
engineSample "corvette_C6R_nnb.wav"
hallSample "corvette_C6R_nnb_hall2.wav"
zeroRPMSoundGain 0.8
fullRPMSoundGain 1.25
zeroThrottleSoundGain 0.5
fullThrottleSoundGain 1.2
zeroRPMSoundPitch 0.1
fullRPMSoundPitch 1.0
zeroThrottleSoundPitch 1.1
fullThrottleSoundPitch 1.0



;---suspension

;suspensionType 6

;These determines the strength of the car's shock absorbers.
supsensionFriction 1100
damperStrength 41000
frontSwayBar 16998
rearSwayBar 25000


;---drivetrain

;The ratio of the final drive gear in the car's differential.
finalDriveRatio 3.42

;The maximum amount of torque the car's clutch can transfer (in Nm).
maxClutchTorqueTransfer 1200

;this factor is used to simulate limited slip differentials.
;0 means free differential. the higher the value, the more differential locking.
;values around 100 seem to get realistic limited slip differentials.
differentialLockCoefficient 120

;For automatic transmission: When to shift up and down
shiftUpRPM 6000
shiftDownRPM 3500
shiftUpRPMFix 6000

;Time it takes to shift gears in seconds
gearSwitchTime 0.1

;Number of gears, including reverse and neutral.
numGears 8

;The gear ratios
# 0
gearRatios -3.27
# 1
gearRatios 0
# 2
gearRatios 3.05
# 3
gearRatios 2.07
# 4
gearRatios 1.48
# 5
gearRatios 1.10
# 6
gearRatios 0.90
# 7
gearRatios 0.77


;---wheels
numWheels 4

# 0
