;a string with the name of the carbuiltIn 0;carName "";carName "2006 H2"carName "Hummer H2 v0.5";used only for career modeyear 2006displacement 4.79;---aerodynamics;the car's frontal air resitance.;this equals cw*S, where cw is the coefficient of friction ;and S is the frontal area of the car in square meters.frontAirResistance 2.0;air resistance of the side and top areas of the car.;these values are not that important to be very exact.sideAirResistance 2.0topAirResistance 3.0;used to simulate spoilersfrontLift -0.0rearLift -0.0;---chassis;Car's mass in kgmass 2300.0;Car's momentum of inertia around the x,y and z axis.;Meassured in kg*m^2;For those not into physics that much, inertia specifies the car's;initial resistance to get accelerated around it's axis. Smaller, lighter;cars have much lower values here. A formula-1 car might have an inertia;around the y-axis af about 750 kg*m^2, whereas a big station wagon may have;4000 kg*m^2.inertia {5500,5000,650};The car's center of gravity.;This vector (as all the others that may follow) uses the following;coordinate system: X points to the right, Y points up and Z points to the front.;Coordinates are in meters.massCenter {0.0,0.6,0.25};An approximation of the car's borders, used for collision detection.;More than two boxes can be used, but if too many are used, performance ;may degrade. Each box is defined by 8 edges (top/front/right to bottom/rear/left).numCollBoxes 2# 0coll.tfr {0.955,0.853,2.32}coll.tfl {-0.955,0.853,2.32}coll.trr {0.955,0.853,-2.32}coll.trl {-0.955,0.853,-2.32}coll.bfr {0.955,0.275,2.32}coll.bfl {-0.955,0.275,2.32}coll.brr {0.955,0.275,-2.32}coll.brl {-0.955,0.275,-2.32}# 1coll.tfr {0.85,1.31,0.385}coll.tfl {-0.85,1.31,0.385}coll.trr {0.85,1.31,-0.675}coll.trl {-0.85,1.31,-0.675}coll.bfr {0.955,0.853,0.828}coll.bfl {-0.955,0.853,0.828}coll.brr {0.955,0.853,-2.27}coll.brl {-0.955,0.853,-2.27};---graphics;Model used to represent the car.model "H2.mdl";Model used to represent the car's interior.interiorModel "null.mdl";Position of driver modeldriverPos {0.4,0.95,-0.05};Position of the steering wheelsteeringWheelPos {0.4,1,0.65};Angle of the steering wheelsteeringWheelAngle 35;Number of turns, lock-to-lock.steeringWheelTurns 5.2steeringWheelRadius 0.325;Model used to represent the steering wheelsteeringWheelTexture "Touring_steering_wheel01.pct";Position of left and right exhaust ends. For a car with only;one exhaust pipe, use the same coordinates for both.exhaust1Pos {0.5,0.4,-2.6}exhaust2Pos {0.5,0.4,-2.6};Position of license plates;for network player namesfrontLicensePlatePos {0,0.6,2.52}rearLicensePlatePos {0,0.9,-2.23}numColors 1# 0colors {0.9,0.8,0.0}hornSample "horn2.wav";--engine;Car's maximal power in Watts.;One hp equals 745.69987 Watts.power 240000;Car's maximal torque in Nm.;One lb-ft equals 1.35628105 Nm.torque 365;RPM values for the power and torque ratings.powerRPM 4000.0torqueRPM 2000.0;RPM for engine stall, currently unusedjerkRPM 450.0;Engines idle RPMidleRPM 800.0;RPM delimtermaxRPM 5500.0;Engines Inertia in kg*m^2.;The higher this value is, the longer the engine takes to spin up.engineInertia 0.5;currently unusedengineFriction 200;engine sound sampleengineSample "enginenormal.wav"hallSample "hallnormal.wav"zeroRPMSoundGain 0.8fullRPMSoundGain 1.0zeroThrottleSoundGain 0.5fullThrottleSoundGain 1.2zeroRPMSoundPitch 0.4fullRPMSoundPitch 0.9zeroThrottleSoundPitch 0.9fullThrottleSoundPitch 1.0;---suspension;These determines the strength of the car's shock absorbers.supsensionFriction 300damperStrength 240000frontSwayBar 1500000rearSwayBar 1500000;---drivetrain;The ratio of the final drive gear in the car's differential.finalDriveRatio 3.89;The maximum amount of torque the car's clutch can transfer (in Nm).maxClutchTorqueTransfer 900;this factor is used to simulate limited slip differentials.;0 means free differential. the higher the value, the more differential locking.;values around 100 seem to get realistic limited slip differentials.differentialLockCoefficient 0;For automatic transmission: When to shift up and downshiftUpRPM 5200.0shiftDownRPM 2500.0;Time it takes to shift gears in secondsgearSwitchTime 0.5exhaustFire 0;Number of gears, including reverse and neutral.numGears 6;The gear ratios# 0gearRatios -2.66# 1gearRatios 0# 2gearRatios 2.66# 3gearRatios 1.6# 4gearRatios 1.0
# 5gearRatios 0.8;---wheels;number of wheels (theoretically you could make vehicles with numWheels!=4. This has not been tested and might cause troubles, though).numWheels 4# 0;Wheel's positionwheels.pos {-0.81,0.375,1.61};Wheel's inertia in kg*m^2.wheels.inertia 2.2;Fraction of engine power lead to this wheel.wheels.powered 0.0;Friction caused by rotating the wheel in Nm.wheels.friction 10;Maximal steering angle of this wheel in radians.wheels.maxAngle 0.48;Suspension travel of this wheel in meters.wheels.maxSuspension 0.2;Wheel's radius in meters.wheels.radius 0.38;Torque of the brakes on this wheel (in Nm).wheels.braked 2000.0;How much of the braking torque is generated by pulling the handbrake (between 0 and 1).wheels.handbraked 0.0;model used to represent the wheelwheels.model "H2_wheel.mdl"wheels.width 0.505wheels.texture 4# 1wheels.pos {0.81,0.375,1.61}wheels.inertia 2.2wheels.powered 0.0wheels.friction 10wheels.maxAngle 0.48wheels.maxSuspension 0.2wheels.radius 0.38wheels.braked 2000.0wheels.handbraked 0.0wheels.model "H2_wheel.mdl"wheels.width 0.505wheels.texture 4# 2wheels.pos {-0.8,0.375,-1.46}wheels.inertia 2.2wheels.powered 0.5wheels.friction 10wheels.maxAngle 0.0wheels.maxSuspension 0.2wheels.radius 0.38wheels.braked 700.0wheels.handbraked 1.0wheels.model "H2_wheel.mdl"wheels.width 0.505wheels.texture 4# 3wheels.pos {0.8,0.375,-1.46}wheels.inertia 2.2wheels.powered 0.5wheels.friction 10wheels.maxAngle 0.0wheels.maxSuspension 0.2wheels.radius 0.38wheels.braked 700.0wheels.handbraked 1.0wheels.model "H2_wheel.mdl"wheels.width 0.505wheels.texture 4