; Car made by; 3d model by DonaemouS; car.ini by DonaemouS; bonnet star and tweaks by TomtebuiltIn 1carName "­g4m_e63_14.png­ Mercedes E63 AMG";used only for career modeyear 2006displacement 6.208;---aerodynamics;the car's frontal air resitance.;this equals cw*S, where cw is the coefficient of friction;and S is the frontal area of the car in square meters.;Drag coefficient 	0.30;Frontal Area 	2.22 m2;Cx 	0.77frontAirResistance 0.770;air resistance of the side and top areas of the car.;these values are not that important to be very exact.sideAirResistance 18topAirResistance 30;used to simulate spoilersfrontLift 0.029rearLift 0.015;---chassis;Car's mass in kg 1835 (including 75Kg driver)mass 1840.0;Car's momentum of inertia around the x,y and z axis.;Meassured in kg*m^2;For those not into physics that much, inertia specifies the car's;initial resistance to get accelerated around it's axis. Smaller, lighter;cars have much lower values here. A formula-1 car might have an inertia;around the y-axis af about 750 kg*m^2, whereas a big station wagon may have;4000 kg*m^2.;without ground clearanceinertia {4393, 4267, 1144};The car's center of gravity.;This vector (as all the others that may follow) uses the following;coordinate system: X points to the right, Y points up and Z points to the front.;Coordinates are in meters.;Weight distribution front/rear (%) 53/47massCenter {0.0, 0.575, 0.238};An approximation of the car's borders, used for collision detection.;More than two boxes can be used, but if too many are used, performance;may degrade. Each box is defined by 8 edges (top/front/right to bottom/rear/left).numCollBoxes 3# 0coll.tfr {0.901, 0.787, 2.440}coll.tfl {-0.901, 0.787, 2.440}coll.trr {0.901, 0.986, 0.995}coll.trl {-0.901, 0.986, 0.995}coll.bfr {0.901, 0.227, 2.440}coll.bfl {-0.901, 0.227, 2.440}coll.brr {0.901, 0.195, 0.995}coll.brl {-0.901, 0.195, 0.995}# 1coll.tfr {0.901, 0.986, 0.995}coll.tfl {-0.901, 0.986, 0.995}coll.trr {0.901, 1.055, -2.393}coll.trl {-0.901, 1.055, -2.393}coll.bfr {0.901, 0.195, 0.995}coll.bfl {-0.901, 0.195, 0.995}coll.brr {0.901, 0.222, -2.393}coll.brl {-0.901, 0.222, -2.393}# 2coll.tfr {0.901, 1.459, 0.135}coll.tfl {-0.901, 1.459, 0.135}coll.trr {0.901, 1.459, -0.899}coll.trl {-0.901, 1.459, -0.899}coll.bfr {0.901, 0.986, 0.995}coll.bfl {-0.901, 0.986, 0.995}coll.brr {0.901, 1.079, -1.845}coll.brl {-0.901, 1.079, -1.845};---graphics;Model used to represent the car.model "mercedes_e63amg.mdl"shadowModel "mercedes_e63amg_shad.mdl";Model used to represent the car's interior.interiorModel "mercedes_e63amg_int.mdl";Position of driver modeldriverPos {0.350, 0.680, 0.0};Position of the steering wheelsteeringWheelPos {0.35, 0.910, 0.480};Angle of the steering wheelsteeringWheelAngle 24;Number of turns, lock-to-lock.steeringWheelTurns 2.6steeringWheelRadius 0.1905;Model used to represent the steering wheelsteeringWheelTexture "g4m_e634_steeringwheel.png";Position of left and right exhaust ends. For a car with only;one exhaust pipe, use the same coordinates for both.exhaust1Pos {0.495, 0.365, -2.322}exhaust2Pos {-0.495, 0.365, -2.322};Position of license plates;for network player namesfrontLicensePlatePos {0, 0.535, 2.460}rearLicensePlatePos {0, 0.896, -2.315}numColors 11# 0colors {0.360, 0.129, 0.137}# 1colors {0.054, 0.176, 0.196}# 2colors {0.474, 0.474, 0.474}# 3colors {0.200, 0.207, 0.254}# 4colors {0.686, 0.631, 0.588}# 5colors {0.725, 0.725, 0.768}# 6colors {0.203, 0.203, 0.203}# 7colors {0.058, 0.176, 0.129}# 8colors {0.078, 0.090, 0.227}# 9colors {0.101, 0.145, 0.223}# 10colors {0.054, 0.054, 0.054};--enginepower 378100torque 630.00powerRPM 6800.0torqueRPM 5200.0clutchRPMFix 2000maxRPM 7500.0idleRPM 950.0jerkRPM 500.0; from Tomte knowledge base Engine Inertia 0.18 for the 2l enginesengineInertia 0.30engineBaseFriction 20engineRPMFriction 0.02;engine sound sampleengineSample "mercedes_e63amg_engine.wav"hallSample "mercedes_e63amg_engine.wav"zeroRPMSoundGain 0.2fullRPMSoundGain 1.4zeroThrottleSoundGain 0.9fullThrottleSoundGain 1.7zeroRPMSoundPitch 0.4fullRPMSoundPitch 1.25zeroThrottleSoundPitch 1.51fullThrottleSoundPitch 1.5;zeroRPMSoundPitch 0.3;fullRPMSoundPitch 0.8;zeroThrottleSoundPitch 0.6;fullThrottleSoundPitch 1.0;---suspension;These determines the strength of the car's shock absorbers.supsensionFriction 1000damperStrength 25000frontSwayBar 28000rearSwayBar 30000;---drivetrain;The ratio of the final drive gear in the car's differential.finalDriveRatio 2.650;The maximum amount of torque the car's clutch can transfer (in Nm).maxClutchTorqueTransfer 630;this factor is used to simulate limited slip differentials.;0 means free differential. the higher the value, the more differential locking.;values around 100 seem to get realistic limited slip differentials.differentialLockCoefficient 125;For automatic transmission: When to shift up and downshiftUpRPM 7200.0shiftUpRPMFix 7200.0shiftDownRPM 4000.0;Time it takes to shift gears in secondsgearSwitchTime 0.4;Number of gears, including reverse and neutral.numGears 9;The gear ratios# 0gearRatios -3.800# 1gearRatios 0# 2gearRatios 4.380# 3gearRatios 2.860# 4gearRatios 1.920# 5gearRatios 1.370# 6gearRatios 1.000# 7gearRatios 0.820# 8gearRatios 0.730;---wheels;number of wheels (theoretically you could make vehicles with numWheels!=4. This has not been tested and might cause troubles, though).numWheels 4# 0wheels.pos {-0.790, 0.389, 1.58}wheels.inertia 2.560wheels.powered 0.0wheels.friction 31wheels.maxAngle 0.40wheels.maxSuspension 0.125wheels.radius 0.326wheels.braked 7400.0wheels.handbraked 0.0wheels.model "mercedes_e63amg_wheel.mdl"wheels.width 0.245wheels.texture 6wheels.grip 0.0wheels.stickyness 0.025wheels.loadSensitivity 0.0# 1wheels.pos {0.790, 0.389,