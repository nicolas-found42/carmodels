;This file includes comments for all the paramerters.;If you still don't understand a parameter, just leave it unchangend.;a string with the name of the carcarName "Blown Vette";used only for career modeyear 1968displacement 6.999price 45000;---aerodynamics;the car's frontal air resitance.;this equals cw*S, where cw is the coefficient of friction ;and S is the frontal area of the car in square meters.frontAirResistance 0.7;air resistance of the side and top areas of the car.;these values are not that important to be very exact.sideAirResistance 2.0topAirResistance 3.0
;used to simulate spoilersfrontLift 0.00rearLift -0.05;---chassis;Car's mass in kgmass 1413
;Car's momentum of inertia around the x,y and z axis.;Meassured in kg*m^2;For those not into physics that much, inertia specifies the car's;initial resistance to get accelerated around it's axis. Smaller, lighter;cars have much lower values here. A formula-1 car might have an inertia;around the y-axis af about 750 kg*m^2, whereas a big station wagon may have;4000 kg*m^2.
inertia {3900,2900,370}
;The car's center of gravity.;This vector (as all the others that may follow) uses the following;coordinate system: X points to the right, Y points up and Z points to the front.;Coordinates are in meters.massCenter {0.0,0.4,0.27};An approximation of the car's borders, used for collision detection.;More than two boxes can be used, but if too many are used, performance ;may degrade. Each box is defined by 8 edges (top/front/right to bottom/rear/left).numCollBoxes 2# 0coll.tfr {0.955,0.853,2.53}coll.tfl {-0.955,0.853,2.53}coll.trr {0.955,0.853,-2.4}coll.trl {-0.955,0.853,-2.4}coll.bfr {0.955,0.275,2.53}coll.bfl {-0.955,0.275,2.53}coll.brr {0.955,0.275,-2.4}coll.brl {-0.955,0.275,-2.4}# 1coll.tfr {0.85,1.31,0}coll.tfl {-0.85,1.31,0}coll.trr {0.85,1.31,-0.675}coll.trl {-0.85,1.31,-0.675}coll.bfr {0.955,0.853,-0.3}coll.bfl {-0.955,0.853,-0.3}coll.brr {0.955,0.853,-2.27}coll.brl {-0.955,0.853,-2.27};---graphics;Model used to represent the car.model "modvette.mdl";Model used to represent the car's interior.interiorModel "modvette_interior.mdl";Position of driver modeldriverPos {0.4,0.54,-0.6};Position of the steering wheelsteeringWheelPos {0.4,0.7,0};Angle of the steering wheelsteeringWheelAngle 15;Number of turns, lock-to-lock.steeringWheelTurns 3.5steeringWheelRadius 0.225;Model used to represent the steering wheelsteeringWheelTexture "Racing_steering_wheel.pct";Position of left and right exhaust ends. For a car with only;one exhaust pipe, use the same coordinates for both.exhaust1Pos {-0.96,0.23,-0.82}exhaust2Pos {0.96,0.23,-0.82};Position of license plates;for network player namesfrontLicensePlatePos {0,0.45,2.54}rearLicensePlatePos {0,0.53,-2.4}hornSample "horn2.wav"numColors 4# 0colors {0.1,0.1,0.75}# 1colors {.6,0,0.08}# 2colors {1,0.9,0}# 3
colors {0.1,0.1,0.1};--engine;Car's maximal power in Watts.;One hp equals 745.69987 Watts.
;609hp
power 454480
;Car's maximal torque in Nm.;One lb-ft equals 1.35628105 Nm.
torque 817;RPM values for the power and torque ratings.;powerRPM 6000.0;torqueRPM 3800.0
powerRPM 6100.0torqueRPM 3500.0
;RPM for engine stall, currently unusedjerkRPM 450.0;Engines idle RPMidleRPM 800.0;RPM delimtermaxRPM 6600.0;Engines Inertia in kg*m^2.;The higher this value is, the longer the engine takes to spin up.engineInertia 0.27;currently unusedengineFriction 100;engine sound sampleengineSample "enginenormal2.wav"
hallSample "hallnormal2.wav"
turboSample "turbo.wav"
zeroRPMSoundGain 0.8fullRPMSoundGain 1.55zeroThrottleSoundGain 0.5fullThrottleSoundGain 1.15zeroRPMSoundPitch 0.3
fullRPMSoundPitch 1.0zeroThrottleSoundPitch 0.9fullThrottleSoundPitch 1.0turboGain 0.9


;---suspensionsuspensionType 6;These determines the strength of the car's shock absorbers.
supsensionFriction 800damperStrength 30000frontSwayBar 10000rearSwayBar 11000;---drivetrain;The ratio of the final drive gear in the car's differential.finalDriveRatio 3.08;The maximum amount of torque the car's clutch can transfer (in Nm).maxClutchTorqueTransfer 900;this factor is used to simulate limited slip differentials.;0 means free differential. the higher the value, the more differential locking.;values around 100 seem to get realistic limited slip differentials.differentialLockCoefficient 90;For automatic transmission: When to shift up and downshiftUpRPM 6050.0shiftDownRPM 2500.0;Time it takes to shift gears in secondsgearSwitchTime 0.2;Number of gears, including reverse and neutral.numGears 6;The gear ratios# 0gearRatios -2.66# 1gearRatios 0# 2gearRatios 2.66# 3gearRatios 1.8# 4gearRatios 1.28# 5gearRatios 0.98
;---wheelsnumWheels 4# 0wheels.pos {-0.81,0.39,1.48}wheels.inertia 2.2wheels.powered 0.0wheels.friction 10wheels.maxAngle 0.48wheels.maxSuspension 0.13wheels.radius 0.34wheels.braked 6000.0wheels.handbraked 0.0wheels.model "wheel-classic-disc.mdl"wheels.width 0.225wheels.texture 4# 1
