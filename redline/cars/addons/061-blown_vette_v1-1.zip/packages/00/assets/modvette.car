wheels.pos {0.78,0.39,-1.26}wheels.inertia 2.2wheels.powered 0.5wheels.friction 10wheels.maxAngle 0.0wheels.maxSuspension 0.14wheels.radius 0.36wheels.braked 2700.0wheels.handbraked 1.0wheels.model "wheel-classic-disc.mdl";wheels.width 0.205
