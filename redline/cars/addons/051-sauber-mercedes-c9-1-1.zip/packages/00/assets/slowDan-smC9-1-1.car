;a string with the name of the carbuiltIn 1carName "­sD-smC9-1-1.png­ Sauber Mercedes C9";used only for career modeyear 1989displacement 5.0;---aerodynamics;the car's frontal air resitance.;this equals cw*S, where cw is the coefficient of friction ;and S is the frontal area of the car in square meters.; I'm not sure on this figure couldn't find any useful info so I guessed!frontAirResistance 1.0546;air resistance of the side and top areas of the car.;these values are not that important to be very exact.sideAirResistance 3topAirResistance 6;used to simulate spoilers;apparently this was a very efficient ground effect car;mulsanne corner has some nice figures but I can't figure how to tie;them in to these onesfrontLift -1.8563rearLift -2.3626;---chassis;Car's mass in kg;dry weight around 900kg added a driver and small load of fuelmass 1000;Car's momentum of inertia around the x,y and z axis.;Meassured in kg*m^2;For those not into physics that much, inertia specifies the car's;initial resistance to get accelerated around it's axis. Smaller, lighter;cars have much lower values here. A formula-1 car might have an inertia;around the y-axis af about 750 kg*m^2, whereas a big station wagon may have;4000 kg*m^2.inertia {2003,2253,417};The car's center of gravity.;This vector (as all the others that may follow) uses the following;coordinate system: X points to the right, Y points up and Z points to the front.;Coordinates are in meters.;positioned at centre of model, which includes wing so I reckon I'm about right heremassCenter { 0.0, 0.25, 0.0};An approximation of the car's borders, used for collision detection.;More than two boxes can be used, but if too many are used, performance ;may degrade. Each box is defined by 8 edges (top/front/right to bottom/rear/left).numCollBoxes 2# 0coll.tfr {1.0,0.65,1.7}coll.tfl {-1.0,0.65,1.7}coll.trr {1.0,0.7,-2.0}coll.trl {-1.0,0.7,-2.0}coll.bfr {0.95,0.05,2.25}coll.bfl {-0.95,0.05,2.25}coll.brr {0.95,0.05,-1.7}coll.brl {-0.95,0.05,-1.7}# 1coll.tfr {0.3,1.0,0.7}coll.tfl {-0.3,1.0,0.7}coll.trr {0.3,0.9,-0.5}coll.trl {-0.3,0.9,-0.5}coll.bfr {0.6,0.65,1.3}coll.bfl {-0.6,0.65,1.3}coll.brr {0.4,0.7,-1.3}coll.brl {-0.4,0.7,-1.3};---graphics;Model used to represent the car.model "slowDan-smC9.mdl";Model used to represent the car's interior.interiorModel "slowDan-smC9-int.mdl";Position of driver modeldriverPos {-0.17,0.25,0.2};Position of the steering wheelsteeringWheelPos {-0.17,0.52,0.65};Angle of the steering wheelsteeringWheelAngle 20;Number of turns, lock-to-lock.steeringWheelTurns 1.0steeringWheelRadius 0.18;Model used to represent the steering wheelsteeringWheelTexture "Racing_steering_wheel.pct";Position of left and right exhaust ends. For a car with only;one exhaust pipe, use the same coordinates for both.exhaust1Pos {-1.01,0.178,-0.77}exhaust2Pos {1.01,0.178,-0.77};Position of license plates;for network player namesrearLicensePlatePos {0.0,0.55,-1.72}numColors 7# 0colors {0.7,0.7,0.65}# 1colors {0.918, 0.471, 0.090}# 2colors {0.95, 1.0, 0.0}# 3colors {0.15, 0.75, 1.0}# 4colors {0.6, 0.15, 1.0}# 5colors {0.18, 1.0, 0.22}# 6colors {0.16, 0.2, 0.49};--engine;I'm not sure if I should be using the new features here, I guess not;a 5l engine isn't that small after all.power 536904torque 800powerRPM 7000.0torqueRPM 5500.0jerkRPM 500.0idleRPM 1100.0maxRPM 8000.0engineInertia 0.25engineFriction 100;engine sound sampleengineSample "slowDan-smC9-engine.wav"hallSample "slowDan-smC9-engine-hall.wav"zeroRPMSoundGain 0.6fullRPMSoundGain 1.2zeroThrottleSoundGain 0.3fullThrottleSoundGain 1.0zeroRPMSoundPitch 0.4fullRPMSoundPitch 1.9zeroThrottleSoundPitch 0.9fullThrottleSoundPitch 1.0;---suspension;These determines the strength of the car's shock absorbers.supsensionFriction 1000damperStrength 45000frontSwayBar 15000rearSwayBar 17500;---drivetrain;The ratio of the final drive gear in the car's differential.;I got the ratios from GT4 so I don't quite trust them,;it seems to think this car had 883hp, most sources I can find think it varies;between 700 and 750ish in race trim.;from GT4;finalDriveRatio 3.769;Slightly higher makes for better acceleration I think.finalDriveRatio 4.4;The maximum amount of torque the car's clutch can transfer (in Nm).maxClutchTorqueTransfer 900;this factor is used to simulate limited slip differentials.;0 means free differential. the higher the value, the more differential locking.;values around 100 seem to get realistic limited slip differentials.;apparently it had an LSD but again more details are hard to finddifferentialLockCoefficient 125;For automatic transmission: When to shift up and downshiftUpRPM 7100.0shiftDownRPM 3500.0;Time it takes to shift gears in secondsgearSwitchTime 0.10;Number of gears, including reverse and neutral.numGears 7;The gear ratios# 0gearRatios -3.75# 1gearRatios 0# 2gearRatios 3.048# 3gearRatios 1.864# 4gearRatios 1.276# 5gearRatios 0.93# 6gearRatios 0.720;---wheels;number of wheels (theoretically you could make vehicles with numWheels!=4.;This has not been tested and might cause troubles, though).numWheels 4# 0;Wheel's positionwheels.pos {-0.835, 0.2909, 1.4};Wheel's inertia in kg*m^2.;slightly lower for smaller front wheelswheels.inertia 2.0;Fraction of engine power lead to this wheel.wheels.powered 0.0;Friction caused by rotating the wheel in Nm.wheels.friction 20;Maximal steering angle of this wheel in radians.;wheels.maxAngle 0.48wheels.maxAngle 0.4;Suspension travel of this wheel in meters.wheels.maxSuspension 0.05;Wheel's radius in meters.wheels.radius 0.34097;Torque of the brakes on this wheel (in Nm).wheels.braked 6500.0;How much of the braking torque is generated by pulling the handbrake (between 0 and 1).wheels.handbraked 0.0;model used to represent the wheelwheels.model "slowDan-smC9-wheel.mdl"wheels.width 0.33wheels.texture 4wheels.grip 1.0;I've gone for quite a lot on the stickyness, we have got full racing slicks. Is it too much?wheels.stickyness .21# 1wheels.pos {0.835,0.2909,1.4}wheels.inertia 2.0wheels.powered 0.0wheels.friction 20wheels.maxAngle 0.4;wheels.maxAngle 0.48wheels.maxSuspension 0.05wheels.radius 0.34097wheels.braked 6500.0wheels.handbraked 0.0wheels.model "slowDan-smC9-wheel.mdl"wheels.width 0.33wheels.texture 4wheels.grip 1.0wheels.stickyness .21# 2wheels.pos {-0.822,0.3347,-1.3}wheels.inertia 2.2wheels.powered 0.5wheels.friction 20wheels.maxAngle 0.0wheels.maxSuspension 0.05wheels.radius 0.3847wheels.braked 2500.0wheels.handbraked 1.0wheels.model "slowDan-smC9-wheel.mdl"wheels.width 0.356wheels.texture 4wheels.grip 1.0wheels.stickyness .21# 3wheels.pos {0.822,0.3347,-1.3}wheels.inertia 2.2wheels.powered 0.5wheels.friction 20wheels.maxAngle 0.0wheels.maxSuspension 0.05wheels.radius 0.3847wheels.braked 2500.0wheels.handbraked 1.0wheels.model "slowDan-smC9-wheel.mdl"wheels.width 0.356wheels.texture 4wheels.grip 1.0wheels.stickyness .21;---lights;number of lights on the carnumLights 14;the light's position;>> lights.pos {-0.52, 0.25, 0.86};direction the light is pointing to;>> lights.dir {0.0, -0.1, 1.0};RGB color of the light;>> lights.rgb {1, 1, 1};lights.type; 0 = glowing RED dot; 1 = light cone; 2 = reflected red dot (apparently); 3 = white sphere (visible 360 degrees); 4 = white sphere (visible 360 degrees); 5 = nothing; 6 = white sphere (for headlights);lights size, - length of light cone, or diameter of dot;what is the light used for:;0x01: normal driving light. ;0x02: not used;0x04: not used ;0x08: reverse gear light.;0x10: brake light;0x20: left indicator;0x40: right indicator;0x80: horn;>> lights.onFlags 0x01;tell the light to turn OFF, when one of the above mentioned lights turns on.;>> lights.offFlags 0x00;all shamelessly borrowed from Giles, thanks!; headlight cones# 0lights.pos {0.78, 0.34, 1.84}lights.dir {0.0, -0.10, 1.0}lights.rgb {1.0, 1.0, 0.9}lights.type 1lights.size 25lights.onFlags 0x81lights.offFlags 0x00# 1lights.pos {-0.78, 0.34, 1.84}lights.dir {0.0, -0.10, 1.0}lights.rgb {1.0, 1.0, 0.9}lights.type 1lights.size 25lights.onFlags 0x81lights.offFlags 0x00; headlight flares# 2lights.pos {0.88, 0.32, 1.86}lights.dir {0, 0, 1}lights.rgb {1.0, 1.0, 0.9}lights.type 6lights.size 0.25lights.onFlags 0x01lights.offFlags 0x00# 3lights.pos {0.68, 0.32, 1.86}lights.dir {0, 0, 1}lights.rgb {1.0, 1.0, 0.9}lights.type 6lights.size 0.25lights.onFlags 0x01lights.offFlags 0x00# 4lights.pos {-0.88, 0.32, 1.86}lights.dir {0, 0, 1}lights.rgb {1.0, 1.0, 0.9}lights.type 6lights.size 0.25lights.onFlags 0x01lights.offFlags 0x00# 5lights.pos {-0.68, 0.32, 1.86}lights.dir {0, 0, 1}lights.rgb {1.0, 1.0, 0.9}lights.type 6lights.size 0.25lights.onFlags 0x01lights.offFlags 0x00; rear lights# 6lights.pos {0.0, 0.206, -1.90}lights.dir {0.0, 0.0, -1.0}lights.rgb {1.0 ,0.05 ,0.0 }lights.type 0lights.size 0.1lights.onFlags 0x01lights.offFlags 0x00; rain-reflected rear lights...# 7lights.pos {0.0, 0.206, -1.90}lights.dir {0.0, 0.0, -1.0}lights.rgb {1.0 ,0.05 ,0.0 }lights.type 2lights.size 0.16lights.onFlags 0x01lights.offFlags 0x00; brake lights# 8lights.pos {0.761, 0.522, -1.97}lights.dir {0.0, 0.0, -1.0}lights.rgb {1.0 ,0.05 ,0.0 }lights.type 0lights.size 0.3lights.onFlags 0x10lights.offFlags 0x00# 9lights.pos {-0.761, 0.522, -1.97}lights.dir {0.0, 0.0, -1.0}lights.rgb {1.0 ,0.05 ,0.0 }lights.type 0lights.size 0.3lights.onFlags 0x10lights.offFlags 0x00; brake lights reflections# 10lights.pos {0.761, 0.522, -1.98}lights.dir {0.0, 0.0, -1.0}lights.rgb {1.0 ,0.05 ,0.0 }lights.type 2lights.size 0.3lights.onFlags 0x10lights.offFlags 0x00# 11lights.pos {-0.761, 0.522, -1.98}lights.dir {0.0, 0.0, -1.0}lights.rgb {1.0 ,0.05 ,0.0 }lights.type 2lights.size 0.3lights.onFlags 0x10lights.offFlags 0x00; headlight horn flares# 12lights.pos {0.88, 0.32, 1.86}lights.dir {0, 0, 1}lights.rgb {1.0, 1.0, 0.9}lights.type 6lights.size 0.3lights.onFlags 0x80lights.offFlags 0x00# 13lights.pos {-0.88, 0.32, 1.86}lights.dir {0, 0, 1}lights.rgb {1.0, 1.0, 0.9}lights.type 6lights.size 0.3lights.onFlags 0x80lights.offFlags 0x00;-- Add-On options;almost forgot the mirrors so I stuck them on afterwards!numAddOns 1initialAddOns 0x01# 0addOns.hasGraphic 1addOns.model "slowDan-smC9-extras.mdl"