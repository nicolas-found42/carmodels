; Car made by; DonaemouS 3d model convert; slowDan .car config changes and testing; Giles W .car config changes, testing, and support; DANDY .car config changes and testing; thx mates, this car look awesone;a string with the name of the carbuiltIn 1carName "BMW M5 E39 TCS OFF";used only for career modeyear 2002displacement 4.941;---aerodynamics;the car's frontal air resitance.;this equals cw*S, where cw is the coefficient of friction ;and S is the frontal area of the car in square meters.; GILES - THIS IS WAY TOO LOW!; cw is about 0.246; S is approx 2.44 m^2;frontAirResistance 0.60;air resistance of the side and top areas of the car.;these values are not that important to be very exact.; GILES - FIXED THESE TOOsideAirResistance 2topAirResistance 3;used to simulate spoilers; GILES - THESE ARE *WAY* TOO HIGH - THIS CAR HAS NO DIFFUSER, NO WINGS AND NO SPOILERS
;DANDY - M5 has a rear diffuser producing some negative liftfrontLift 0rearLift -0.075;---chassis;Car's mass in kg; GILES - AS WET WEIGHT - THIS IS PROBABLY OKAYmass 1783.0;Car's momentum of inertia around the x,y and z axis.;Meassured in kg*m^2;For those not into physics that much, inertia specifies the car's;initial resistance to get accelerated around it's axis. Smaller, lighter;cars have much lower values here. A formula-1 car might have an inertia;around the y-axis af about 750 kg*m^2, whereas a big station wagon may have;4000 kg*m^2.inertia {2650,2950,390}; GILES - NEEDED TO RECALCULATE THESE BASED ON DIMENSIONS OF THE M5 AND ITS MASS;inertia {3000,3200,660};The car's center of gravity.;This vector (as all the others that may follow) uses the following;coordinate system: X points to the right, Y points up and Z points to the front.;Coordinates are in meters.; GILES - ADJUSTED DOWN AND TOWARDS REAR OF THE CAR
;DANDY- E39 has near 50/50 dist. V8s a little heaviermassCenter { 0.0,0.15, 0.2};An approximation of the car's borders, used for collision detection.;More than two boxes can be used, but if too many are used, performance ;may degrade. Each box is defined by 8 edges (top/front/right to bottom/rear/left).numCollBoxes 1# 0coll.tfr {0.80,0.853,2.25}coll.tfl {-0.80,0.853,2.25}coll.trr {0.80,0.853,-2.2}coll.trl {-0.80,0.853,-2.2}coll.bfr {0.80,0.175,2.25}coll.bfl {-0.80,0.175,2.25}coll.brr {0.80,0.175,-2.2}coll.brl {-0.80,0.175,-2.2};---graphics;Model used to represent the car.model "bmw_m5.mdl";Model used to represent the car's interior.interiorModel "null.mdl";Position of driver modeldriverPos {0.4,0.4,0.20};Position of the steering wheelsteeringWheelPos {0.45,0.2,0.85};Angle of the steering wheelsteeringWheelAngle 35;Number of turns, lock-to-lock.steeringWheelTurns 2.5steeringWheelRadius 0.25;Model used to represent the steering wheelsteeringWheelTexture "null.mdl";Position of left and right exhaust ends. For a car with only;one exhaust pipe, use the same coordinates for both.exhaust1Pos {-0.3,0.1,-2.2}exhaust2Pos {0.3,0.1,-2.2};Position of license plates;for network player namesfrontLicensePlatePos {0,0.27,2.28}rearLicensePlatePos {0,0.57,-2.28}numColors 6# 0colors {0.561, 0.125, 0.125}# 1colors {0.168, 0.215, 0.270}# 2colors {0.203, 0.168, 0.188}# 3colors {0.192, 0.266, 0.325}# 4colors {0.0, 0.0, 0.0}# 5colors {0.733, 0.713, 0.643};--engine;power 294400.0;torque 535.0;powerRPM 6500.0;torqueRPM 3800.0;jerkRPM 500.0;idleRPM 950.0;maxRPM 7000.0;engineInertia 0.25;engineFriction 100; GILES -; --engine - 4941cc V8; 400 bhp and     369 ft/lbs
; x 745.69987158 x 1.35581795
;========================
; 298279.95      500.297 Nm;power 298279.95torque 500.297powerRPM 6600.0torqueRPM 3800.0jerkRPM 500.0idleRPM 950.0maxRPM 7000.0engineInertia 0.2engineFriction 100;engine sound sampleengineSample "bmwengine.wav"hallSample "bmwengine_hall.wav"zeroRPMSoundGain 1.75fullRPMSoundGain 3.2zeroThrottleSoundGain 2.0fullThrottleSoundGain 3.5zeroRPMSoundPitch 0.275fullRPMSoundPitch 1.25zeroThrottleSoundPitch 1.0fullThrottleSoundPitch 1.35;---suspension;These determines the strength of the car's shock absorbers.supsensionFriction 1200damperStrength 40000frontSwayBar 11000rearSwayBar 10000;---drivetrain;The ratio of the final drive gear in the car's differential.finalDriveRatio 3.15;The maximum amount of torque the car's clutch can transfer (in Nm).maxClutchTorqueTransfer 580;this factor is used to simulate limited slip differentials.;0 means free differential. the higher the value, the more differential locking.;values around 100 seem to get realistic limited slip differentials.; GILES - THE BMW M5 LSD IS DESCRIBED AS PERMITTING 25% DIFF SO I IMAGINE A REALISTIC VALUE WOULD WORK HEREdifferentialLockCoefficient 125;For automatic transmission: When to shift up and downshiftUpRPM 6500.0shiftDownRPM 3500.0;Time it takes to shift gears in seconds; GILES - THIS IS SUPPOSED TO BE A GOOD GEARBOX!gearSwitchTime 0.10;Number of gears, including reverse and neutral.numGears 8;The gear ratios# 0gearRatios -3.75# 1gearRatios 0# 2gearRatios 4.23# 3gearRatios 2.53# 4gearRatios 1.67# 5gearRatios 1.23# 6gearRatios 1.00# 7gearRatios 0.83;---wheels;number of wheels (theoretically you could make vehicles with numWheels!=4. This has not been tested and might cause troubles, though).numWheels 4# 0;Wheel's position; DANDY - 23.6 Kg F, 25.6 R; GILES - RIDE HEIGHT IS TOO HIGH!wheels.pos {-0.73, 0.110, 1.45};Wheel's inertia in kg*m^2.wheels.inertia 3.01;Fraction of engine power lead to this wheel.wheels.powered 0.0;Friction caused by rotating the wheel in Nm.wheels.friction 10;Maximal steering angle of this wheel in radians.wheels.maxAngle 0.48;Suspension travel of this wheel in meters.wheels.maxSuspension 0.1;Wheel's radius in meters.wheels.radius 0.32;Torque of the brakes on this wheel (in Nm).wheels.braked 4000.0;How much of the braking torque is generated by pulling the handbrake (between 0 and 1).wheels.handbraked 0.0;model used to represent the wheelwheels.model "bmw_m5_wheel.mdl"wheels.width 0.255wheels.texture 6wheels.grip 1.0wheels.tilt -0.01wheels.stickyness .075# 1wheels.pos {0.73,0.110,1.45}wheels.inertia 3.01wheels.powered 0.0wheels.friction 10wheels.maxAngle 0.48wheels.maxSuspension 0.1wheels.radius 0.32wheels.braked 4000.0wheels.handbraked 0.0wheels.model "bmw_m5_wheel.mdl"wheels.width 0.255wheels.texture 6wheels.grip 1.0wheels.tilt -0.01wheels.stickyness .075# 2wheels.pos {-0.73,0.110,-1.23}wheels.inertia 3.58wheels.powered 0.5wheels.friction 10wheels.maxAngle 0.0wheels.maxSuspension 0.1wheels.radius 0.32wheels.braked 1500.0wheels.handbraked .7wheels.model "bmw_m5_wheel.mdl"wheels.width 0.28wheels.texture 6wheels.grip 1.0wheels.tilt -0.022wheels.stickyness .085# 3wheels.pos {0.73,0.110,-1.23}wheels.inertia 3.58wheels.powered 0.5wheels.friction 10wheels.maxAngle 0.0wheels.maxSuspension 0.1wheels.radius 0.32wheels.braked 1500.0wheels.handbraked 0.7wheels.model "bmw_m5_wheel.mdl"wheels.width 0.28wheels.texture 6wheels.grip 1.0
wheels.tilt -0.022wheels.stickyness .085;---lights-------------------------------------------------numLights 21;Brake Lights# 0lights.pos {0.65,0.45,-2.18}lights.dir {0,0,-1}lights.rgb {1.0,0.05,0,0}lights.type 2lights.size 0.2lights.onFlags 0x10lights.offFlags 0x00# 1lights.pos {-0.65,0.45,-2.18}lights.dir {0,0,-1}lights.rgb {1.0,0.05,0,0}lights.type 2lights.size 0.18lights.onFlags 0x10lights.offFlags 0x00;Reverse Lights# 2lights.pos {0.51,0.43,-2.18}lights.dir {0,0,-1}lights.rgb {1,1,1}lights.type 2lights.size 0.15lights.onFlags 0x08lights.offFlags 0x00# 3lights.pos {-0.51,0.43,-2.18}lights.dir {0,0,-1}lights.rgb {1,1,1}lights.type 2lights.size 0.15lights.onFlags 0x08lights.offFlags 0x00;Tail Lights# 4lights.pos {0.45,0.5,-2.2}lights.dir {0,0,-1}lights.rgb {0.3,0,0}lights.type 2lights.size 0.2lights.onFlags 0x01# 5lights.pos {-0.45,0.5,-2.2}lights.dir {0,0,-1}lights.rgb {0.3,0,0}lights.type 2lights.size 0.2lights.onFlags 0x01# 6lights.pos {0.55,0.5,-2.2}lights.dir {0,0,-1}lights.rgb {0.3,0,0}lights.type 2lights.size 0.2lights.onFlags 0x01# 7lights.pos {-0.55,0.5,-2.2}lights.dir {0,0,-1}lights.rgb {0.3,0,0}lights.type 2lights.size 0.2lights.onFlags 0x01# 8lights.pos {0.65,0.5,-2.2}lights.dir {0,0,-1}lights.rgb {0.3,0,0}lights.type 2lights.size 0.2lights.onFlags 0x01# 9lights.pos {-0.65,0.5,-2.2}lights.dir {0,0,-1}lights.rgb {0.3,0,0}lights.type 2lights.size 0.2lights.onFlags 0x01;front lights# 10lights.pos {0.7,0.0,1.93}lights.dir {0.1,-0.1,1}lights.rgb {0.49,0.49,0.78}lights.type 1 ;headlight conelights.size 30lights.onFlags 0x01lights.offFlags 0x00# 11lights.pos {-0.7,0.0,1.93}lights.dir {-0.1,-0.1,1}lights.rgb {0.49,0.49,0.78}lights.type 1 ;headlight conelights.size 30lights.onFlags 0x01lights.offFlags 0x00# 12lights.pos {0.57,0.36,2.10}lights.dir {0,0,1}lights.rgb {0.79,0.79,0.98}lights.type 2 ;headlight dotlights.size 0.25lights.onFlags 0x01