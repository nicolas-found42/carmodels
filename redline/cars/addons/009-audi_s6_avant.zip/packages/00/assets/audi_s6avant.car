; Car made by; 3d model by DonaemouS; car.ini by DonaemouS; aerodynamics, testing and tweaking by slowDan;a string with the name of the carbuiltIn 1carName "­g4m_s6av_10.png­ Audi S6 Avant";used only for career modeyear 2006displacement 5.204;---aerodynamics;the car's frontal air resitance.;this equals cw*S, where cw is the coefficient of friction ;and S is the frontal area of the car in square meters.;Drag coefficient 	0.340;Frontal Area 	2.26 m2;Cx 	0.77frontAirResistance 0.768;air resistance of the side and top areas of the car.;these values are not that important to be very exact.sideAirResistance 1.9topAirResistance 4;used to simulate spoilersfrontLift 0.110rearLift 0.085;---chassis;Car's mass in kgmass 1970.0;Car's momentum of inertia around the x,y and z axis.;Meassured in kg*m^2;For those not into physics that much, inertia specifies the car's;initial resistance to get accelerated around it's axis. Smaller, lighter;cars have much lower values here. A formula-1 car might have an inertia;around the y-axis af about 750 kg*m^2, whereas a big station wagon may have;4000 kg*m^2.inertia {4341,4565,916};The car's center of gravity.;This vector (as all the others that may follow) uses the following;coordinate system: X points to the right, Y points up and Z points to the front.;Coordinates are in meters.;Weight distribution front/rear (%) 54/46massCenter { 0.0,0.125,0.197};An approximation of the car's borders, used for collision detection.;More than two boxes can be used, but if too many are used, performance ;may degrade. Each box is defined by 8 edges (top/front/right to bottom/rear/left).numCollBoxes 1# 0coll.tfr {0.932,1.20,2.466}coll.tfl {-0.932,1.20,2.466}coll.trr {0.932,1.20,-2.466}coll.trl {-0.932,1.20,-2.466}coll.bfr {0.932,0.2,2.466}coll.bfl {-0.932,0.2,2.466}coll.brr {0.932,0.2,-2.466}coll.brl {-0.932,0.2,-2.466};---graphics;Model used to represent the car.model "audi_s6avant.mdl";Model used to represent the car's interior.interiorModel "audi_s6avant_int.mdl";Position of driver modeldriverPos {0.37,0.36,-0.1};Position of the steering wheelsteeringWheelPos {0.38,0.65,0.49};Angle of the steering wheelsteeringWheelAngle 30;Number of turns, lock-to-lock.steeringWheelTurns 2.9steeringWheelRadius 0.23;Model used to represent the steering wheelsteeringWheelTexture "g4m_s6av_steeringwheel.tga";Position of left and right exhaust ends. For a car with only;one exhaust pipe, use the same coordinates for both.exhaust1Pos {0.514,0.088,-2.362}exhaust2Pos {-0.514,0.088,-2.362};Position of license plates;for network player namesfrontLicensePlatePos {0,0.26,2.57}rearLicensePlatePos {0,0.60,-2.40}numColors 9# 0colors {0.180, 0.427, 0.549}# 1colors {0.172, 0.317, 0.388}# 2colors {0.321, 0.360, 0.407}# 3colors {0.129, 0.180, 0.254}# 4colors {0.619, 0.619, 0.619}# 5colors {0.196, 0.196, 0.196}# 6colors {0.686, 0.031, 0.101}# 7colors {0.262, 0.349, 0.298}# 8colors {0.235, 0.235, 0.235};--enginepower 320000torque 540powerRPM 6800.0torqueRPM 4000.0jerkRPM 500.0idleRPM 950.0maxRPM 7000.0engineInertia 0.5engineFriction 110;engine sound sampleengineSample "audi_s6_engine.wav"hallSample "audi_s6_engine.wav"zeroRPMSoundGain 1.0fullRPMSoundGain 2.0zeroThrottleSoundGain 1.3fullThrottleSoundGain 2.5zeroRPMSoundPitch 0.5fullRPMSoundPitch 1.0zeroThrottleSoundPitch 0.8fullThrottleSoundPitch 1.1;---suspension;These determines the strength of the car's shock absorbers.suspensionFriction 1100damperStrength 29000frontSwayBar 18000;---drivetrain;The ratio of the final drive gear in the car's differential.finalDriveRatio 3.801;The maximum amount of torque the car's clutch can transfer (in Nm).maxClutchTorqueTransfer 700;this factor is used to simulate limited slip differentials.;0 means free differential. the higher the value, the more differential locking.;values around 100 seem to get realistic limited slip differentials.differentialLockCoefficient 125;For automatic transmission: When to shift up and downshiftUpRPM 6300.0shiftDownRPM 4400.0;Time it takes to shift gears in secondsgearSwitchTime 0.3;Number of gears, including reverse and neutral.numGears 8;The gear ratios# 0gearRatios -3.403# 1gearRatios 0# 2gearRatios 4.171# 3gearRatios 2.340# 4gearRatios 1.521# 5gearRatios 1.143# 6gearRatios 0.867# 7gearRatios 0.691;---wheels;number of wheels (theoretically you could make vehicles with numWheels!=4. This has not been tested and might cause troubles, though).numWheels 4# 0wheels.pos {-0.800,0.110,1.531}wheels.inertia 2.692wheels.powered 0.2wheels.friction 10wheels.maxAngle 0.48wheels.maxSuspension 0.130wheels.radius 0.330wheels.braked 6200.0wheels.handbraked 0.0wheels.model "audi_s6avant_wheel.mdl"wheels.width 0.255wheels.texture 6wheels.grip 1.0wheels.stickyness 0.075wheels.loadSensitivity -0.07# 1wheels.pos {0.800,0.110,1.531}wheels.inertia 2.692wheels.powered 0.2wheels.friction 10wheels.maxAngle 0.48wheels.maxSuspension 0.130wheels.radius 0.330wheels.braked 6200.0wheels.handbraked 0.0wheels.model "audi_s6avant_wheel.mdl"wheels.width 0.255wheels.texture 6wheels.grip 1.0wheels.stickyness 0.075wheels.loadSensitivity -0.07# 2wheels.pos {-0.800,0.110,-1.368}wheels.inertia 2.692wheels.powered 0.3wheels.friction 10wheels.maxAngle 0.0wheels.maxSuspension 0.130wheels.radius 0.330wheels.braked 2000.0wheels.handbraked 1.0wheels.model "audi_s6avant_wheel.mdl"wheels.width 0.255wheels.texture 6wheels.grip 1.0wheels.stickyness 0.075wheels.loadSensitivity -0.07# 3wheels.pos {0.800,0.110,-1.368}wheels.inertia 2.692wheels.powered 0.3wheels.friction 10wheels.maxAngle 0.0wheels.maxSuspension 0.130wheels.radius 0.330wheels.braked 2000.0wheels.handbraked 1.0wheels.model "audi_s6avant_wheel.mdl"wheels.width 0.255wheels.texture 6wheels.grip 1.0wheels.stickyness 0.075