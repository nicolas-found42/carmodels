
builtIn 1carName "1971 mg midget"year 1971displacement 1.275price 2800demoAvailable 1;---aerodynamics
; Cd x area
;
; 0.45est x 1.2 x 1.0 x 2.2
;frontAirResistance 0.45630024sideAirResistance 1.021764713topAirResistance 4.161175438frontLift 0.1rearLift 0.1

; add to speed considerations by AI cars (x 1.0 + index)
aiSpeedIndex 0;---chassis
; wet weight (estimated from 640kg dry weight)mass 807.4400282
;
; note that if you consider the car as a block of dimensions W H L
; Ix = mass x ( H^2 + L^2) / 12
; Iy = mass x ( W^2 + L^2) / 12
; Iz = mass x ( W^2 + H^2) / 12
;
; W = 1.4 H = .660572 L = 3.272 mass = 807.4400282
;
; Ix = 340.667 Iy = 366.333+43.75, Iz = 142.333+43.75
inertia {869.6250166, 857.1404045, 281.5255881}

massCenter {0.05716537, 0.381707, -0.050202952}
;driver (me) mass 93.44002822 in driver position above 
;results in slightly off center com
;outmost left edge was used as a datum
;see http://www.wikihow.com/Calculate-Center-of-Gravity for detailsnumCollBoxes 1# 0coll.tfr {0.68, 0.832324, 1.46}coll.tfl {-0.68, 0.832324, 1.46}coll.trr {0.68, 0.832324, -1.40}coll.trl {-0.68, 0.832324, -1.40}coll.bfr {0.68, 0.154453, 1.46}coll.bfl {-0.68, 0.154453, 1.46}coll.brr {0.68, 0.154453, -1.40}coll.brl {-0.68, 0.154453, -1.40};---graphicsmodel "MGMidget.mdl"interiorModel "null.mdl"

numColors 5# 0colors {0.05, 0.31, 0.0}# 1colors {0.157, 0.275, 0.627}# 2colors {0.1, 0.1, 0.1}# 3colors {0.800, 0.067, 0.0}# 4colors {1.0, 1.0, 0.95}driverPos {.340398, 0.4439811,-0.433817}

steeringWheelPos {.310373, 0.7392161, -0.060557}steeringWheelAngle 15steeringWheelTurns 2.5steeringWheelRadius 0.19685steeringWheelTexture "Racing_steering_wheel.png" exhaust1Pos {0.0, .113041, -1.51}exhaust2Pos {0.0, .113041, -1.51}frontLicensePlatePos {0.0, -0.32, 1.49}rearLicensePlatePos {0.0, -0.06, -1.43}hornSample "horn3.wav"hornPitch 0.3



;RPM values for the power and torque ratings.;Car's maximal power in Watts.;One hp equals 745.69987 Watts.
; Mini Mk 1 Cooper S 1275cc
; 62bhp @ 5800 rpm
; = 56673power 46233.392
powerRPM 5800.0

;Car's maximal torque in Nm.;One lb-ft equals 1.35628105 Nm.
; Mini Mk 1 1275cc
; 72 ftlb @ 3000 rpm
; = 97.652239torque 97.652239torqueRPM 3000.0
;RPM for engine stall, currently unusedjerkRPM 350.0;Engines idle RPMidleRPM 1000;RPM delimtermaxRPM 6380.0;Engines Inertia in kg*m^2.;The higher this value is, the longer the engine takes to spin up.engineInertia 0.10

;engineBaseFriction,engineRPMFriction: Change engine friction.
;engineBaseFriction is a constant
;(such as resistance caused by friction of moving parts in their bearings)
;engineRPMFriction is dependant on engine speed
;(such as resistance caused by compression inside the cylinders)
;Default values are 25 and 0.02. Add either field to have both customized
;(if you just add one of the two fields, the other is set to zero).

engineBaseFriction 25.0
engineRPMFriction 0.02



engineSample "Mg Midget engine.wav"hallSample "Mg MidgetHallengine.wav"zeroRPMSoundGain 0.8fullRPMSoundGain 1.5zeroThrottleSoundGain 0.9fullThrottleSoundGain 1.5zeroRPMSoundPitch 0.5fullRPMSoundPitch 1.3zeroThrottleSoundPitch 0.5fullThrottleSoundPitch 1.3;---suspensionsupsensionFriction 20damperStrength 20000frontSwayBar 3000rearSwayBar 3000;---drivetrainfinalDriveRatio 3.9maxClutchTorqueTransfer 700shiftUpRPM 5500.0shiftDownRPM 3500.0gearSwitchTime 0.25numGears 6# 0gearRatios -4.114# 1gearRatios 0# 2gearRatios 3.2# 3gearRatios 1.916# 4gearRatios 1.357# 5gearRatios 1.0;---wheels

