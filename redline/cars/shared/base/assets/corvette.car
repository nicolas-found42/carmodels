;This file includes comments for all the paramerters.;If you still don't understand a parameter, just leave it unchangend.;a string with the name of the carbuiltIn 1;carName "1968 Chevrolet Corvette 427 L71"carName "Vette"challengeRequirements 0x4;used only for career modeyear 1968displacement 6.999price 40000;---aerodynamics;the car's frontal air resitance.;this equals cw*S, where cw is the coefficient of friction ;and S is the frontal area of the car in square meters.frontAirResistance 0.7;air resistance of the side and top areas of the car.;these values are not that important to be very exact.sideAirResistance 2.0topAirResistance 3.0;used to simulate spoilersfrontLift -0.0rearLift -0.05;---chassis;Car's mass in kgmass 1461;Car's momentum of inertia around the x,y and z axis.;Meassured in kg*m^2;For those not into physics that much, inertia specifies the car's;initial resistance to get accelerated around it's axis. Smaller, lighter;cars have much lower values here. A formula-1 car might have an inertia;around the y-axis af about 750 kg*m^2, whereas a big station wagon may have;4000 kg*m^2.inertia {4000,3000,350};The car's center of gravity.;This vector (as all the others that may follow) uses the following;coordinate system: X points to the right, Y points up and Z points to the front.;Coordinates are in meters.massCenter {0.0,0.4,0.27};An approximation of the car's borders, used for collision detection.;More than two boxes can be used, but if too many are used, performance ;may degrade. Each box is defined by 8 edges (top/front/right to bottom/rear/left).numCollBoxes 2# 0coll.tfr {0.955,0.853,2.53}coll.tfl {-0.955,0.853,2.53}coll.trr {0.955,0.853,-2.4}coll.trl {-0.955,0.853,-2.4}coll.bfr {0.955,0.275,2.53}coll.bfl {-0.955,0.275,2.53}coll.brr {0.955,0.275,-2.4}coll.brl {-0.955,0.275,-2.4}# 1coll.tfr {0.85,1.31,0}coll.tfl {-0.85,1.31,0}coll.trr {0.85,1.31,-0.675}coll.trl {-0.85,1.31,-0.675}coll.bfr {0.955,0.853,-0.3}coll.bfl {-0.955,0.853,-0.3}coll.brr {0.955,0.853,-2.27}coll.brl {-0.955,0.853,-2.27};---graphics;Model used to represent the car.model "corvette.mdl";Model used to represent the car's interior.interiorModel "corvette-interior.mdl";Position of driver modeldriverPos {0.4,0.54,-0.6};Position of the steering wheelsteeringWheelPos {0.4,0.7,0};Angle of the steering wheelsteeringWheelAngle 15;Number of turns, lock-to-lock.steeringWheelTurns 3.5steeringWheelRadius 0.225;Model used to represent the steering wheelsteeringWheelTexture "old_steering_wheel01.pct";Position of left and right exhaust ends. For a car with only;one exhaust pipe, use the same coordinates for both.exhaust1Pos {-0.6,0.4,-2.43}exhaust2Pos {0.6,0.4,-2.43};Position of license plates;for network player namesfrontLicensePlatePos {0,0.45,2.54}rearLicensePlatePos {0,0.53,-2.4}hornSample "horn2.wav"numColors 5# 0colors {0.8,0.8,0.8}# 1colors {1,0,0}# 2colors {1,1,0}# 3colors {0.1,0.1,0.1}# 4colors {0,0.35,0.63};--engine;Car's maximal power in Watts.;One hp equals 745.69987 Watts.power 324400;Car's maximal torque in Nm.;One lb-ft equals 1.35628105 Nm.torque 623;RPM values for the power and torque ratings.powerRPM 5800.0torqueRPM 4000.0;RPM for engine stall, currently unusedjerkRPM 450.0;Engines idle RPMidleRPM 800.0;RPM delimtermaxRPM 6600.0;Engines Inertia in kg*m^2.;The higher this value is, the longer the engine takes to spin up.engineInertia 0.3;currently unusedengineFriction 100;engine sound sampleengineSample "enginenormal2.wav"hallSample "hallnormal2.wav"zeroRPMSoundGain 0.8fullRPMSoundGain 1.5zeroThrottleSoundGain 0.5fullThrottleSoundGain 1.1zeroRPMSoundPitch 0.3fullRPMSoundPitch 1.1zeroThrottleSoundPitch 0.9fullThrottleSoundPitch 1.0;---suspensionsuspensionType 6;These determines the strength of the car's shock absorbers.supsensionFriction 300damperStrength 30000frontSwayBar 10000rearSwayBar 10000;---drivetrain;The ratio of the final drive gear in the car's differential.finalDriveRatio 3.08;The maximum amount of torque the car's clutch can transfer (in Nm).maxClutchTorqueTransfer 900;this factor is used to simulate limited slip differentials.;0 means free differential. the higher the value, the more differential locking.;values around 100 seem to get realistic limited slip differentials.differentialLockCoefficient 0;For automatic transmission: When to shift up and downshiftUpRPM 6000.0shiftDownRPM 2500.0;Time it takes to shift gears in secondsgearSwitchTime 0.3;Number of gears, including reverse and neutral.numGears 6;The gear ratios# 0gearRatios -2.66# 1gearRatios 0# 2gearRatios 2.66# 3gearRatios 1.91# 4gearRatios 1.39# 5gearRatios 1.0;---wheels;number of wheels (theoretically you could make vehicles with numWheels!=4. This has not been tested and might cause troubles, though).numWheels 4# 0;Wheel's positionwheels.pos {-0.81,0.375,1.48};Wheel's inertia in kg*m^2.wheels.inertia 2.2;Fraction of engine power lead to this wheel.wheels.powered 0.0;Friction caused by rotating the wheel in Nm.wheels.friction 10;Maximal steering angle of this wheel in radians.wheels.maxAngle 0.48;Suspension travel of this wheel in meters.wheels.maxSuspension 0.15;Wheel's radius in meters.wheels.radius 0.34;Torque of the brakes on this wheel (in Nm).wheels.braked 4500.0;How much of the braking torque is generated by pulling the handbrake (between 0 and 1).wheels.handbraked 0.0;model used to represent the wheelwheels.model "wheel-classic-disc.mdl"wheels.width 0.205wheels.texture 4# 1wheels.pos {0.81,0.375,1.48}wheels.inertia 2.2wheels.powered 0.0wheels.friction 10wheels.maxAngle 0.48wheels.maxSuspension 0.15wheels.radius 0.34wheels.braked 4500.0wheels.handbraked 0.0wheels.model "wheel-classic-disc.mdl"wheels.width 0.205wheels.texture 4# 2wheels.pos {-0.8,0.375,-1.26}wheels.inertia 2.2wheels.powered 0.5wheels.friction 10wheels.maxAngle 0.0wheels.maxSuspension 0.15wheels.radius 0.34wheels.braked 1500.0wheels.handbraked 1.0wheels.model "wheel-classic-disc.mdl"wheels.width 0.205wheels.texture 4# 3wheels.pos {0.8,0.375,-1.26}wheels.inertia 2.2wheels.powered 0.5wheels.friction 10wheels.maxAngle 0.0wheels.maxSuspension 0.15wheels.radius 0.34wheels.braked 1500.0wheels.handbraked 1.0wheels.model "wheel-classic-disc.mdl"wheels.width 0.205wheels.texture 4;---lights;number of lights on the carnumLights 12# 0lights.pos {-0.57,0.64,-2.4}lights.dir {0,0,-1}lights.rgb {0.8,0,0}lights.type 2lights.size 0.35lights.onFlags 0x01lights.offFlags 0x20# 1lights.pos {0.57,0.64,-2.4}lights.dir {0,0,-1}lights.rgb {0.8,0,0}lights.type 2lights.size 0.35lights.onFlags 0x01lights.offFlags 0x40# 2lights.pos {-0.4,0.5,2.25}lights.dir {0,0,1}lights.rgb {1,1,1}lights.type 0lights.size 0.5lights.onFlags 0x01lights.offFlags 0x00# 3lights.pos {0.4,0.5,2.25}lights.dir {0,0,1}lights.rgb {1,1,1}lights.type 0lights.size 0.5lights.onFlags 0x01lights.offFlags 0x00# 4lights.pos {-0.37,0.64,-2.4}lights.dir {0,0,-1}lights.rgb {1,0,0}lights.type 2lights.size 0.45lights.onFlags 0x10lights.offFlags 0x00# 5lights.pos {0.37,0.64,-2.4}lights.dir {0,0,-1}lights.rgb {1,0,0}lights.type 2lights.size 0.45lights.onFlags 0x10lights.offFlags 0x00# 6lights.pos {0.57,0.63,-2.4}lights.dir {0,0,-1}lights.rgb {0.8,0.8,0.8}lights.type 0lights.size 0.25lights.onFlags 0x08lights.offFlags 0x00# 7lights.pos {-0.57,0.63,-2.4}lights.dir {0,0,-1}lights.rgb {0.8,0.8,0.8}lights.type 0lights.size 0.25lights.onFlags 0x08lights.offFlags 0x00# 8lights.pos {0.4,0.5,2.25}lights.dir {0,-0.1,1}lights.rgb {1,1,1}lights.type 1lights.size 30lights.onFlags 0x01lights.offFlags 0x00# 9lights.pos {-0.4,0.5,2.25}lights.dir {0,-0.1,1}lights.rgb {1,1,1}lights.type 1lights.size 30lights.onFlags 0x01lights.offFlags 0