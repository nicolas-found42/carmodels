--- a/viewer/silhouette.mjs
+++ b/viewer/silhouette.mjs
@@ -0,0 +1,186 @@
+import * as THREE from './vendor/three.module.js';
+
+export function makeCar(c) {
+  const g = new THREE.Group();
+  const paint = c.paint ? c.paint.rgb : [110, 110, 110];
+  const bodyMat = new THREE.MeshStandardMaterial({
+    color: new THREE.Color().setRGB(paint[0]/255, paint[1]/255, paint[2]/255, THREE.SRGBColorSpace),
+    roughness: 0.32, metalness: 0.55,
+  });
+  const darkMat = new THREE.MeshStandardMaterial({ color: 0x14161a, roughness: 0.58, metalness: 0.18 });
+  const trimMat = new THREE.MeshStandardMaterial({ color: 0x737b84, roughness: 0.38, metalness: 0.8 });
+  const glassMat = new THREE.MeshStandardMaterial({
+    color: 0x7fa8cc, roughness: 0.12, metalness: 0.08, transparent: true, opacity: 0.72, side: THREE.DoubleSide,
+  });
+  const lampMat = new THREE.MeshStandardMaterial({ color: 0xe8d9a4, emissive: 0x241b0b, roughness: 0.3 });
+  const tailMat = new THREE.MeshStandardMaterial({ color: 0xc42d32, emissive: 0x260607, roughness: 0.3 });
+
+  const style = c.bodyStyle;
+  const speed = Math.max(0, Math.min(1, c.speed ?? 0.5));
+  const accel = Math.max(0, Math.min(1, c.accel ?? 0.5));
+  const agility = Math.max(0, Math.min(1, c.agility ?? 0.5));
+  const weight = Math.max(0, Math.min(1, c.weight ?? 0.5));
+  const L = 3.8 + 1.25 * speed;   // in-game speed rating modestly stretches wheelbase
+  const W = 1.65 + 0.45 * weight;
+  const H = 0.55 + 0.25 * (1 - speed);
+  const nose = 0.22 + 0.34 * accel;
+
+  const add = (geo, mat, x, y, z) => {
+    const m = new THREE.Mesh(geo, mat);
+    m.position.set(x, y, z);
+    m.castShadow = true;
+    m.receiveShadow = true;
+    g.add(m);
+    return m;
+  };
+  const box = (x, y, z, sx, sy, sz, mat) => add(new THREE.BoxGeometry(sx, sy, sz), mat, x, y, z);
+  const profile = (points, depth, mat, yOffset = 0) => {
+    const shape = new THREE.Shape();
+    shape.moveTo(points[0][0], points[0][1]);
+    for (const [x, y] of points.slice(1)) shape.lineTo(x, y);
+    shape.closePath();
+    const geo = new THREE.ExtrudeGeometry(shape, { depth, bevelEnabled: true, bevelThickness: 0.045, bevelSize: 0.04, bevelSegments: 2 });
+    geo.translate(0, 0, -depth / 2);
+    return add(geo, mat, 0, yOffset, 0);
+  };
+  const sideWindow = (points, width = W) => {
+    const shape = new THREE.Shape();
+    shape.moveTo(points[0][0], points[0][1]);
+    for (const [x, y] of points.slice(1)) shape.lineTo(x, y);
+    shape.closePath();
+    const geo = new THREE.ShapeGeometry(shape);
+    for (const side of [-1, 1]) {
+      const pane = new THREE.Mesh(geo, glassMat);
+      pane.position.z = side * (width / 2 + 0.012);
+      pane.castShadow = true;
+      g.add(pane);
+    }
+  };
+
+  if (style === 'pickup' || style === 'suv') {
+    // All dimensions use x=length, y=height, z=width.
+    box(0, 0.54, 0, L, 0.55, W * 0.94, bodyMat);
+    const cabL = style === 'pickup' ? L * 0.40 : L * 0.68;
+    const cabX = style === 'pickup' ? 0.18 : 0.05;
+    box(cabX, 0.88 + H * 0.34, 0, cabL, H * 0.92, W * 0.88, bodyMat);
+    if (style === 'pickup') {
+      const bedL = L * 0.36;
+      const bedX = -L * 0.30;
+      box(bedX, 0.76, 0, bedL, 0.10, W * 0.77, darkMat); // open bed floor
+      for (const side of [-1, 1]) box(bedX, 0.91, side * W * 0.40, bedL, 0.35, 0.08, bodyMat);
+      box(bedX - bedL / 2, 0.91, 0, 0.08, 0.35, W * 0.78, bodyMat);
+    }
+    box(L * 0.36, 0.74, 0, L * 0.24, 0.34, W * 0.90, bodyMat); // hood
+    const wx = cabX + cabL * 0.10;
+    sideWindow([[wx - cabL * 0.40, 0.92], [wx - cabL * 0.27, 1.22], [wx + cabL * 0.24, 1.22], [wx + cabL * 0.39, 0.92]], W * 0.88);
+  } else {
+    let pts;
+    if (style === 'racecar') {
+      pts = [[-L/2,0.18],[L/2,0.18],[L/2-0.10,0.60],[L*0.18,0.82],[L*0.10,1.18],[-L*0.16,1.20],[-L*0.28,0.84],[-L/2+0.08,0.62]];
+    } else if (style === 'concept') {
+      pts = [[-L/2,0.20],[L/2,0.20],[L/2-0.04,0.48],[L*0.28,0.60],[L*0.08,0.62+H],[-L*0.22,0.67+H*0.92],[-L/2+0.08,0.57]];
+    } else {
+      const rearTop = style === 'hatchback' ? 0.74 + H * 0.75 : 0.58;
+      const roofFront = style === 'sedan' ? L*0.22 : L*0.16;
+      const roofBack = style === 'sedan' ? -L*0.22 : -L*0.18;
+      pts = [[-L/2,0.18],[L/2,0.18],[L/2-0.08,0.62+nose*0.18],[roofFront,0.64+H],[roofBack,0.64+H*0.92],[-L/2+0.12,rearTop],[-L/2+0.08,0.58]];
+    }
+    profile(pts, W, bodyMat, 0.18);
+    // Side glass panels track the sloped greenhouse above the beltline.
+    if (style === 'racecar') {
+      sideWindow([[-L*0.20,0.95],[-L*0.12,1.27],[L*0.05,1.27],[L*0.15,0.91]]);
+    } else if (style === 'concept') {
+      sideWindow([[-L*0.20,0.83],[-L*0.13,0.88+H*0.55],[L*0.04,0.90+H*0.58],[L*0.24,0.73]]);
+    } else {
+      const topY = 0.64 + H * 0.90;
+      sideWindow([[-L*0.14,0.82],[-L*0.10,topY],[L*0.06,topY],[L*0.17,0.82]]);
+    }
+    if (style === 'racecar') {
+      box(-L*0.43, 1.50, 0, 0.42, 0.07, W*1.08, darkMat);
+      box(-L*0.43, 1.34, -W*0.39, 0.08, 0.30, 0.08, darkMat);
+      box(-L*0.43, 1.34, W*0.39, 0.08, 0.30, 0.08, darkMat);
+      box(L/2 + 0.12, 0.72, 0, 0.14, 0.04, W*1.12, trimMat); // front splitter
+    }
+  }
+
+  // Front/rear bumpers, grille and lights.
+  box(L/2 + 0.04, 0.54, 0, 0.10, 0.12, W*0.86, trimMat);
+  box(-L/2 - 0.04, 0.54, 0, 0.10, 0.12, W*0.86, trimMat);
+  box(L/2 + 0.10, 0.78, 0, 0.05, 0.20, W*0.38, darkMat);
+  for (const side of [-1, 1]) {
+    box(L/2 + 0.11, 0.84, side*W*0.32, 0.07, 0.16, 0.25, lampMat);
+    box(-L/2 - 0.08, 0.80, side*W*0.34, 0.06, 0.18, 0.22, tailMat);
+  }
+  // wheels: wheelbase runs along X, tire axles along Z.
+  const wheelR = 0.29 + 0.15 * agility + (style === 'pickup' || style === 'suv' ? 0.08 : 0);
+  const wheelW = 0.22 + 0.08 * weight;
+  const tireGeo = new THREE.CylinderGeometry(wheelR, wheelR, wheelW, 24);
+  const hubGeo = new THREE.CylinderGeometry(wheelR*0.53, wheelR*0.53, wheelW+0.02, 16);
+  const tireMat = new THREE.MeshStandardMaterial({ color: 0x121416, roughness: 0.84, metalness: 0.05 });
+  const hubMat = new THREE.MeshStandardMaterial({ color: 0xaeb5bd, roughness: 0.3, metalness: 0.86 });
+  g.userData.wheels = [];
+  for (const x of [-L*0.32, L*0.32]) {
+    for (const side of [-1,1]) {
+      const z = side * (W*0.48 + wheelW*0.18);
+      const tire = new THREE.Mesh(tireGeo, tireMat);
+      const hub = new THREE.Mesh(hubGeo, hubMat);
+      tire.rotation.x = hub.rotation.x = Math.PI / 2;
+      tire.position.set(x, wheelR, z);
+      hub.position.set(x, wheelR, z + side*0.015);
+      tire.castShadow = hub.castShadow = true;
+      g.add(tire, hub);
+      g.userData.wheels.push(tire, hub);
+    }
+  }
+  return g;
+}
+
+// Shared geometries/materials belong to the selected car and are disposed once.
+export function disposeCar(car) {
+  if (!car) return;
+  const geometries = new Set(), materials = new Set();
+  car.traverse(node => {
+    if (node.geometry) geometries.add(node.geometry);
+    if (node.material) for (const mat of [node.material].flat()) materials.add(mat);
+  });
+  geometries.forEach(geo => geo.dispose());
+  materials.forEach(mat => mat.dispose());
+}
+
+export function validateCars(cars) {
+  if (!Array.isArray(cars) || !cars.length) throw Error('The vehicle list is empty or is not an array.');
+  const codes = new Set();
+  const styles = new Set(['coupe', 'sedan', 'hatchback', 'pickup', 'suv', 'racecar', 'concept']);
+  for (const c of cars) {
+    if (!c || typeof c.code !== 'string' || !c.code || codes.has(c.code)) throw Error('A vehicle code is missing or duplicated.');
+    codes.add(c.code);
+    if (typeof c.name !== 'string' || !c.name || !styles.has(c.bodyStyle)) throw Error(`${c.code}: invalid name or illustration style.`);
+    for (const key of ['agility', 'accel', 'speed', 'weight']) {
+      if (!Number.isFinite(c[key]) || c[key] < 0 || c[key] > 1) throw Error(`${c.code}: ${key} must be a rating from 0 to 1.`);
+    }
+    for (const key of ['bhp', 'kg']) {
+      if (!Number.isFinite(c[key]) || c[key] < 0) throw Error(`${c.code}: invalid ${key}.`);
+    }
+    if (c.topSpeed != null && (!Number.isFinite(Number(c.topSpeed)) || Number(c.topSpeed) < 0)) throw Error(`${c.code}: invalid top speed.`);
+    if (c.year != null && !['string','number'].includes(typeof c.year)) throw Error(`${c.code}: invalid year.`);
+    if (c.group != null && typeof c.group !== 'string') throw Error(`${c.code}: invalid group.`);
+    if (c.sound != null && typeof c.sound !== 'string') throw Error(`${c.code}: invalid sound bank.`);
+    if (!Array.isArray(c.liveries) || c.liveries.some(l => !l || typeof l.label !== 'string' || typeof l.code !== 'string')) throw Error(`${c.code}: invalid liveries.`);
+    if (c.paint != null && (!Array.isArray(c.paint.rgb) || c.paint.rgb.length !== 3 || c.paint.rgb.some(v => !Number.isInteger(v) || v < 0 || v > 255))) throw Error(`${c.code}: invalid paint sample.`);
+  }
+  return cars;
+}
+
+// The timeout spans both response headers and JSON body consumption.
+export async function fetchCars(url, {timeoutMs = 15000, fetchImpl = fetch} = {}) {
+  const controller = new AbortController();
+  const timer = setTimeout(() => controller.abort(), timeoutMs);
+  try {
+    const response = await fetchImpl(url, {signal: controller.signal});
+    if (!response.ok) throw Error(`Vehicle data unavailable (HTTP ${response.status}).`);
+    return validateCars(await response.json());
+  } catch (error) {
+    if (controller.signal.aborted) throw Error('Vehicle data timed out. Retry when the local server responds.');
+    throw error;
+  } finally { clearTimeout(timer); }
+}

