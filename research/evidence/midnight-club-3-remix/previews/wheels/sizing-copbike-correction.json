  "replay_script": "import collections\nimport hashlib\nimport json\nfrom pathlib import Path\nimport struct\nimport sys\nimport time\nsys.path.insert(0,'tools')\nfrom mc3_wheels import read_default_config,read_default_wheels,read_vehicle_class,read_wheel_sizing\nfrom mc3_pck import read_vehicle\nstart=time.monotonic()\nroot=Path('midnight-club-3-remix/cars')\nexe=Path('.scratch/mc3-preview/SLUS_213.55').read_bytes()\nsource=Path('research/evidence/midnight-club-3-remix/previews/packets/wheel-joint-independent-corpus.json')\nevidence=json.loads(source.read_text())\nrows=[];errors=[]\nif len(sys.argv)>1:\n evidence['rows']=[row for row in evidence['rows'] if row['car'] in sys.argv[1:]]\nfor row in evidence['rows']:\n try:\n  id=row['car']; metadata=read_vehicle_class(root,id); config=read_default_config(root,id)\n  b=Path(row['source']['file']).read_bytes(); actual=read_vehicle(row['source']['file'])\n  wrapper=0xd0\n  skeleton_pointer=struct.unpack_from('<I',b,actual['model_offset']+104)[0]\n  assert struct.unpack_from('<I',b,wrapper+0xdc)[0]==skeleton_pointer\n  flag=b[wrapper+0xe4]\n  assert flag in [0,1]\n  metadata['bike']=bool(flag)\n  assert metadata['bike']==(row['type_by_joint_count']=='bike')\n  dimensions=[]\n  for slot in row['slots']:\n   axle=0 if slot['front_rear_candidate']=='front' else 1\n   dims=read_wheel_sizing(exe,config['fields'],axle=axle,bike=metadata['bike'],vehicle_class=metadata['class'],wheel_max_x=slot['aux_floats'][9] if slot.get('aux_floats') else None,wheel_rest_y=slot['global_position'][1])\n   dimensions.append({'joint':slot['index'],'joint_file_offset':slot['offset'],'aux_file_offset':slot.get('aux_offset'),'sizing':dims})\n  wheels=read_default_wheels(root,id,bike=metadata['bike'])\n  rows.append({'id':id,'class':metadata,'source':row['source'],'source_class_byte':{'file_offset':wrapper+0xe4,'value':flag,'wrapper_skeleton_ptr_file_offset':wrapper+0xdc},'config':config,'dimensions':dimensions,'selections':[{'component':c['component'],'axle':c['axle'],'archive':c['archive'],'page':c['page'],'model_file_offset':c['model']['model_file_offset'],'high_vertex_count':sum(d['vertex_count'] for m in c['model']['lods']['high'] for d in m['draws'])} for c in wheels['components']]})\n except Exception as e: errors.append({'id':row['car'],'error':str(e)})\nprint(json.dumps({'rows':len(rows),'errors':errors,'elapsed_seconds':time.monotonic()-start}))\nout={'summary':{'vehicles':len(rows),'cars':sum(not r['class']['bike'] for r in rows),'bikes':sum(r['class']['bike'] for r in rows),'classes':dict(collections.Counter(r['class']['class'] for r in rows)),'wheel_joint_sizings':sum(len(r['dimensions']) for r in rows),'errors':len(errors),'elapsed_seconds':time.monotonic()-start},'rows':rows,'errors':errors,'input_receipt':{'file':str(source),'sha256':hashlib.sha256(source.read_bytes()).hexdigest()},'replay_script':Path(__file__).read_text(),'claim_limits':['Static native composition proof requires independent review; runtime tire deformation, physics, camber and spin are not emulated.']}\nPath('research/evidence/midnight-club-3-remix/previews/wheels/sizing-corpus.json').write_text(json.dumps(out,indent=2)+'\\n')\n",
