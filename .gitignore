# carmodels .gitignore — decided by Jev battery tools/battery_gitignore.py
# (receipts: research/evidence/vehicle-completeness/jev-gitignore/).
# Split: lean 0.85. Keep tools, receipts, reference corpus, viewer GLBs,
# AppImage, screenshots. Ignore vendor blobs, savestates/dumps, working
# sets, bytecode. Fresh-clone note: savestates/dumps are re-captured live
# via PINE in the container; GLB builds need Blender (re-download);
# validation receipts keep sha256 pins of the excluded files.
#
# OS / editor cruft
.DS_Store
.AppleDouble
._*
*~

# Python bytecode (regenerable)
__pycache__/
*.pyc
*.pyo
.venv/
np-venv/
*-venv/

# Third-party vendor binaries (Blender exceeds GitHub's 100MB limit and is
# re-downloadable). dealership/vendor/ IS tracked: the three.js r182 module, core
# and OrbitControls are the viewer's runtime dependency and must ship in a
# fresh clone so the viewer runs offline with no manual steps (ticket #6).
tools/validation-runtime/blender-4.5.14-macos-arm64.dmg
tools/validation-runtime/blender-mount/

# Savestates (each ~11MB; re-captured live via PINE + savestate ops)
*.p2s
*.p2s.*.part

# Unpacked savestate members: EE/IOP/VU RAM, microcode, hw regs, audio/video,
# pad/usb state, PCSX2 CPU structures (read by probe tools at fixed paths;
# re-extracted from .p2s with a zstd-capable python)
*-eeMemory.bin
*-iopMemory.bin
*Memory.bin
loading-ee.bin
*MicroMem.bin
*Scratchpad.bin
*HwRegs.bin
*SPU2.bin
*USB.bin
*PAD.bin
*GS.bin
*.gs.zst
*Structures.dat
*Savestate-Version.id

# macOS PCSX2 app bundle accidentally captured under runtime/ (vendor binary,
# same class as the Blender vendor files: re-downloadable, not our work)
research/evidence/continuation/runtime/PCSX2.app/

# Experiment working sets (rebuilt by the probe tools from the above)
research/evidence/job-b-live/pairs/
research/evidence/job-b-live/members/

# Local scratch
.scratch/

# Locally supplied Gran Turismo disc inputs; never publish a disc image.
games/gran-turismo/game-files/
games/gran-turismo-4/game-files/

# Gran Turismo 4 native data is ~1.2 GB and re-derivable from the local disc
# (tools/extract_gt4_cars.py, then tools/import_gt4_catalog.py restores the ZIPs).
# Kept: the extraction index (every file's SHA-256), the spec database and volume
# inventory under provenance/, one fixture car for tests, and the viewer GLBs.
games/gran-turismo-4/cars/*
!games/gran-turismo-4/cars/index.json
!games/gran-turismo-4/cars/provenance/
!games/gran-turismo-4/cars/acra0001/
dealership/public/gran-turismo-4/native/

# Locally supplied Redline installers and the retained base package (>100 MB).
# Decoded native assets, extraction index and car add-on carriers remain visible.
games/redline/game-files/
games/redline/cars/shared/base/data.redplug

# Linter cache
.ruff_cache/

# Reference frames extracted from the pinned GSDumps (issue #20): commercial
# game content, regenerated by tools/recover_dump_reference_frame.py --write;
# the committed receipt carries their sha256 pins.
research/evidence/reference-frames/frames/

# Locally supplied Midnight Club 3 Remix disc input.
games/midnight-club-3-remix/game-files/
# Local Ghidra analysis database; source pins and MCP receipts are retained separately.
tools/validation-runtime/mc3-ghidra-20261010*
# Native shared decal packs exceed GitHub's 100 MB limit (decal.ppf) or its 50 MB
# warning size (decal_g.ppf); rederive from ISO. No tool reads either.
games/midnight-club-3-remix/cars/shared/assets/06472/resources/vehicle/decal.ppf
games/midnight-club-3-remix/cars/shared/assets/06474/resources/vehicle/decal_g.ppf

# Locally supplied Midnight Club: Los Angeles disc (the original .7z and its unpacked ISO);
# never publish a disc image.
games/midnight-club-los-angeles/game-files/
# MCLA native car data (~415 MB) is re-derivable from the local disc (tools/extract_mcla_cars.py).
# Kept: the extraction index (every file's SHA-256) and provenance (disc listing, decrypted
# archive tables, archive-key location without the key).
games/midnight-club-los-angeles/cars/*
!games/midnight-club-los-angeles/cars/index.json
!games/midnight-club-los-angeles/cars/provenance/

# MCLA native ZIP downloads are locally regenerated from the pinned extraction.
dealership/public/midnight-club-los-angeles/native/

# Research evidence is allowlist-only: an area is tracked when a verifier or check writes or reads
# it (proven by running tools/check.sh --games without the candidate files). One-off session output —
# teardowns, Jev batteries, review screenshots — goes to .scratch/research/<session>/. Files already
# tracked in other areas stay tracked; new files there are ignored.
research/evidence/*
!research/evidence/carselection-2026-10-05/
!research/evidence/continuation/
!research/evidence/gran-turismo-wheels/
!research/evidence/job-b-live/
!research/evidence/matrix-continuation/
!research/evidence/midnight-club-3-remix/
!research/evidence/midnight-club-los-angeles/
!research/evidence/mip-continuation/
!research/evidence/original-recovery/
!research/evidence/packet-continuation/
!research/evidence/ptg-continuation/
!research/evidence/ptg-investigation/
!research/evidence/reference-frames/
!research/evidence/vehicle-completeness/
!research/evidence/vu-dispatch/
# Within tracked areas, run logs and raw continuation dumps stay local; committed receipts pin their
# sha256. The recovered mip planes (mip-continuation/**/*.bin) and native liveries
# (matrix-continuation/originals/**/*.ptg;1) are corpus files read by verify_recovered_asset_index.
research/evidence/**/*.log
research/evidence/continuation/**/*.bin
# Emulator and browser screenshots, pinned by their receipts.
research/evidence/continuation/runtime/linux/**/*.png
research/evidence/midnight-club-los-angeles/assembly-v2/browser/examples/*.png

# Jev Browser run artifacts.
.jev-browser/
